---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { languages, type Lang } from '../../i18n';
import { tr } from '../../i18n/ui';
export function getStaticPaths() {
  return languages.flatMap((lang) => (['privacy', 'cookies', 'legal'] as const).map((legal) => ({ params: { lang, legal } })));
}
const lang = Astro.params.lang as Lang;
const slug = Astro.params.legal as 'privacy' | 'cookies' | 'legal';
const t = tr(lang);
const page = t.legal[slug];
---
<Base lang={lang} title={`${page.title} — Odalo`} description={t.meta.legal.description} noindex>
  <PageHero lang={lang} title={{ a: page.title }} crumbs={[{ label: page.title }]} />
  <section class="section lg">
    <div class="wrap lg__in">
      <p class="lg__banner" role="note">{t.legal.banner}</p>
      <ol class="lg__list">
        {page.sections.map((s) => <li><h2 class="h-tile">{s}</h2><p>{t.legal.pending}</p></li>)}
      </ol>
    </div>
  </section>
</Base>
<style>
  .lg { padding-top: 0; }
  .lg__in { display: grid; gap: var(--s6); max-width: 60rem; }
  .lg__banner { background: var(--sand); border-left: 8px solid var(--coral); padding: 16px 20px; font-weight: 600; border-radius: 4px; }
  .lg__list { display: grid; gap: var(--s5); counter-reset: s; }
  .lg__list li { padding-bottom: var(--s5); border-bottom: 1px solid var(--line); display: grid; gap: 8px; }
  .lg__list h2 { font-size: 1.5rem; }
</style>
