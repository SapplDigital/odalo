---
import Base from '../../layouts/Base.astro';
import HomeMosaic from '../../components/HomeMosaic.astro';
import { languages, type Lang } from '../../i18n';
import { tr } from '../../i18n/ui';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = tr(lang);
// The homepage is one compact overview (HomeMosaic). The earlier long stack (Hero, ServiceMosaic, WorkMosaic, Process, Plans, About, Faq, FinalCta)
// remains in src/components and on its dedicated routes.
---
<Base lang={lang} title={t.meta.home.title} description={t.meta.home.description} home>
  <HomeMosaic lang={lang} />
</Base>
