---
import Base from '../../layouts/Base.astro';
import HeroPortada from '../../components/home/HeroPortada.astro';
import SeccionServicios from '../../components/home/SeccionServicios.astro';
import SeccionPlanes from '../../components/home/SeccionPlanes.astro';
import SeccionKit from '../../components/home/SeccionKit.astro';
import SeccionProyectos from '../../components/home/SeccionProyectos.astro';
import SeccionEstudio from '../../components/home/SeccionEstudio.astro';
import SeccionContacto from '../../components/home/SeccionContacto.astro';
import { languages, type Lang } from '../../i18n';
import { tr } from '../../i18n/ui';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = tr(lang);
// Home follows Ale's portada order. All seven sections are in: hero, services, plans teaser, Kit QR, projects, studio and contact.
// The old HomeMosaic and its runtime are gone; the hero is the dot-canvas port of Ale's HeroSenal.
---
<Base lang={lang} title={t.meta.home.title} description={t.meta.home.description} home>
  <HeroPortada lang={lang} />
  <SeccionServicios lang={lang} />
  <SeccionPlanes lang={lang} />
  <SeccionKit lang={lang} />
  <SeccionProyectos lang={lang} />
  <SeccionEstudio lang={lang} />
  <SeccionContacto lang={lang} />
</Base>
