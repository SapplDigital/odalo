---
import Base from '../../../../layouts/Base.astro';
import Art from '../../../../components/Art.astro';
import ConceptImage from '../../../../components/ConceptImage.astro';
import SeccionContacto from '../../../../components/home/SeccionContacto.astro';
import { languages, href, languageNames, type Lang } from '../../../../i18n';
import { tr } from '../../../../i18n/ui';
import { projects, projectById } from '../../../../content/projects';
import { serviceById } from '../../../../content/services';

export function getStaticPaths() {
  return languages.flatMap((lang) => projects.map((p) => ({ params: { lang, project: p.id } })));
}
const lang = Astro.params.lang as Lang;
const p = projectById(Astro.params.project!)!;
const rel = projectById(p.related)!;
const t = tr(lang);
const artTone = { ink: 'slate', sand: 'coral', coral: 'sand', slate: 'ink' } as const;
const badge = p.badge ? p.badge[lang] : t.work.sampleBadge;
const hero = p.images?.find((i) => i.role === 'card');
const screens = (p.images ?? []).filter((i) => i.role === 'screen');
const creatives = (p.images ?? []).filter((i) => i.role === 'creative');
const videos = p.videos ?? [];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const mediaUrl = (folder: string, file: string) => `${base}/work/concepts/${folder}/${file}`;
const shotLang = (i: NonNullable<typeof p.images>[number]) => t.work.concept.shotLang.replace('{lang}', languageNames[i.screenshotLang].label[lang]);
const lead = p.concept ? (p.status ? p.status[lang] : t.common.sampleNote) : t.common.sampleNote;
---
<Base lang={lang} title={`${p.title[lang]} — ${p.badge ? p.badge[lang] : t.common.sample} — Odalo`} description={p.context[lang]}>
  <div class="pj">
    <div class="wrap pj__in">
      <div class="pj__intro" data-project-intro>
        <p class="pj__tag"><span aria-hidden="true">→</span> {p.kind[lang]} · {badge}</p>
        <h1 class="h-hero pj__h">{p.title[lang]}</h1>
        <p class="lead pj__lead">{lead}</p>
        <a class="pj__back" href={href(lang, 'work/')}><span aria-hidden="true">←</span> {t.nav.work}</a>
      </div>

      <section class="pj__media" data-project-media aria-label={t.work.imagery}>
        {hero ? (
          <figure class="pj__fig">
            <div class="pj__frame">
              <ConceptImage image={hero} lang={lang} eager sizes="(min-width: 64em) 80vw, 100vw" />
            </div>
            <figcaption>{hero.caption[lang]} {shotLang(hero)}</figcaption>
          </figure>
        ) : (
          <figure class="pj__fig pj__fig--art">
            <div class="pj__frame">
              <Art variant={p.art} tone={artTone[p.tone]} label={`${p.title[lang]}. ${t.a11y.sampleArt}`} />
            </div>
            <figcaption>{t.work.imageryNote}</figcaption>
          </figure>
        )}
      </section>

      <div class="pj__body" data-project-body>
        <div class="pj__card">
          <h2 class="pj__h2">{p.concept ? t.work.concept.brief : t.work.context}</h2>
          <p>{p.context[lang]}</p>
        </div>
        <div class="pj__card">
          <h2 class="pj__h2">{p.concept ? t.work.concept.approach : t.work.challenge}</h2>
          <p>{p.challenge[lang]}</p>
        </div>
        <div class="pj__card">
          <h2 class="pj__h2">{p.concept ? t.work.concept.produced : t.work.connected}</h2>
          <p>{p.connected[lang]}</p>
          <ul class="pj__svc">{p.services.map((sid) => <li><a href={href(lang, `services/${sid}/`)}>{serviceById(sid)!.name[lang]}</a></li>)}</ul>
        </div>
        {!p.concept && (
          <div class="pj__card">
            <h2 class="pj__h2">{t.work.outcomes}</h2>
            <p>{t.work.outcomesPending}</p>
          </div>
        )}
      </div>

      {p.concept && (screens.length > 0 || videos.length > 0) && (
        <section class="pj__sec" data-project-shots aria-labelledby="shots-h">
          <h2 id="shots-h" class="pj__h2b">{p.outputsTitle ? p.outputsTitle[lang] : t.work.concept.screensH}</h2>
          {p.screens && <p class="pj__note">{p.screens[lang]}</p>}
          <div class="shots__grid" aria-label={t.work.concept.shotsLabel}>
            {screens.map((img) => (
              <figure class:list={['shot', `shot--${img.id.replace(/^[a-z]+-/, '')}`]}>
                <ConceptImage image={img} lang={lang} sizes={img.height > img.width ? '(min-width: 48em) 30vw, 22rem' : '(min-width: 48em) 62vw, 100vw'} />
                <figcaption>{img.caption[lang]} {shotLang(img)}</figcaption>
              </figure>
            ))}
            {videos.map((v) => (
              <figure class="shot shot--video">
                <video controls preload="none" playsinline width={v.width} height={v.height} poster={`${mediaUrl(v.folder, v.poster.file)}-${v.poster.width}.webp`} aria-label={v.label[lang]}>
                  {v.formats.map((f) => <source src={`${mediaUrl(v.folder, v.file)}.${f.ext}`} type={f.type} />)}
                  <p>{t.work.concept.videoFallback}</p>
                </video>
                <figcaption>{v.caption[lang]} {t.work.concept.videoNote}</figcaption>
              </figure>
            ))}
          </div>
          {creatives.length === 0 && <p class="pj__src"><strong>{t.work.concept.imageSource}.</strong> {(screens[0] ?? creatives[0]).provenance[lang]}</p>}
        </section>
      )}

      {p.concept && creatives.length > 0 && (
        <section class="pj__sec" data-project-creatives aria-labelledby="creatives-h">
          <h2 id="creatives-h" class="pj__h2b">{t.work.concept.creativesH}</h2>
          <p class="pj__note">{t.work.concept.creativesNote}</p>
          <div class="creatives__grid">
            {creatives.map((img) => (
              <figure class="shot shot--creative">
                <ConceptImage image={img} lang={lang} sizes="(min-width: 48em) 45vw, 100vw" />
                <figcaption>{img.caption[lang]} {shotLang(img)}</figcaption>
              </figure>
            ))}
          </div>
          <p class="pj__src"><strong>{t.work.concept.imageSource}.</strong> {creatives[0].provenance[lang]}</p>
        </section>
      )}

      {p.concept && p.plan && (
        <section class="pj__sec" data-project-plan aria-labelledby="plan-h">
          <h2 id="plan-h" class="pj__h2b">{p.planTitle ? p.planTitle[lang] : t.work.concept.planH}</h2>
          <p class="pj__note">{p.planNote ? p.planNote[lang] : t.work.concept.planNote}</p>
          <ol class="plan__list">{p.plan[lang].map((step) => <li>{step}</li>)}</ol>
        </section>
      )}

      <section class="pj__next" data-project-next aria-labelledby="next-h">
        <h2 id="next-h" class="pj__h2">{t.work.related}</h2>
        <a class="pj__nextlink link-arrow" href={href(lang, `work/${rel.id}/`)}>{rel.title[lang]}</a>
      </section>
    </div>
  </div>
  <div data-project-closing>
    <SeccionContacto lang={lang} />
  </div>
</Base>
<style>
  .pj { background: var(--paper); padding-top: 8rem; padding-bottom: 5rem; }
  .pj__in { display: grid; gap: var(--s7, 4rem); min-width: 0; }
  .pj__in > * { min-width: 0; margin: 0; }
  .pj__intro { display: grid; gap: var(--s5); justify-items: start; max-width: 60rem; }
  .pj__intro > * { margin: 0; min-width: 0; }
  .pj__tag { display: inline-flex; gap: 0.5rem; padding: 0.25rem 0.75rem; border: 1px solid var(--ink-200); border-radius: 999px; background: var(--surface); font-family: var(--font-mono); font-size: var(--text-micro); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-700); max-width: 100%; overflow-wrap: anywhere; }
  .pj__h { font-size: var(--text-h2); overflow-wrap: anywhere; hyphens: auto; }
  .pj__lead { max-width: var(--measure-prose); }
  .pj__back { color: var(--ink); font-family: var(--font-mono); font-size: var(--text-micro); letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid var(--ink-200); overflow-wrap: anywhere; }
  .pj__back:hover { border-bottom-color: var(--ink); }
  .pj__fig { margin: 0; display: grid; gap: 12px; min-width: 0; }
  .pj__frame { overflow: hidden; border: 1px solid var(--ink-200); border-radius: var(--radius-tile); background: var(--surface); }
  .pj__frame :global(img), .pj__frame :global(svg.art) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
  .pj__fig figcaption, .shot figcaption { font-size: 0.9375rem; max-width: var(--measure-prose); overflow-wrap: anywhere; color: var(--ink-700); }
  .pj__body { display: grid; gap: var(--s5); grid-template-columns: minmax(0, 1fr); }
  .pj__card { display: grid; gap: var(--s3); align-content: start; padding: var(--s5); border: 1px solid var(--ink-200); border-radius: var(--radius-tile); background: var(--surface); min-width: 0; overflow-wrap: anywhere; }
  .pj__card > * { margin: 0; }
  .pj__h2 { font-family: var(--font-mono); font-size: var(--text-micro); letter-spacing: 0.08em; text-transform: uppercase; font-weight: 500; color: var(--ink-500); }
  .pj__h2b { font-size: var(--text-h3, 1.75rem); font-weight: 500; line-height: 1.2; overflow-wrap: anywhere; }
  .pj__sec { display: grid; gap: var(--s4); border-top: 1px solid var(--ink-200); padding-top: var(--s6); min-width: 0; }
  .pj__sec > * { margin: 0; min-width: 0; }
  .pj__note { max-width: var(--measure-prose); }
  .pj__svc { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pj__svc a { display: inline-flex; align-items: center; min-height: 44px; padding: 4px 16px; border: 1px solid var(--ink-200); border-radius: 999px; background: var(--paper); color: var(--ink); text-decoration: none; font-size: 1rem; }
  .pj__svc a:hover { border-color: var(--ink); }
  .shots__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s6); align-items: start; }
  .shot { margin: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; align-content: start; min-width: 0; }
  .shot :global(img) { display: block; width: 100%; height: auto; border: 1px solid var(--ink-200); border-radius: var(--radius-tile); }
  .shot--mobile, .shot--video { max-width: 24rem; }
  .shot--video video { display: block; width: 100%; height: auto; aspect-ratio: 9 / 16; background: var(--ink); border: 1px solid var(--ink-200); border-radius: var(--radius-tile); }
  .shot--video video:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .creatives__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s6); align-items: start; }
  .shot--creative :global(img) { max-width: 36rem; }
  .plan__list { display: grid; gap: var(--s4); max-width: 70ch; padding-left: 0; counter-reset: plan; list-style: none; margin: 0; }
  .plan__list li { counter-increment: plan; position: relative; padding-left: 3rem; overflow-wrap: anywhere; }
  .plan__list li::before { content: counter(plan); position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; border: 1px solid var(--ink-200); background: var(--surface); border-radius: 999px; display: grid; place-items: center; font-family: var(--font-mono); font-size: var(--text-micro); }
  .pj__src { max-width: 70ch; font-size: 0.9375rem; overflow-wrap: anywhere; color: var(--ink-700); }
  .pj__next { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s5); border-top: 1px solid var(--ink-200); padding-top: var(--s6); }
  .pj__nextlink { min-width: 0; max-width: 100%; overflow-wrap: anywhere; }
  @media (min-width: 48em) {
    .shots__grid { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
    .creatives__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 768px) { .pj { padding-top: 10rem; padding-bottom: 7rem; } }
  @media (min-width: 1024px) { .pj__body { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
