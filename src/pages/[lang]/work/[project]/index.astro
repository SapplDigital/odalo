---
import Base from '../../../../layouts/Base.astro';
import PageHero from '../../../../components/PageHero.astro';
import Art from '../../../../components/Art.astro';
import FinalCta from '../../../../components/FinalCta.astro';
import { languages, href, type Lang } from '../../../../i18n';
import { tr } from '../../../../i18n/ui';
import { projects, projectById } from '../../../../content/projects';
import { serviceById } from '../../../../content/services';

export function getStaticPaths() {
  return languages.flatMap((lang) => projects.map((p) => ({ params: { lang, project: p.id } })));
}
const lang = Astro.params.lang as Lang;
const p = projectById(Astro.params.project!)!;
const rel = projectById(p.related)!;
const t = tr(lang);
const artTone = { ink: 'slate', sand: 'coral', coral: 'sand', slate: 'ink' } as const;
---
<Base lang={lang} title={`${p.title[lang]} — ${t.common.sample} — Odalo`} description={p.context[lang]}>
  <PageHero lang={lang} eyebrow={`${p.kind[lang]} · ${t.work.sampleBadge}`} title={{ a: p.title[lang] }} lead={t.common.sampleNote}
    crumbs={[{ label: t.nav.work, to: href(lang, 'work/') }, { label: p.title[lang] }]} />

  <section class="section cs" aria-label={t.work.imagery}>
    <div class="wrap cs__grid">
      <figure class="cs__art c-tl">
        <Art variant={p.art} tone={artTone[p.tone]} label={`${p.title[lang]}. ${t.a11y.sampleArt}`} />
        <figcaption>{t.work.imageryNote}</figcaption>
      </figure>
      <div class="cs__block cs__block--sand">
        <h2 class="cs__h">{t.work.context}</h2>
        <p>{p.context[lang]}</p>
      </div>
      <div class="cs__block cs__block--ink on-dark c-br">
        <h2 class="cs__h">{t.work.challenge}</h2>
        <p>{p.challenge[lang]}</p>
      </div>
      <div class="cs__block cs__block--paper">
        <h2 class="cs__h">{t.work.connected}</h2>
        <p>{p.connected[lang]}</p>
        <ul class="cs__svc">{p.services.map((sid) => <li><a href={href(lang, `services/${sid}/`)}>{serviceById(sid)!.name[lang]}</a></li>)}</ul>
      </div>
      <div class="cs__block cs__block--coral on-coral c-tr">
        <h2 class="cs__h">{t.work.outcomes}</h2>
        <p>{t.work.outcomesPending}</p>
      </div>
    </div>
  </section>

  <section class="section next" aria-labelledby="next-h">
    <div class="wrap next__in">
      <h2 id="next-h" class="h-tile">{t.work.related}</h2>
      <a class="next__link link-arrow" href={href(lang, `work/${rel.id}/`)}>{rel.title[lang]}</a>
    </div>
  </section>
  <FinalCta lang={lang} />
</Base>
<style>
  .cs__grid { display: grid; gap: var(--gutter); }
  .cs__art { position: relative; margin: 0; aspect-ratio: 16 / 10; overflow: hidden; border-radius: var(--r-small); }
  .cs__art figcaption { position: absolute; left: 12px; bottom: 12px; background: var(--paper); color: var(--ink); font-size: 0.8125rem; font-weight: 600; padding: 3px 12px; border-radius: 999px; max-width: calc(100% - 24px); }
  .c-tl { border-top-left-radius: var(--r-big); } .c-br { border-bottom-right-radius: var(--r-big); } .c-tr { border-top-right-radius: var(--r-big); }
  .cs__block { padding: var(--pad); border-radius: var(--r-small); display: grid; gap: var(--s3); align-content: start; font-size: 1.125rem; }
  .cs__block--sand { background: var(--sand); } .cs__block--ink { background: var(--ink); color: var(--paper); } .cs__block--paper { background: var(--paper); box-shadow: inset 0 0 0 2px var(--ink); } .cs__block--coral { background: var(--coral); color: var(--ink-deep); }
  .cs__block.c-br { border-bottom-right-radius: var(--r-big); } .cs__block.c-tr { border-top-right-radius: var(--r-big); }
  .cs__h { font-size: 0.8125rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; }
  .cs__block--ink .cs__h { color: var(--coral-light); }
  .cs__svc { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .cs__svc a { display: inline-flex; align-items: center; min-height: 44px; padding: 4px 16px; border: 2px solid var(--ink); border-radius: 999px; font-weight: 600; font-size: 1rem; text-decoration: none; }
  .cs__svc a:hover { background: var(--ink); color: var(--paper); }
  .next__in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s5); border-top: 2px solid var(--ink); padding-top: var(--s6); }
  @media (min-width: 1024px) {
    .cs__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .cs__art { grid-column: 1 / span 7; grid-row: 1 / span 2; aspect-ratio: auto; min-height: 24rem; }
    .cs__block--sand { grid-column: 8 / -1; } .cs__block--ink { grid-column: 8 / -1; }
    .cs__block--paper { grid-column: 1 / span 7; } .cs__block--coral { grid-column: 8 / -1; }
  }
</style>
