---
import Base from '../../../layouts/Base.astro';
import AuditForm from '../../../components/AuditForm.astro';
import { languages, type Lang } from '../../../i18n';
import { tr } from '../../../i18n/ui';
import { site } from '../../../config/site';
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = tr(lang);
const pieces = t.audit.mosaic.pieces;
const review = [pieces.web, pieces.local, pieces.video, pieces.ads];
const { email, phone } = site.contact;
---
<Base lang={lang} title={t.meta.audit.title} description={t.meta.audit.description}>
  <section class="ad" data-audit-page aria-labelledby="audit-h">
    <div class="ad__grid" data-audit-decor aria-hidden="true"></div>
    <div class="wrap ad__layout">
      <div class="ad__intro" data-audit-intro>
        <p class="ad__tag"><span aria-hidden="true">→</span> {t.audit.eyebrow}</p>
        <h1 id="audit-h" class="h-hero ad__h">{t.audit.h1.a} <em>{t.audit.h1.em}</em></h1>
        <p class="lead ad__lead">{t.audit.lead}</p>
        <div class="ad__review" data-audit-review>
          <p class="ad__label">{t.audit.reviewLabel}</p>
          <ol class="ad__list">
            {review.map((p, i) => (
              <li><span class="ad__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span><strong>{p.n}</strong> {p.s}</span></li>
            ))}
          </ol>
        </div>
        <div class="ad__alt" data-audit-alt>
          <p class="ad__altH">{t.audit.altH}</p>
          {email || phone ? (
            <ul>{email && <li><a href={`mailto:${email}`}>{email}</a></li>}{phone && <li><a href={`tel:${phone}`}>{phone}</a></li>}</ul>
          ) : <p>{t.audit.altPending}</p>}
        </div>
      </div>
      <div class="ad__card" data-audit-form-card id="request"><AuditForm lang={lang} /></div>
    </div>
  </section>
</Base>
<style>
  .ad { position: relative; overflow: clip; background: var(--paper); padding-block: calc(var(--header-h) + var(--s7)) var(--s9); }
  .ad__grid {
    position: absolute; inset: 0; pointer-events: none; z-index: 0; opacity: 0.35;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
  }
  .ad__layout { position: relative; z-index: 1; display: grid; gap: var(--s8); grid-template-columns: minmax(0, 1fr); align-items: start; }
  .ad__intro { display: grid; gap: var(--s5); min-width: 0; justify-items: start; }
  .ad__intro > * { margin: 0; min-width: 0; }
  .ad__tag { display: inline-flex; gap: 0.5rem; padding: 0.25rem 0.75rem; border: 1px solid var(--ink-200); border-radius: 999px; background: var(--surface); font-family: var(--font-mono); font-size: var(--text-micro); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-700); }
  .ad__h { font-size: var(--text-h2); overflow-wrap: anywhere; hyphens: auto; }
  .ad__review { width: 100%; border-top: 1px solid var(--line); padding-top: var(--s5); margin-top: var(--s4); }
  .ad__label { font-family: var(--font-mono); font-size: var(--text-micro); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-500); }
  .ad__list { list-style: none; padding: 0; margin: var(--s4) 0 0; display: grid; gap: var(--s3); }
  .ad__list li { display: flex; gap: var(--s4); font-size: 1rem; color: var(--ink); overflow-wrap: anywhere; }
  .ad__n { padding-top: 2px; font-family: var(--font-mono); font-size: var(--text-micro); color: var(--ink-500); }
  .ad__alt { display: grid; gap: var(--s2); font-size: 0.9375rem; color: var(--ink-600); margin-top: var(--s4); }
  .ad__altH { font-weight: 600; color: var(--ink); }
  .ad__alt ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0 var(--s4); }
  .ad__alt a { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink); font-weight: 500; text-decoration: underline; text-underline-offset: 4px; overflow-wrap: anywhere; }
  .ad__card { min-width: 0; padding: var(--s5); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-panel); box-shadow: var(--shadow-soft); scroll-margin-top: calc(var(--header-h) + var(--s4)); }
  .ad__card:focus { outline: none; }
  @media (min-width: 48em) { .ad__card { padding: var(--s7); } }
  @media (min-width: 64em) {
    .ad { padding-block: calc(var(--header-h) + var(--s8)) var(--s10); }
    .ad__layout { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--s7); }
    .ad__intro { grid-column: span 5; }
    .ad__card { grid-column: 6 / span 7; }
  }
</style>
