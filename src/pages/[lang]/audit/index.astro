---
import Base from '../../../layouts/Base.astro';
import AuditMosaic from '../../../components/AuditMosaic.astro';
import AuditForm from '../../../components/AuditForm.astro';
import { languages, type Lang } from '../../../i18n';
import { tr } from '../../../i18n/ui';
import { site } from '../../../config/site';
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = tr(lang);
const m = t.audit.mosaic;
const { email, phone } = site.contact;
---
<Base lang={lang} title={t.meta.audit.title} description={t.meta.audit.description}>
  <div class="wrap">
    <AuditMosaic lang={lang} />
    <section class="am-req" id="request" aria-labelledby="am-req-h" tabindex="-1">
      <div class="am-req__side">
        <div class="am-req__in">
          <h2 id="am-req-h">{m.reqH}</h2>
          <!-- summary mirrors the form; hidden until the script has read the form so first paint / no-JS never shows a contradicting state -->
          <dl class="am-sum" data-am-summary hidden>
            <div><dt>{m.focusLabel}</dt><dd data-am-focus>{m.none}</dd></div>
            <div><dt>{m.planLabel}</dt><dd data-am-plan>{m.planNone}</dd></div>
          </dl>
          <p class="am-sum__note" data-js-only-note>{m.focusNote}</p>
          <button type="button" class="am-btn am-btn--ghost" data-am-clear aria-pressed="true" hidden>{m.clearFocus}</button>
          <p class="sr-only" role="status" aria-live="polite" data-am-live></p>
          <div class="am-alt">
            <h3>{t.audit.altH}</h3>
            {email || phone ? (
              <ul>{email && <li><a href={`mailto:${email}`}>{email}</a></li>}{phone && <li><a href={`tel:${phone}`}>{phone}</a></li>}</ul>
            ) : <p>{t.audit.altPending}</p>}
          </div>
        </div>
      </div>
      <div class="am-req__form"><AuditForm lang={lang} /></div>
    </section>
  </div>
</Base>
<style>
  .am-req { display: grid; margin-block: var(--s8); --tile-bg: var(--ink); --tile-fg: var(--paper); align-items: start; }
  .am-req:focus { outline: none; }
  .am-req__side { --focus: var(--coral-light); --btn-bg: var(--coral); --btn-fg: var(--ink-deep); background: var(--ink); color: var(--paper); padding: calc(var(--pad) + var(--s4)) var(--pad) var(--pad); border-top-left-radius: var(--r-big); }
  .am-req__in { display: grid; gap: var(--s4); align-content: start; }
  .am-req h2 { font-size: var(--fs-h3); font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; }
  .am-sum { display: grid; gap: var(--s3); }
  .am-sum[hidden] { display: none; }
  .am-sum dt { font-size: 0.9375rem; font-weight: 600; color: var(--coral-light); }
  .am-sum dd { font-size: 1.25rem; font-weight: 600; margin: 0; }
  .am-sum__note { font-size: 0.9375rem; color: var(--sand); max-width: 36ch; }
  .am-req__side :global(.am-btn) { justify-self: start; }
  .am-req__side :global(.am-btn[aria-pressed='true']) { background: var(--paper); border-color: var(--paper); color: var(--ink); }
  .am-alt { display: grid; gap: var(--s2); margin-top: var(--s4); padding-top: var(--s4); border-top: 1px solid var(--coral-light); }
  .am-alt h3 { font-size: 1.0625rem; font-weight: 700; }
  .am-alt a { text-underline-offset: 0.2em; overflow-wrap: anywhere; }
  .am-req__form { background: var(--sand); padding: var(--pad); border-bottom-right-radius: var(--r-big); min-width: 0; }
  /* desktop: the summary is a compact horizontal strip ABOVE the form (heading | focus + plan | note + clear | email), the form below it at a readable width; one coherent centred block */
  @media (min-width: 64em) {
    .am-req { max-width: 58rem; margin-inline: auto; }
    .am-req__side { padding: var(--s5) var(--pad); }
    .am-req__in { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s3) var(--s7); }
    .am-sum { display: flex; gap: var(--s6); }
    .am-sum__note { max-width: 30ch; }
    .am-alt { margin: 0 0 0 auto; padding: 0 0 0 var(--s5); border-top: 0; border-left: 1px solid var(--coral-light); }
  }
  /* phone: a compact strip above the form: heading, the two summary values side by side, note and clear button, email on one line */
  @media (max-width: 63.99em) {
    .am-req { margin-block: var(--s6); }
    .am-req__side { padding: var(--s5) var(--s4); border-top-left-radius: 0; }
    .am-req__in { gap: var(--s2); }
    .am-sum { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s2) var(--s4); }
    .am-sum dd { font-size: 1.0625rem; }
    .am-alt { margin-top: var(--s2); padding-top: var(--s2); gap: 0; }
    .am-alt ul { display: flex; flex-wrap: wrap; gap: 0 var(--s4); }
    .am-alt a { display: inline-flex; align-items: center; min-height: 44px; }
    .am-req__form { padding: var(--s5) var(--s4); border-bottom-right-radius: 0; }
  }
</style>
