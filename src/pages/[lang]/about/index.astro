---
import Base from '../../../layouts/Base.astro';
import About from '../../../components/About.astro';
import Faq from '../../../components/Faq.astro';
import FinalCta from '../../../components/FinalCta.astro';
import { languages, type Lang } from '../../../i18n';
import { tr } from '../../../i18n/ui';
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = tr(lang);
---
<Base lang={lang} title={t.meta.about.title} description={t.meta.about.description}>
  <About lang={lang} page />
  <section class="section pr" aria-labelledby="pr-h">
    <div class="wrap pr__in">
      <h2 id="pr-h" class="h-section">{t.about.principles}</h2>
      <ol class="pr__list">
        {t.about.principlesItems.map((p, i) => (
          <li><span class="pr__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3 class="h-tile">{p.t}</h3><p>{p.d}</p></li>
        ))}
      </ol>
    </div>
  </section>
  <Faq lang={lang} ids={['international', 'languages']} heading={{ a: t.about.international, em: '' }} id="about-faq" />
  <FinalCta lang={lang} />
</Base>
<style>
  .pr__in { display: grid; gap: var(--s7); }
  .pr__list { display: grid; gap: var(--gutter); }
  .pr__list li { padding: var(--pad); background: var(--sand); border-radius: var(--r-small); display: grid; gap: var(--s3); align-content: start; }
  .pr__list li:nth-child(1) { border-top-left-radius: 56px; } .pr__list li:nth-child(2) { background: var(--paper); box-shadow: inset 0 0 0 2px var(--ink); } .pr__list li:nth-child(3) { border-bottom-right-radius: 56px; }
  .pr__n { font-weight: 800; color: var(--rust-text); letter-spacing: 0.1em; }
  @media (min-width: 64em) { .pr__list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
