---
import Base from '../../../layouts/Base.astro';
import AboutHero from '../../../components/about/AboutHero.astro';
import AboutServices from '../../../components/about/AboutServices.astro';
import AboutPrinciples from '../../../components/about/AboutPrinciples.astro';
import AboutStudio from '../../../components/about/AboutStudio.astro';
import AboutClosing from '../../../components/about/AboutClosing.astro';
import { languages, type Lang } from '../../../i18n';
import { tr } from '../../../i18n/ui';
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = tr(lang);
---
<Base lang={lang} title={t.meta.about.title} description={t.meta.about.description}>
  <AboutHero lang={lang} />
  <AboutServices lang={lang} />
  <AboutPrinciples lang={lang} />
  <AboutStudio lang={lang} />
  <AboutClosing lang={lang} />
</Base>
