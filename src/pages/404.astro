---
// Language-neutral missing-page recovery (static hosts serve /404.html for any lang).
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { href, languages, languageNames } from '../i18n';
import { ui } from '../i18n/ui';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{ui.en.meta.notFound.title}</title><meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
  </head>
  <body>
    <main class="nf wrap" id="main">
      <a href={href('en')} aria-label="Odalo"><Logo width={170} /></a>
      <p class="eyebrow">404</p>
      <h1 class="h-hero nf__h">{ui.en.errors.h1}</h1>
      <p class="lead">{ui.en.errors.body}</p>
      <ul class="nf__links">
        {languages.map((l) => (
          <li><a class="btn btn--ghost" href={href(l)} lang={l} hreflang={l}>{ui[l].errors.home} · {languageNames[l].native}</a></li>
        ))}
      </ul>
    </main>
  </body>
</html>
<style>
  .nf { min-height: 100dvh; display: grid; align-content: center; justify-items: start; gap: var(--s5); padding-block: var(--s8); }
  .nf__h { font-size: clamp(2.5rem, 1.5rem + 4vw, 5rem); max-width: 14ch; }
  .nf__links { display: flex; flex-wrap: wrap; gap: var(--s3); }
</style>
