---
// Language-neutral missing-page recovery (static hosts serve /404.html for any lang). Shared English shell (owner logo, page field), noindex.
import Base from '../layouts/Base.astro';
import { href, languages, languageNames } from '../i18n';
import { ui } from '../i18n/ui';
---
<Base lang="en" title={ui.en.meta.notFound.title} description={ui.en.errors.body} noindex>
  <section class="nf">
    <div class="wrap nf__in">
      <p class="eyebrow">404</p>
      <h1 class="h-hero nf__h">{ui.en.errors.h1}</h1>
      <p class="lead">{ui.en.errors.body}</p>
      <ul class="nf__links">
        {languages.map((l) => (
          <li><a class="btn btn--ghost" href={href(l)} lang={l} hreflang={l}>{ui[l].errors.home} · {languageNames[l].native}</a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
<style>
  .nf { padding-block: var(--s8); }
  .nf__in { display: grid; justify-items: start; gap: var(--s5); }
  .nf__h { font-size: clamp(2.5rem, 1.5rem + 4vw, 5rem); max-width: 14ch; }
  .nf__links { display: flex; flex-wrap: wrap; gap: var(--s3); }
</style>
