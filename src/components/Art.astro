---
/**
 * Geometric placeholder artwork built from the logo's shape vocabulary.
 * REPLACEMENT POINT: where approved photography exists, swap the <Art> usage for an
 * <img> with real dimensions (see HANDOFF.md → "Replacing artwork"). Never bake text into art.
 */
interface Props {
  variant: 'browser' | 'pin' | 'video' | 'chart' | 'studio' | 'hero-web' | 'hero-video';
  tone?: 'ink' | 'sand' | 'coral' | 'slate' | 'paper';
  label?: string;
  class?: string;
}
const { variant, tone = 'sand', label, class: cls } = Astro.props;
const bg = { ink: 'var(--ink)', sand: 'var(--sand)', coral: 'var(--coral)', slate: 'var(--slate)', paper: 'var(--paper)' }[tone];
const vb = ({ 'hero-video': '0 0 480 190', 'hero-web': '10 22 220 138' } as Record<string, string>)[variant] ?? '0 0 240 180';
const dark = tone === 'ink' || tone === 'slate';
const fg = dark ? 'var(--paper)' : 'var(--ink)';
const acc = tone === 'coral' ? 'var(--ink)' : 'var(--coral)';
const alt = tone === 'slate' ? 'var(--sand)' : 'var(--slate)';
---
<svg
  class:list={['art', cls]}
  viewBox={vb}
  preserveAspectRatio="xMidYMid meet"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  style={`--bg:${bg};--fg:${fg};--acc:${acc};--alt:${alt}`}
>
  <rect width="480" height="190" fill="var(--bg)" />
  {(variant === 'browser' || variant === 'hero-web') && (
    <g>
      <rect x="34" y="30" width="172" height="120" rx="6" fill="var(--paper)" />
      <path d="M34 36a6 6 0 0 1 6-6h160a6 6 0 0 1 6 6v12H34Z" fill="var(--fg)" />
      <circle cx="46" cy="39" r="3" fill="var(--coral)" /><circle cx="57" cy="39" r="3" fill="var(--sand)" /><circle cx="68" cy="39" r="3" fill="var(--sand)" />
      <rect x="48" y="62" width="72" height="9" rx="1" fill="var(--ink)" />
      <rect x="48" y="77" width="52" height="9" rx="1" fill="var(--ink)" />
      <rect x="48" y="96" width="64" height="4" fill="var(--slate)" opacity=".6" /><rect x="48" y="104" width="50" height="4" fill="var(--slate)" opacity=".6" />
      <rect x="48" y="118" width="40" height="16" rx="8" fill="var(--coral)" />
      <path d="M206 150V86a36 36 0 0 0-72 0v64Z" fill="var(--alt)" opacity="0" />
      <circle cx="170" cy="92" r="26" fill="var(--acc)" />
      <path d="M144 150v-30a26 26 0 0 1 26-26h0v56Z" fill="var(--ink)" />
    </g>
  )}
  {variant === 'pin' && (
    <g>
      <circle cx="120" cy="108" r="74" fill="none" stroke="var(--fg)" stroke-opacity=".18" stroke-width="2" />
      <circle cx="120" cy="108" r="48" fill="none" stroke="var(--fg)" stroke-opacity=".28" stroke-width="2" />
      <rect x="40" y="22" width="160" height="24" rx="12" fill="var(--paper)" />
      <circle cx="56" cy="34" r="5" fill="none" stroke="var(--ink)" stroke-width="2" /><rect x="68" y="31" width="70" height="6" rx="3" fill="var(--ink)" opacity=".5" />
      <path d="M120 150c-18-22-26-34-26-46a26 26 0 0 1 52 0c0 12-8 24-26 46Z" fill="var(--acc)" />
      <circle cx="120" cy="104" r="10" fill="var(--paper)" />
      <path d="M40 160h60a0 0 0 0 1 0 0v20H40Z" fill="var(--alt)" opacity=".0" />
      <rect x="164" y="132" width="52" height="8" rx="4" fill="var(--fg)" opacity=".55" /><rect x="164" y="148" width="36" height="8" rx="4" fill="var(--fg)" opacity=".35" />
    </g>
  )}
  {variant === 'hero-video' && (
    <g>
      <rect x="36" y="24" width="290" height="124" rx="6" fill="var(--fg)" />
      <circle cx="181" cy="86" r="30" fill="var(--acc)" />
      <path d="M171 70l26 16-26 16Z" fill="#132338" />
      <rect x="36" y="162" width="290" height="6" rx="3" fill="var(--fg)" opacity=".3" />
      <rect x="36" y="162" width="132" height="6" rx="3" fill="var(--coral)" />
      <circle cx="168" cy="165" r="8" fill="var(--paper)" />
      <circle cx="402" cy="62" r="34" fill="var(--sand)" />
      <path d="M480 190H356A124 124 0 0 1 480 66Z" fill="var(--alt)" />
      <rect x="352" y="22" width="0" height="0" />
    </g>
  )}
  {variant === 'video' && (
    <g>
      <rect x="30" y="28" width="180" height="104" rx="6" fill="var(--fg)" />
      <path d="M210 132V100a60 60 0 0 0-60-60h-0v92Z" fill="var(--alt)" opacity=".55" />
      <circle cx="120" cy="80" r="26" fill="var(--acc)" />
      <path d="M112 66l24 14-24 14Z" fill="var(--ink-deep, #132338)" />
      <rect x="30" y="146" width="180" height="6" rx="3" fill="var(--fg)" opacity=".25" />
      <rect x="30" y="146" width="84" height="6" rx="3" fill="var(--coral)" />
      <circle cx="114" cy="149" r="7" fill="var(--paper)" />
    </g>
  )}
  {variant === 'chart' && (
    <g>
      <rect x="40" y="108" width="28" height="48" fill="var(--fg)" opacity=".35" />
      <rect x="78" y="84" width="28" height="72" fill="var(--fg)" opacity=".55" />
      <rect x="116" y="60" width="28" height="96" fill="var(--fg)" opacity=".8" />
      <path d="M154 156V60a28 28 0 0 1 28-28h0v124Z" fill="var(--acc)" />
      <circle cx="196" cy="48" r="14" fill="var(--paper)" />
      <path d="M40 160h160" stroke="var(--fg)" stroke-width="2" opacity=".4" />
    </g>
  )}
  {variant === 'studio' && (
    <g>
      <circle cx="84" cy="74" r="34" fill="var(--acc)" />
      <path d="M30 156a54 54 0 0 1 108 0Z" fill="var(--fg)" />
      <path d="M150 156v-78a40 40 0 0 1 40 40v38Z" fill="var(--alt)" />
      <circle cx="176" cy="52" r="16" fill="var(--paper)" />
    </g>
  )}
</svg>
<style>
  .art { width: 100%; height: 100%; background: var(--bg); }
</style>
