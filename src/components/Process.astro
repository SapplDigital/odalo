---
import { type Lang } from '../i18n';
import { tr } from '../i18n/ui';
interface Props { num?: string; lang: Lang }
const { num, lang } = Astro.props;
const t = tr(lang);
const tones = ['sand', 'coral', 'slate', 'ink'] as const;
---
<section id="process" class="proc section" aria-labelledby="proc-h">
  <div class="wrap">
    <header class="proc__head">
      <p class="eyebrow">{num ? `${num} — ` : ''}{t.nav.process}</p>
      <h2 id="proc-h" class="h-section">{t.process.h2.a} <em>{t.process.h2.em}</em></h2>
      <p class="proc__note">{t.process.note}</p>
    </header>
    <ol class="steps" data-draw>
      {t.process.steps.map((s, i) => (
        <li class:list={['step', `step--${tones[i]}`, { 'on-dark': tones[i] === 'ink' || tones[i] === 'slate', 'on-coral': tones[i] === 'coral' }]} style={`--i:${i}`}>
          <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="h-tile step__title"><span class="sr-only">{i + 1}. </span>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .proc { background: var(--paper); }
  .proc__head { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s4); margin-bottom: var(--s7); max-width: 60rem; }
  .proc__note { color: var(--slate-text); max-width: 52ch; }
  /* One joined mosaic: no gutters, flat internal edges; only the outer silhouette is curved (large top left and bottom right). */
  .steps { display: grid; gap: 0; grid-template-columns: minmax(0, 1fr); }
  .step { position: relative; padding: var(--pad); display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s3); align-content: start; min-width: 0; overflow-wrap: anywhere; hyphens: auto; }
  .step--sand { background: var(--sand); color: var(--ink); --acc: var(--coral); }
  .step--coral { background: var(--coral); color: var(--ink-deep); --acc: var(--ink-deep); }
  .step--slate { background: var(--slate); color: var(--paper); --acc: var(--sand); }
  .step--ink { background: var(--ink); color: var(--paper); --acc: var(--coral-light); }
  .step:first-child { border-top-left-radius: var(--r-big); }
  .step:last-child { border-bottom-right-radius: var(--r-big); }
  .step__num { font-family: ui-monospace, 'SFMono-Regular', 'Cascadia Mono', Menlo, Consolas, monospace; font-weight: 600; font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem); line-height: 1; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .step__title { font-weight: 600; letter-spacing: -0.01em; text-wrap: balance; }
  .step--sand .step__num { color: var(--rust-text); }
  .step--coral .step__num { color: var(--ink-deep); }
  .step--slate .step__num { color: var(--sand); }
  .step--ink .step__num { color: var(--coral-light); }
  .step p { max-width: 36ch; line-height: 1.55; }

  /* Progress accent: a thin bar along the bottom edge of each panel, drawn once, in order, on first entry (the existing is-in reveal).
     It is painted as part of the panel's own background, so it follows the panel's rounded silhouette exactly while drawing and when
     finished, and needs no clipping of the panel's content. Decoration only: panels, numbers and text are fully visible and never move. */
  @property --draw { syntax: '<percentage>'; inherits: false; initial-value: 100%; }
  .step { --draw: 100%; background-image: linear-gradient(var(--acc), var(--acc)); background-repeat: no-repeat; background-position: left bottom; background-size: var(--draw) 6px; transition: --draw 0.4s var(--ease-glass) calc(0.1s * var(--i)); }
  :global(.js) .steps:not(.is-in) .step { --draw: 0%; }
  @media (prefers-reduced-motion: reduce) { .step { transition: none !important; --draw: 100% !important; } }

  /* Tablet and narrow desktop: equal two by two cells. */
  @media (min-width: 48em) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .step:first-child { border-top-right-radius: 0; }
    .step:nth-child(2) { border-top-right-radius: var(--r-small); }
    .step:nth-child(3) { border-bottom-left-radius: var(--r-small); }
    .step { min-height: 13rem; }
  }
  /* Wide desktop: two rows, 5/7 then 7/5. */
  @media (min-width: 64em) {
    .steps { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .step:nth-child(1) { grid-column: 1 / span 5; }
    .step:nth-child(2) { grid-column: 6 / -1; }
    .step:nth-child(3) { grid-column: 1 / span 7; }
    .step:nth-child(4) { grid-column: 8 / -1; }
  }
  /* Phones: one connected column in order 01 to 04; the small outer corners sit at the column's other two corners. */
  @media (max-width: 47.99em) {
    .step:first-child { border-top-right-radius: var(--r-small); }
    .step:last-child { border-bottom-left-radius: var(--r-small); }
  }
</style>
