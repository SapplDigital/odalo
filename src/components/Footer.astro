---
import LangSwitch from './LangSwitch.astro';
import { href, type Lang } from '../i18n';
import { tr } from '../i18n/ui';
import { site } from '../config/site';
interface Props { lang: Lang; rest: string }
const { lang, rest } = Astro.props;
const t = tr(lang);
const legal = [
  { label: t.footer.privacy, to: href(lang, 'privacy/') },
  { label: t.footer.cookies, to: href(lang, 'cookies/') },
  { label: t.footer.legalNotice, to: href(lang, 'legal/') },
];
const { email, phone } = site.contact;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer data-pie class="pie on-dark">
  <div class="wrap pie__grid">
    <span class="pie__logo"><img class="pie__img" src={`${base}/brand/odalo-owner-logo.png`} alt="" width="273" height="123" /></span>
    <p class="pie__copy">{t.footer.rights} · {t.footer.demo}</p>
    <div class="pie__contact">
      {email || phone ? (
        <ul aria-label={t.footer.contact}>
          {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
          {phone && <li><a href={`tel:${phone}`}>{phone}</a></li>}
        </ul>
      ) : <p>{t.cta.contactDemo}</p>}
    </div>
    <nav aria-label={t.a11y.legalNav} class="pie__legal">
      {legal.map((n) => <a href={n.to}>{n.label}</a>)}
    </nav>
    <div class="pie__extra">
      <details class="pie__store">
        <summary>{t.storage.h}</summary>
        <p>{t.storage.body} <a href={href(lang, 'cookies/')}>{t.footer.cookies}</a></p>
      </details>
      <span class="pie__lang"><LangSwitch lang={lang} rest={rest} dark /></span>
    </div>
  </div>
</footer>
<style>
  .pie { background: var(--ink); color: color-mix(in srgb, #fff 70%, transparent); border-top: 1px solid color-mix(in srgb, #fff 10%, transparent); padding-top: 2.5rem; padding-bottom: 1.5rem; font-size: 14px; }
  .pie__grid { display: grid; gap: 1.5rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 48em) {
    .pie__grid { grid-template-columns: auto 1fr auto; align-items: center; }
    .pie__copy { text-align: center; }
    .pie__legal, .pie__extra { grid-column: 1 / -1; }
  }
  .pie__img { display: block; height: 56px; width: auto; }
  .pie__copy, .pie__contact p { margin: 0; line-height: 1.5; }
  .pie__contact ul { list-style: none; margin: 0; padding: 0; }
  .pie__legal { display: flex; flex-wrap: wrap; gap: 0 1.25rem; }
  .pie__extra { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1.25rem; }
  .pie a, .pie__store summary { display: inline-flex; align-items: center; min-height: 44px; color: inherit; text-underline-offset: 4px; transition: color 180ms; overflow-wrap: anywhere; }
  .pie a { text-decoration: none; }
  .pie a:hover, .pie a:focus-visible, .pie__store summary:hover { color: #fff; text-decoration: underline; }
  .pie a:focus-visible, .pie__store summary:focus-visible { outline: 2px solid #fff; outline-offset: 2px; border-radius: 4px; color: #fff; }
  .pie__store summary { gap: 8px; cursor: pointer; list-style: none; }
  .pie__store summary::-webkit-details-marker { display: none; }
  .pie__store summary::after { content: '+'; font-weight: 700; }
  .pie__store[open] summary::after { content: '\2212'; }
  .pie__store p { max-width: 42ch; margin: 0; padding-block: 4px 8px; line-height: 1.5; }
  .pie__store p a { text-decoration: underline; }
  @media (prefers-reduced-motion: reduce) { .pie a { transition: none; } }
</style>
