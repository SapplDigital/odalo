---
import { href, languages, languageNames, type Lang } from '../i18n';
import { tr } from '../i18n/ui';
import { services } from '../content/services';
interface Props { num?: string; lang: Lang; page?: boolean }
const { num, lang, page = false } = Astro.props;
const t = tr(lang);
const here = page ? 'about/' : '';
const Sub = page ? 'h2' : 'h3'; // panel headings sit one level under the section heading (h1 on the About page, h2 on the homepage)
---
<section id="about" class="about section" aria-labelledby="about-h">
  <div class="wrap">
    <p class="eyebrow about__eyebrow">{num ? `${num} — ` : ''}{t.nav.about}</p>
    <div class="mosaic">
      <div class="story on-dark">
        {page ? <h1 id="about-h" class="h-section">{t.about.h2.a} <em>{t.about.h2.em}</em></h1> : <h2 id="about-h" class="h-section">{t.about.h2.a} <em>{t.about.h2.em}</em></h2>}
        <p class="story__lead">{t.about.lead}</p>
        <div class="story__svc">
          <Sub class="story__h">{t.about.servicesH}</Sub>
          <ul class="story__list">
            {services.map((s) => <li><a href={href(lang, `services/${s.id}/`)}><span class="story__n" aria-hidden="true">{s.number}</span>{s.name[lang]}</a></li>)}
          </ul>
        </div>
      </div>
      <div class="art" aria-hidden="true">
        <svg viewBox="0 0 240 240" preserveAspectRatio="xMidYMid slice" focusable="false">
          <rect width="240" height="240" fill="#efe7d3" />
          <path d="M0 0H120V120A120 120 0 0 1 0 0Z" fill="#203b57" transform="translate(0 0) scale(1)" />
          <path d="M120 0H240V120H120Z" fill="#d98165" />
          <path d="M0 120H120V240H0Z" fill="#50718b" />
          <path d="M120 120H240V240A120 120 0 0 1 120 120Z" fill="#efe7d3" stroke="#203b57" stroke-width="3" />
          <circle cx="120" cy="120" r="30" fill="#f7f9f8" />
          <path d="M120 90A30 30 0 0 1 150 120H120Z" fill="#d98165" />
          <path d="M120 150A30 30 0 0 1 90 120H120Z" fill="#203b57" />
        </svg>
      </div>
      <div class="langs">
        <Sub class="story__h">{t.about.languagesH}</Sub>
        <p>{t.about.languagesBody}</p>
        <ul class="langs__list">
          {languages.map((l) => (
            <li>{l === lang
              ? <span lang={l} aria-current="true">{languageNames[l].native}</span>
              : <a lang={l} hreflang={l} href={href(l, here)} data-set-lang={l}>{languageNames[l].native}</a>}</li>
          ))}
        </ul>
      </div>
      <div class="concept on-dark">
        <Sub class="story__h">{t.about.conceptH}</Sub>
        <p>{t.about.conceptBody}</p>
        <a class="link-arrow" href={href(lang, 'work/')}>{t.about.conceptLink}</a>
      </div>
    </div>
  </div>
</section>
<style>
  .about__eyebrow { margin-bottom: var(--s5); }
  /* One joined mosaic: no gutters, flat shared edges; only the outer silhouette is curved (large top left and bottom right). */
  .mosaic { display: grid; gap: 0; grid-template-columns: minmax(0, 1fr); }
  .mosaic > * { min-width: 0; overflow-wrap: anywhere; hyphens: auto; }
  .story { background: var(--ink); color: var(--paper); padding: var(--pad); display: grid; gap: var(--s6); align-content: start; border-top-left-radius: var(--r-big); }
  .story .h-section { max-width: 14ch; }
  .story .h-section em { color: var(--coral-light); }
  .story__lead { font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem); line-height: 1.35; font-weight: 500; max-width: 38ch; }
  .story__h { font-size: 0.8125rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; margin-bottom: var(--s3); }
  .story .story__h { color: var(--coral-light); }
  .story__list { display: grid; gap: 2px; }
  .story__list a { display: flex; align-items: baseline; gap: 14px; min-height: 44px; padding-block: 8px; font-weight: 600; font-size: 1.125rem; text-decoration: none; border-bottom: 1px solid rgb(247 249 248 / 0.28); }
  .story__list a:hover { text-decoration: underline; text-underline-offset: 5px; text-decoration-color: var(--coral); }
  .story__n { color: var(--coral-light); font-weight: 800; font-size: 0.9375rem; letter-spacing: 0.08em; flex: none; }
  /* the picture never sets the height: it fills whatever the text panels leave (min-height keeps it a real composition) */
  .art { position: relative; background: var(--sand); min-height: 12rem; overflow: hidden; }
  .art svg { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .langs { background: var(--coral); color: var(--ink-deep); padding: var(--pad); display: grid; gap: var(--s3); align-content: start; }
  .langs .story__h { color: var(--ink-deep); font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem); letter-spacing: 0; text-transform: none; font-weight: 700; margin: 0; }
  .langs__list { display: flex; flex-wrap: wrap; gap: 8px; }
  .langs__list a, .langs__list span { display: inline-flex; align-items: center; min-height: 44px; padding: 4px 16px; border: 2px solid var(--ink-deep); border-radius: 999px; font-weight: 700; text-decoration: none; }
  .langs__list a:hover { background: var(--ink-deep); color: var(--coral); }
  .langs__list [aria-current] { background: var(--ink-deep); color: var(--coral); }
  .concept { background: var(--slate); color: var(--paper); padding: var(--pad); display: grid; gap: var(--s3); align-content: start; border-bottom-right-radius: var(--r-big); }
  .concept .story__h { color: var(--paper); font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem); letter-spacing: 0; text-transform: none; font-weight: 700; margin: 0; }
  .concept .link-arrow { color: var(--paper); white-space: normal; max-width: 100%; }
  @media (min-width: 48em) {
    .mosaic { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .story { grid-column: 1 / -1; border-top-right-radius: var(--r-small); }
    .art { min-height: 14rem; }
    .concept { grid-column: 1 / -1; }
  }
  @media (min-width: 64em) {
    .mosaic { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .story { grid-column: 1 / span 7; grid-row: 1 / span 3; border-top-right-radius: 0; padding: var(--s8) var(--s7) var(--s7); }
    .art { grid-column: 8 / -1; grid-row: 1; border-top-right-radius: var(--r-small); min-height: 16rem; }
    .langs { grid-column: 8 / -1; grid-row: 2; }
    .concept { grid-column: 8 / -1; grid-row: 3; }
  }
</style>
