---
import Art from './Art.astro';
import { href, languages, languageNames, type Lang } from '../i18n';
import { tr } from '../i18n/ui';
interface Props { num?: string; lang: Lang; page?: boolean }
const { num, lang, page = false } = Astro.props;
const t = tr(lang);
---
<section id="about" class="about section" aria-labelledby="about-h">
  <div class="wrap">
    <header class="about__head">
      <p class="eyebrow">{num ? `${num} — ` : ''}{t.nav.about}</p>
      {page ? <h1 id="about-h" class="h-section">{t.about.h2.a} <em>{t.about.h2.em}</em></h1> : <h2 id="about-h" class="h-section">{t.about.h2.a} <em>{t.about.h2.em}</em></h2>}
    </header>
    <div class="mosaic">
      <figure class="studio c-tl">
        <Art variant="studio" tone="sand" label={t.about.imageNote} />
        <figcaption>{t.about.imageNote}</figcaption>
      </figure>
      <div class="story on-dark c-br">
        <p class="story__lead">{t.about.story}</p>
        <div>
          <h3 class="story__h">{t.about.expect}</h3>
          <ul class="story__list">{t.about.expectItems.map((i) => <li>{i}</li>)}</ul>
        </div>
      </div>
      <div class="langs">
        <h3 class="story__h">{t.about.languagesH}</h3>
        <ul class="langs__list">{languages.map((l) => <li lang={l}>{languageNames[l].native}</li>)}</ul>
        <p>{t.about.languagesBody}</p>
      </div>
      <div class="remote on-coral c-tr">
        <h3 class="story__h">{t.about.remote}</h3>
        <p>{t.about.remoteBody}</p>
      </div>
    </div>
    <p class="about__pending">{t.about.teamPending}</p>
    {!page && <a class="link-arrow" href={href(lang, 'about/')}>{t.nav.about}</a>}
  </div>
</section>
<style>
  .about__head { display: grid; gap: var(--s4); margin-bottom: var(--s7); max-width: 60rem; }
  .mosaic { display: grid; gap: var(--gutter); grid-template-columns: 1fr; }
  .studio { position: relative; margin: 0; min-height: 16rem; overflow: hidden; border-radius: var(--r-small); }
  .studio :global(svg) { position: absolute; inset: 0; }
  .studio figcaption { position: absolute; left: 12px; bottom: 12px; background: var(--paper); color: var(--ink); font-size: 0.8125rem; font-weight: 600; padding: 3px 12px; border-radius: 999px; }
  .c-tl { border-top-left-radius: var(--r-big); } .c-br { border-bottom-right-radius: var(--r-big); } .c-tr { border-top-right-radius: var(--r-big); }
  .story { background: var(--ink); color: var(--paper); padding: var(--pad); border-radius: var(--r-small); display: grid; gap: var(--s6); align-content: space-between; }
  .story.c-br { border-bottom-right-radius: var(--r-big); }
  .story__lead { font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem); line-height: 1.35; font-weight: 500; max-width: 40ch; }
  .story__h { font-size: 0.8125rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; margin-bottom: var(--s3); }
  .story .story__h { color: var(--coral-light); }
  .story__list { display: grid; gap: 10px; }
  .story__list li { position: relative; padding-left: 26px; }
  .story__list li::before { content: ''; position: absolute; left: 0; top: 0.45em; width: 12px; height: 12px; background: var(--coral); border-radius: 0 6px 0 6px; }
  .langs { background: var(--sand); padding: var(--pad); border-radius: var(--r-small); display: grid; gap: var(--s3); align-content: start; }
  .langs .story__h { color: var(--rust-text); }
  .langs__list { display: flex; flex-wrap: wrap; gap: 8px; }
  .langs__list li { font-weight: 700; font-size: 1.25rem; padding: 4px 16px; border: 2px solid var(--ink); border-radius: 999px; }
  .remote { background: var(--coral); color: var(--ink-deep); padding: var(--pad); border-radius: var(--r-small); display: grid; gap: var(--s3); align-content: start; }
  .remote.c-tr { border-top-right-radius: var(--r-big); }
  .remote .story__h { color: var(--ink-deep); }
  .about__pending { margin-top: var(--s5); color: var(--slate-text); font-size: 1rem; max-width: 60ch; }
  .about .link-arrow { margin-top: var(--s3); }
  @media (min-width: 64em) {
    .mosaic { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: auto auto; }
    .studio { grid-column: 1 / span 4; grid-row: 1 / span 2; min-height: 26rem; }
    .story { grid-column: 5 / -1; grid-row: 1; }
    .langs { grid-column: 5 / span 4; grid-row: 2; }
    .remote { grid-column: 9 / -1; grid-row: 2; }
  }
</style>
