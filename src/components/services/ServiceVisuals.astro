---
import type { Lang } from '../../i18n';
import { tr } from '../../i18n/ui';
import type { Service } from '../../content/services';
interface Props { lang: Lang; s: Service }
const { lang } = Astro.props;
const v = tr(lang).services.visuals;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (f: string) => `${base}/servicios/video/${f}`;
const reels = ['antes', 'detras', 'hoy'];
const rot = ['-7deg', '0deg', '7deg'];
const photos = ['fachada', 'interior', 'producto', 'equipo'];
---
<section class="sv section" data-svc-visuals aria-labelledby="svc-vis-h">
  <div class="wrap sv__in">
    <header class="sv__head">
      <p class="sv__tag">{v.eyebrow}</p>
      <h2 id="svc-vis-h" class="h-section">{v.h2}</h2>
    </header>
    <ul class="sv__grid">
      {v.cells.map((c, i) => (
        <li class="sv__cell" data-svc-visual-cell>
          <div class="sv__panel" aria-hidden="true">
            <span class="sv__pill">{i === 1 ? v.product : v.example}</span>
            {i === 0 && (
              <div class="sv__fan">
                {reels.map((r, k) => (
                  <figure class="sv__reel" style={`--rot:${rot[k]}`}>
                    <img src={u(`reels-${r}-320.webp`)} srcset={`${u(`reels-${r}-320.webp`)} 320w, ${u(`reels-${r}-640.webp`)} 640w`} sizes="(min-width: 48em) 12vw, 28vw" width="320" height="569" loading="lazy" decoding="async" alt="" />
                    <figcaption class="sv__chip">{v.reels[k]}</figcaption>
                  </figure>
                ))}
              </div>
            )}
            {i === 1 && (
              <div class="sv__spot">
                <img src={u('spot-botella-480.webp')} srcset={`${u('spot-botella-480.webp')} 480w, ${u('spot-botella-900.webp')} 900w`} sizes="(min-width: 48em) 30vw, 80vw" width="480" height="600" loading="lazy" decoding="async" alt="" />
              </div>
            )}
            {i === 2 && (
              <div class="sv__photos">
                {photos.map((p, k) => (
                  <figure class="sv__photo">
                    <img src={u(`foto-${p}-320.webp`)} srcset={`${u(`foto-${p}-320.webp`)} 320w, ${u(`foto-${p}-640.webp`)} 640w`} sizes="(min-width: 48em) 14vw, 40vw" width="320" height="320" loading="lazy" decoding="async" alt="" />
                    <figcaption class="sv__chip sv__chip--up">{v.photos[k]}</figcaption>
                  </figure>
                ))}
              </div>
            )}
          </div>
          <span class="sv__n">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="sv__h3">{c.title}</h3>
          <p class="sv__p">{c.text}</p>
          <ul class="sv__list">
            {c.list.map((li) => <li>{li}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .sv { background: var(--sand); }
  .sv__in { display: grid; gap: var(--s7); }
  .sv__head { display: grid; gap: var(--s4); max-width: 60rem; }
  .sv__head > * { margin: 0; }
  .sv__tag { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-700); }
  .sv__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); border-top: 1px solid rgb(32 59 87 / 0.15); border-left: 1px solid rgb(32 59 87 / 0.15); }
  .sv__cell { display: grid; gap: var(--s3); align-content: start; min-width: 0; padding: var(--pad); border-right: 1px solid rgb(32 59 87 / 0.15); border-bottom: 1px solid rgb(32 59 87 / 0.15); }
  .sv__panel { position: relative; aspect-ratio: 4 / 5; min-width: 0; overflow: hidden; border-radius: 1rem; background-color: #203b57; background-image: radial-gradient(rgb(255 255 255 / 0.18) 1px, transparent 1.5px), linear-gradient(160deg, #2c4d6e, #15283b); background-size: 14px 14px, 100% 100%; margin-bottom: var(--s3); }
  .sv__pill, .sv__chip { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .sv__pill { position: absolute; top: 0.75rem; left: 0.75rem; z-index: 3; padding: 0.25rem 0.625rem; border-radius: 999px; background: #fff; color: #203b57; }
  .sv__chip { position: absolute; left: 0.375rem; bottom: 0.375rem; padding: 0.125rem 0.375rem; border-radius: 999px; background: #fff; color: #203b57; max-width: calc(100% - 0.75rem); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sv img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .sv__fan { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; padding: 3rem 0.5rem 1rem; gap: 0; }
  .sv__reel { position: relative; flex: 0 1 36%; min-width: 0; aspect-ratio: 9 / 16; margin: 0 -2%; overflow: hidden; border-radius: 14px; box-shadow: 0 10px 24px rgb(0 0 0 / 0.35); transform: rotate(var(--rot)); }
  .sv__reel:nth-child(2) { z-index: 2; }
  .sv__spot { position: absolute; inset: 0; }
  .sv__photos { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 0.5rem; padding: 3rem 0.5rem 0.5rem; }
  .sv__photo { position: relative; min-width: 0; min-height: 0; margin: 0; overflow: hidden; border-radius: 10px; }
  .sv__n { font-family: var(--font-mono); font-size: 0.8125rem; letter-spacing: 0.08em; color: var(--rust-text); }
  .sv__h3 { margin: 0; font-size: 1.25rem; line-height: 1.25; overflow-wrap: anywhere; }
  .sv__p { margin: 0; overflow-wrap: anywhere; }
  .sv__list { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.25rem; font-size: 0.9375rem; color: var(--ink-700); }
  @media (min-width: 48em) { .sv__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (prefers-reduced-motion: reduce) { .sv__reel { transform: none; } }
</style>
