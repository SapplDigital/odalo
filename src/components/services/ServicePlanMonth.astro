---
import { href, type Lang } from '../../i18n';
import { tr } from '../../i18n/ui';
import { planById } from '../../content/plans';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = tr(lang).planMonth;
const plan = planById('captacion')!.name;
const cap = t.mes.replace('{plan}', plan);
const days = Array.from({ length: 28 }, (_, i) => i + 1);
const reels = [10, 24];
---
<section class="spm section" data-svc-plan-month aria-labelledby="svc-plan-month-h">
  <div class="wrap spm__in">
    <header class="spm__head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="svc-plan-month-h" class="h-section">{t.h2.a} <em>{t.h2.em}</em></h2>
      <p class="spm__text">{t.texto.replace('{plan}', plan)}</p>
      <p><a class="btn btn--ghost" href={href(lang, 'plans/')} data-svc-plan-month-link>{t.ver}</a></p>
    </header>
    <figure class="spm__fig">
      <figcaption class="spm__cap">{cap}</figcaption>
      <div class="spm__grid" aria-hidden="true">
        {t.dias.map((d) => <span class="spm__dow" data-pm-dow>{d}</span>)}
        {days.map((d) => (
          <span class="spm__day" data-pm-day={d}>
            <span class="spm__n">{d}</span>
            {reels.includes(d) && <span class="spm__reel" data-pm-reel>{t.reel}</span>}
          </span>
        ))}
      </div>
      <p class="sr-only">{cap}: {reels.length} × {t.reel}</p>
    </figure>
  </div>
</section>
<style>
  .spm { background: var(--paper); border-top: 1px solid var(--ink-200); }
  .spm__in { display: grid; gap: var(--s6); }
  .spm__head { display: grid; gap: var(--s4); justify-items: start; max-width: 60rem; }
  .spm__head > * { margin: 0; }
  .spm__text { max-width: 52ch; color: var(--ink-700); }
  .spm__fig { margin: 0; display: grid; gap: var(--s3); min-width: 0; max-width: 40rem; }
  .spm__cap { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-700); }
  .spm__grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; min-width: 0; }
  .spm__dow { text-align: center; font-family: var(--font-mono); font-size: 0.6875rem; color: var(--ink-700); }
  .spm__day {
    position: relative; display: flex; flex-direction: column; justify-content: space-between; gap: 2px;
    min-width: 0; aspect-ratio: 1 / 1; padding: 3px; box-sizing: border-box; overflow: hidden;
    border: 1px solid var(--ink-200); border-radius: 0.375rem; background: #fff;
  }
  .spm__n { font-size: 0.6875rem; color: var(--ink-700); line-height: 1; }
  .spm__reel {
    align-self: flex-start; max-width: 100%; padding: 1px 3px; border-radius: 3px;
    background: var(--ink); color: #fff; font-size: 0.5625rem; line-height: 1.2; overflow: hidden;
  }
  @media (min-width: 48em) {
    .spm__day { padding: 6px; }
    .spm__n { font-size: 0.8125rem; }
    .spm__reel { font-size: 0.6875rem; padding: 2px 6px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .spm__day { animation: spm-in 0.5s ease both; }
    @keyframes spm-in { from { opacity: 0; } to { opacity: 1; } }
  }
</style>
