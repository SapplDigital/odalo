---
/**
 * Odalo logo. The symbol is the single source file public/brand/odalo-symbol.svg (inlined here so
 * the page and the downloadable asset cannot drift). Wordmark is live Outfit text with the coral dot.
 */
import symbolSvg from '../../public/brand/odalo-symbol.svg?raw';
interface Props { variant?: 'light' | 'dark'; symbolOnly?: boolean; size?: number }
const { variant = 'light', symbolOnly = false, size = 40 } = Astro.props;
const inner = symbolSvg.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').replace(/<!--[\s\S]*?-->/g, '');
---
<span class:list={['logo', { 'logo--dark': variant === 'dark' }]} style={`--logo-size:${size}px`}>
  <svg class="logo__mark" viewBox="0 0 60 60" aria-hidden="true" focusable="false" set:html={inner} />
  {!symbolOnly && <span class="logo__word" aria-hidden="true">odalo<span class="logo__dot">.</span></span>}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: calc(var(--logo-size) * 0.28); color: var(--ink); line-height: 1; }
  :global(a:has(> .logo)) { text-decoration: none; }
  .logo--dark { color: var(--paper); }
  .logo--dark .logo__mark { --odalo-navy: #0d1a2b; }
  .logo__mark { width: var(--logo-size); height: var(--logo-size); flex: none; }
  .logo__word { font-family: var(--font-sans); font-weight: 700; font-size: calc(var(--logo-size) * 0.95); letter-spacing: -0.045em; }
  .logo__dot { color: var(--coral); }
</style>
