---
// Ale's "piedras" (odalo-web @ f137d06) as a static, decorative inline SVG. Place inside a positioned parent.
import { MOSAICO, COLORES_PIEDRA, PIEDRAS } from '../mosaic/stones';
interface Props { class?: string; from?: number; to?: number; reveal?: boolean }
const { class: cls, from = 0, to = 1, reveal = false } = Astro.props;
const y0 = MOSAICO.arriba + from * MOSAICO.alto;
const y1 = MOSAICO.arriba + to * MOSAICO.alto;
const items = PIEDRAS.filter((p) => p.y >= y0 && p.y <= y1);
const vbY = y0;
const vbH = Math.max(1, y1 - y0);
---
<svg
  class:list={['stones', reveal && 'stones--reveal', cls]}
  viewBox={`0 ${vbY} ${MOSAICO.ancho} ${vbH}`}
  preserveAspectRatio="xMaxYMid slice"
  aria-hidden="true"
  focusable="false"
>
  {items.map((p) => <path d={p.d} fill={COLORES_PIEDRA[p.c]} />)}
</svg>
<style>
  .stones { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; display: block; }
  @media (prefers-reduced-motion: no-preference) {
    .stones--reveal { animation: stones-in 0.9s ease-out both; }
    @keyframes stones-in { from { opacity: 0; } to { opacity: 1; } }
  }
</style>
