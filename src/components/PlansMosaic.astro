---
import { plans, planById, quoteLabel } from '../content/plans';
import { href, priceParts, type Lang } from '../i18n';
import { tr } from '../i18n/ui';
interface Props { lang: Lang; detailed?: boolean; noteId?: string }
const { lang, detailed = false, noteId = 'plans-note' } = Astro.props;
const t = tr(lang);
const summaries = t.plans.summaries as Record<string, string>;
---
<div class="plans">
  {plans.map((p) => {
    const parent = p.builtOn ? planById(p.builtOn)! : null;
    return (
      <article id={`plan-${p.id}`} class:list={['plan', `plan--${p.id}`, { 'plan--feat on-dark': p.featured }]} aria-labelledby={`plan-${p.id}-h`} aria-describedby={noteId}>
        <header class="plan__head">
          <h3 id={`plan-${p.id}-h`} class="plan__name">{p.name}</h3>
          {p.featured && <span class="pill">{t.common.featured}</span>}
        </header>
        {p.monthly === null
          ? <p class="plan__price"><span class="plan__amount plan__amount--quote">{quoteLabel[lang]}</span></p>
          : <p class="plan__price"><span class="plan__amount">{(() => { const q = priceParts(p.monthly, lang); return (<>{q.lead && <span>{q.lead}</span>}<span>{q.num}</span>{q.trail && <span>{q.trail}</span>}</>); })()}</span><span class="plan__per">{t.common.perMonth}</span></p>}
        <p class="plan__sum">{summaries[p.id]}</p>
        <div class="plan__inc">
          {parent && <p class="plan__built">{t.plans.builtOn.replace('{plan}', parent.name)}</p>}
          <ul class="plan__list">{p.own[lang].map((i) => <li>{i}</li>)}</ul>
          {detailed && (
            <div class="plan__not">
              <p class="plan__built">{t.plans.exclusions}</p>
              <ul class="plan__list plan__list--no">{p.notIncluded[lang].map((i) => <li>{i}</li>)}</ul>
            </div>
          )}
        </div>
        <a class:list={['btn', p.featured ? 'btn--coral' : 'btn--ink', 'plan__cta']} href={`${href(lang, 'audit/')}?plan=${p.id}`} data-track="plan_select" data-plan={p.id}>
          {t.plans.ctaPlan.replace('{plan}', p.name)}
        </a>
      </article>
    );
  })}
</div>
<style>
  /* One connected surface: no gutters, square internal corners, curves only on the group's outer silhouette.
     Light neighbours are told apart by three tones derived from the palette; Captación stays navy. No hover behaviour. */
  .plans {
    --r-plan: clamp(40px, 6vw, 96px);
    --tone-warm: color-mix(in srgb, var(--paper) 45%, var(--sand));
    --tone-cool: color-mix(in srgb, var(--paper) 86%, var(--slate));
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 0;
    border-radius: var(--r-plan) var(--r-small) var(--r-plan) var(--r-small); overflow: hidden;
  }
  .plan { --p: clamp(24px, 2.4vw, 40px); background: var(--paper); color: var(--ink); padding: var(--p); display: flex; flex-direction: column; gap: var(--s3); min-width: 0; overflow-wrap: break-word; hyphens: auto; scroll-margin-top: calc(var(--header-h) + 16px); }
  .plan--local { background: var(--tone-warm); }
  .plan--360 { background: var(--tone-cool); }
  .plan--feat { background: var(--ink); color: var(--paper); }
  .plan__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s2) var(--s3); min-height: 40px; }
  .plan__name { font-size: var(--fs-h3); font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; min-width: 0; }
  .plan__head .pill { flex: 0 1 auto; max-width: 100%; white-space: normal; text-align: center; }
  .plan__price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 6px; line-height: 1; }
  .plan__amount { display: inline-flex; flex-wrap: wrap; align-items: baseline; max-width: 100%; font-size: clamp(2.75rem, 2rem + 2.4vw, 4rem); font-weight: 800; letter-spacing: -0.04em; }
  .plan__amount--quote { font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem); letter-spacing: -0.03em; line-height: 1.1; }
  .plan__per { font-size: 1.125rem; font-weight: 500; color: var(--slate-text); }
  .plan--feat .plan__per { color: var(--coral-light); }
  .plan__sum { max-width: 36ch; }
  .plan__inc, .plan__not { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s3); margin-block: var(--s2) var(--s4); }
  .plan__built { font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--slate-text); }
  .plan--feat .plan__built { color: var(--sand); }
  .plan__list { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; font-size: 1.0625rem; }
  .plan__list li, .plan__built { overflow-wrap: anywhere; }
  .plan__list li { position: relative; padding-left: 26px; line-height: 1.4; }
  .plan__list li::before { content: ''; position: absolute; left: 0; top: 0.4em; width: 12px; height: 12px; background: var(--coral); border-radius: 0 6px 0 6px; }
  .plan__list--no li::before { background: none; border-radius: 0; height: 2px; top: 0.7em; background: var(--slate); width: 12px; }
  .plan--feat .plan__list--no li::before { background: var(--sand); }
  .plan__cta { margin-top: auto; align-self: flex-start; }
  .plan--feat .plan__cta { font-size: 1.125rem; }

  /* Tablet: balanced 2 x 2 (Base | Local over Captación | 360). */
  @media (min-width: 48em) {
    .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  /* Desktop: 3 / 4 / 5 over a full-width 360. */
  @media (min-width: 72em) {
    .plans { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .plan--base { grid-column: span 3; } .plan--local { grid-column: span 4; } .plan--captacion { grid-column: span 5; }
    .plan--360 { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--s8); align-content: start; }
    .plan--360 .plan__head, .plan--360 .plan__price, .plan--360 .plan__sum { grid-column: 1; }
    .plan--360 .plan__inc { grid-column: 2; grid-row: 1 / span 4; margin: 0; align-content: center; }
    .plan--360 .plan__list { grid-template-columns: 1fr 1fr; gap: 10px 24px; }
    .plan--360 .plan__cta { grid-column: 1; margin-top: var(--s3); justify-self: start; }
  }
</style>
