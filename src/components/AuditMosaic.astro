---
/**
 * Free-audit mosaic (FA3): the connected intro + four review-focus pieces. Informational pieces only; the ONE authoritative value is the
 * form's <select id="f-service"> (rendered by AuditForm). This component never parses the URL: AuditForm already applies ?service= / ?plan=,
 * and the script below mirrors whatever the select holds (initial paint, user changes, Include/remove, reset, back/forward restore).
 *
 * Piece ids are the production service ids (web, local, video, ads). "Content" is the audit label for the `video` service preference.
 * Without JavaScript every explanation is plain readable text in normal flow and the form's own select is the only control.
 */
import { type Lang } from '../i18n';
import { tr } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const a = tr(lang).audit;
const m = a.mosaic;
const ids = ['web', 'local', 'video', 'ads'] as const;
const i18n = JSON.stringify({
  explore: m.explore, include: m.include, remove: m.remove, none: m.none, planNone: m.planNone,
  announceIn: m.announceIn, announceOut: m.announceOut, announceOpen: m.announceOpen,
  names: Object.fromEntries(ids.map((id) => [id, m.pieces[id].n])),
});
---
<section class="am" aria-labelledby="am-h1" data-am data-am-i18n={i18n}>
  <div class="am-intro">
    <h1 id="am-h1">{a.h1.a} <em>{a.h1.em}</em></h1>
    <p class="am-intro__lead">{a.lead}</p>
    <p class="am-intro__scope">{a.scope}</p>
    <a class="am-btn am-btn--cta" href="#request">{a.cta}</a>
    <p class="am-intro__hint">{a.hint}</p>
  </div>
  <div class="am-pieces" data-am-pieces role="group" aria-label={m.boardLabel}>
    {ids.map((id, i) => (
      <article class={`am-tile am-tile--${id}`} data-piece={id} data-i={i}>
        <h2 class="am-tile__title" id={`am-t-${id}`}>{m.pieces[id].n}</h2>
        <p class="am-tile__short">{m.pieces[id].s}</p>
        <div class="am-tile__panel" id={`am-p-${id}`} role="group" aria-labelledby={`am-t-${id}`}>
          <p class="am-tile__badge" data-badge hidden><span aria-hidden="true">✓</span> {m.included}</p>
          <p class="am-tile__long">{m.pieces[id].l}</p>
          <p class="am-tile__tip"><strong>{m.tipLabel}:</strong> {m.pieces[id].t}</p>
          <div class="am-tile__acts" data-js-only hidden>
            <button type="button" class="am-btn" data-include>{m.include}</button>
            <button type="button" class="am-btn am-btn--ghost" data-close>{m.close}</button>
          </div>
        </div>
        <span class="am-tile__deco" aria-hidden="true"><span class="am-tile__grow"></span></span>
      </article>
    ))}
  </div>
</section>

<style is:global>
  /* Audit semantic aliases (all resolve to the existing brand tokens in global.css). */
  .am, .am-req { --au-muted: var(--slate-text); --au-dur: 240ms; --au-ease: cubic-bezier(0.2, 0.7, 0.2, 1); --au-board-min: 38rem; }
  .am-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 10px 22px; border: 2px solid var(--btn-bg, var(--tile-fg)); border-radius: var(--r-small); background: var(--btn-bg, var(--tile-fg)); color: var(--btn-fg, var(--tile-bg)); font: 600 1.0625rem/1.2 var(--font-sans); text-align: center; text-decoration: none; cursor: pointer; max-width: 100%; transition: background-color 150ms, color 150ms; }
  .am-btn--ghost { background: transparent; color: var(--btn-bg, var(--tile-fg)); }
  .am-btn:hover { background: var(--btn-fg, var(--tile-bg)); color: var(--btn-bg, var(--tile-fg)); }
  .am-btn--ghost:hover { background: var(--btn-bg, var(--tile-fg)); color: var(--btn-fg, var(--tile-bg)); }
  .am-btn[hidden] { display: none; }

  /* one connected mosaic: tiles share edges (no gaps); only the OUTER silhouette is curved */
  .am { display: grid; margin-top: var(--s5); }
  .am-intro { --tile-bg: var(--ink); --tile-fg: var(--paper); --focus: var(--coral-light); --btn-bg: var(--coral); --btn-fg: var(--ink-deep);
    background: var(--tile-bg); color: var(--tile-fg); min-width: 0; padding: calc(var(--pad) + var(--s4)) var(--pad) var(--pad); border-top-left-radius: var(--r-big); display: grid; gap: var(--s4); align-content: start; }
  .am-intro h1 { font-size: clamp(2.5rem, 1rem + 2.6vw, 4.75rem); line-height: 1; font-weight: 300; letter-spacing: -0.03em; hyphens: auto; overflow-wrap: anywhere; }
  .am-intro h1 em { font-family: var(--font-serif); font-weight: 400; letter-spacing: -0.01em; color: var(--coral-light); }
  .am-intro__lead { font-size: 1.1875rem; max-width: 34ch; }
  .am-intro__scope { font-size: 1.0625rem; max-width: 40ch; font-weight: 600; }
  .am-intro__hint { font-size: 1rem; max-width: 40ch; color: var(--sand); }
  .am-btn--cta { justify-self: start; --btn-bg: var(--coral); --btn-fg: var(--ink-deep); }
  .am-intro .am-btn--cta:hover { background: var(--ink); color: var(--coral-light); border-color: var(--coral-light); }

  .am-pieces { display: grid; grid-template-columns: minmax(0, 1fr); }
  .am-tile { position: relative; isolation: isolate; display: grid; grid-template-rows: auto auto 1fr; align-content: stretch; gap: var(--s3); padding: var(--pad); background: var(--tile-bg); color: var(--tile-fg); --focus: var(--tile-fg); min-width: 0; }
  .am-tile--web { --tile-bg: var(--sand); --tile-fg: var(--ink); --tile-grow: var(--coral-light); }
  .am-tile--local { --tile-bg: var(--coral); --tile-fg: var(--ink-deep); --tile-grow: var(--sand); }
  .am-tile--video { --tile-bg: var(--slate); --tile-fg: var(--paper); --tile-grow: var(--ink-deep); } /* not --ink: it would merge with the Advertising tile beside it */
  .am-tile--ads { --tile-bg: var(--ink); --tile-fg: var(--paper); --tile-grow: var(--slate); --focus: var(--coral-light); border-bottom-right-radius: var(--r-big); }
  .am-tile__title { font-size: var(--fs-h3); line-height: 1.1; font-weight: 700; letter-spacing: -0.02em; }
  .am-tile__short, .am-tile__long { font-size: 1.0625rem; max-width: 46ch; }
  .am-tile__tip { font-size: 0.9375rem; max-width: 46ch; }
  .am-tile__panel { display: grid; gap: var(--s3); }
  .am-tile__badge { font-weight: 700; display: inline-flex; gap: 8px; align-items: center; justify-self: start; border: 2px solid currentColor; border-radius: var(--r-small); padding: 2px 10px; font-size: 0.9375rem; }
  .am-tile__badge[hidden], .am-tile__acts[hidden] { display: none; }
  .am-tile__acts { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s2); }
  .am-tile__cue { align-self: end; font-weight: 600; font-size: 1rem; padding-top: var(--s3); }
  .am-tile__cue::after { content: ' +'; }

  /* upgraded trigger: a real button inside the heading; its ::after is a stable full-tile hit area while the tile is closed */
  .am-tile__trigger { all: unset; box-sizing: border-box; cursor: pointer; display: inline-block; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent; }
  .am-tile__trigger:focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; border-radius: 2px; }
  .am-tile__trigger::after { content: ''; position: absolute; inset: 0; }
  .am-tile__trigger[aria-expanded='true']::after { display: none; }
  .am-tile__trigger[aria-expanded='true'] { cursor: default; }
  .am-tile[data-open='true'] .am-tile__short, .am-tile[data-open='true'] .am-tile__cue { display: none; }
  .am-tile[data-open='false'] .am-tile__panel { display: none; }
  .am-tile[data-open='true'] .am-tile__panel { animation: am-in var(--au-dur) var(--au-ease) both; }
  .am-tile__acts, .am-tile__badge { position: relative; z-index: 1; }
  @keyframes am-in { from { opacity: 0; } to { opacity: 1; } }

  /* decorative layer behind the text, clipped to the tile's outer curve. The grow triangle scales on hover (transform only: nothing moves). */
  .am-tile__deco { position: absolute; inset: 0; z-index: -1; overflow: hidden; border-radius: inherit; pointer-events: none; }
  .am-tile__grow { position: absolute; inset: 0; background: var(--tile-grow); clip-path: polygon(100% 0, 100% 100%, 0 100%); transform: scale(0.3); transform-origin: 100% 100%; transition: transform var(--au-dur) var(--au-ease); }
  .am-tile[data-open='true'] .am-tile__grow { transform: scale(0); }
  /* selected: a short inset accent bar beside the text plus the textual badge; tile edges and joins stay untouched */
  .am-tile__deco::after { content: ''; position: absolute; left: calc(var(--pad) / 2 - 2px); top: var(--pad); bottom: var(--pad); width: 4px; background: var(--tile-fg); opacity: 0; transition: opacity 150ms; }
  .am-tile[data-selected='true'] .am-tile__deco::after { opacity: 1; }
  @media (hover: hover) and (pointer: fine) { .am-tile[data-open='false']:hover .am-tile__grow { transform: scale(0.72); } }

  /* phone: a compact 2x2 overview (names + cue, whole tile is the 44px+ target); the OPENED piece takes the full width for its detail.
     Only after the script has upgraded the tiles ([data-am-ready]); without it (JS off / runtime blocked) the readable full-width stack above stays.
     em-based lower bound: at 320px or with enlarged text the viewport is < 24em and the single full-width column is kept (no cramped half tiles).
     DOM order is preserved (no dense flow): a tile left alone in its row spans the full width instead of leaving a gap. */
  @media (min-width: 24em) and (max-width: 47.99em) {
    .am[data-am-ready] .am-pieces { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .am[data-am-ready] .am-pieces[data-open='0'] .am-tile[data-i='3'],
    .am[data-am-ready] .am-pieces[data-open='1'] .am-tile[data-i='0'],
    .am[data-am-ready] .am-pieces[data-open='2'] .am-tile[data-i='3'],
    .am[data-am-ready] .am-pieces[data-open='3'] .am-tile[data-i='2'] { grid-column: 1 / -1; }
    .am[data-am-ready] .am-tile { padding: var(--s4); gap: var(--s2); min-height: 88px; }
    .am[data-am-ready] .am-tile__title { font-size: 1.25rem; line-height: 1.12; hyphens: manual; overflow-wrap: anywhere; }
    /* translated teasers do not fit a half-width tile at readable size (DE broke mid-word), so on the phone the overview shows name + cue; the teaser stays for screen readers and the opened detail has the full text */
    .am[data-am-ready] .am-tile[data-open='false'] .am-tile__short { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .am[data-am-ready] .am-tile { align-content: space-between; }
    .am[data-am-ready] .am-tile__cue { padding-top: var(--s1); }
    .am[data-am-ready] .am-tile__trigger { max-width: 100%; overflow-wrap: anywhere; } /* break only when a word cannot fit, also at enlarged text */
    .am[data-am-ready] .am-tile[data-open='true'] { grid-column: 1 / -1; padding: var(--pad); }
    .am[data-am-ready] .am-tile[data-open='true'] .am-tile__title { font-size: var(--fs-h3); }
    .am[data-am-ready] .am-tile__deco::after { left: 6px; top: var(--s4); bottom: var(--s4); }
    .am[data-am-ready] .am-tile--web { border-top-left-radius: 0; }
    .am[data-am-ready] .am-tile--ads { border-bottom-right-radius: 0; }
  }

  /* layouts: phone stacked; 48em 2x2 flow; 64em intro beside the pieces; wide+tall: reserved board whose tracks settle on open */
  @media (min-width: 48em) { .am-pieces { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64em) { .am { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); } }
  @media (min-width: 75em) and (min-height: 46em) {
    .js .am { min-height: var(--au-board-min); }
    .js .am-pieces { --c1: 1fr; --c2: 1fr; --r1: 1fr; --r2: 1fr; grid-template-columns: var(--c1) var(--c2); grid-template-rows: var(--r1) var(--r2); transition: grid-template-columns var(--au-dur) var(--au-ease), grid-template-rows var(--au-dur) var(--au-ease); }
    .js .am-pieces[data-open='0'] { --c1: 1.3fr; --c2: 0.7fr; --r1: 1.3fr; --r2: 0.7fr; }
    .js .am-pieces[data-open='1'] { --c1: 0.7fr; --c2: 1.3fr; --r1: 1.3fr; --r2: 0.7fr; }
    .js .am-pieces[data-open='2'] { --c1: 1.3fr; --c2: 0.7fr; --r1: 0.7fr; --r2: 1.3fr; }
    .js .am-pieces[data-open='3'] { --c1: 0.7fr; --c2: 1.3fr; --r1: 0.7fr; --r2: 1.3fr; }
    /* neighbours of an open piece keep title + cue and drop the teaser, so their height need cannot exceed the reserved row */
    .js .am-pieces[data-open] .am-tile[data-open='false'] .am-tile__short { display: none; }
    .js .am-intro { border-bottom-left-radius: var(--r-small); }
  }

  /* one brief entrance (paint-only clip reveal). Content is in the DOM and focusable throughout; the script ends it the moment focus enters. */
  .am--assemble .am-intro, .am--assemble .am-tile { animation: am-assemble 560ms var(--au-ease) backwards; }
  .am--assemble .am-tile[data-i='0'] { animation-delay: 60ms; } .am--assemble .am-tile[data-i='1'] { animation-delay: 140ms; }
  .am--assemble .am-tile[data-i='2'] { animation-delay: 200ms; } .am--assemble .am-tile[data-i='3'] { animation-delay: 260ms; }
  @keyframes am-assemble { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0); } }
  @media (prefers-reduced-motion: reduce) { .am *, .am *::before, .am *::after { animation: none !important; transition: none !important; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-am]');
  const svc = document.querySelector<HTMLSelectElement>('#f-service'); // the single authoritative value
  const plan = document.querySelector<HTMLSelectElement>('#f-plan');
  if (root && svc) {
    const T = JSON.parse(root.dataset.amI18n || '{}') as Record<string, any>;
    const form = svc.form;
    const pieces = root.querySelector<HTMLElement>('[data-am-pieces]')!;
    const tiles = [...root.querySelectorAll<HTMLElement>('[data-piece]')];
    const live = document.querySelector<HTMLElement>('[data-am-live]');
    const clearBtn = document.querySelector<HTMLButtonElement>('[data-am-clear]');
    const sumFocus = document.querySelector<HTMLElement>('[data-am-focus]');
    const sumPlan = document.querySelector<HTMLElement>('[data-am-plan]');
    const sumBox = document.querySelector<HTMLElement>('[data-am-summary]');
    const announce = (msg: string) => { if (live) { live.textContent = ''; live.textContent = msg; } };
    let open = -1;

    // Upgrade each tile: the heading text becomes a real button; JS-only controls appear.
    tiles.forEach((tile, i) => {
      const id = tile.dataset.piece!;
      const h = tile.querySelector<HTMLElement>('.am-tile__title')!;
      const btn = document.createElement('button');
      btn.type = 'button'; btn.className = 'am-tile__trigger'; btn.id = `am-b-${id}`;
      btn.setAttribute('aria-expanded', 'false'); btn.setAttribute('aria-controls', `am-p-${id}`);
      btn.textContent = h.textContent; h.replaceChildren(btn);
      const cue = document.createElement('span');
      cue.className = 'am-tile__cue'; cue.setAttribute('aria-hidden', 'true'); cue.textContent = T.explore;
      tile.querySelector('.am-tile__short')!.after(cue);
      tile.querySelector<HTMLElement>('[data-js-only]')!.hidden = false;
      tile.dataset.open = 'false';
      btn.addEventListener('click', () => setOpen(open === i ? -1 : i));
      tile.querySelector('[data-include]')!.addEventListener('click', () => {
        svc.value = svc.value === id ? '' : id;
        svc.dispatchEvent(new Event('change', { bubbles: true })); // explicit boundary: listeners (this file, AuditForm's live re-validation) see a normal change
      });
      tile.querySelector('[data-close]')!.addEventListener('click', () => { setOpen(-1); btn.focus(); });
      // Escape closes while focus is inside this tile; focus returns to the trigger if it was inside the hidden panel.
      tile.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || open !== i) return;
        const inPanel = tile.querySelector('.am-tile__panel')!.contains(document.activeElement);
        setOpen(-1);
        if (inPanel) btn.focus();
      });
    });

    root.setAttribute('data-am-ready', ''); // tiles upgraded: CSS may now apply the compact phone grid

    function setOpen(i: number) {
      open = i;
      if (i < 0) pieces.removeAttribute('data-open'); else pieces.dataset.open = String(i);
      tiles.forEach((tile, k) => {
        tile.dataset.open = String(k === i);
        tile.querySelector('.am-tile__trigger')!.setAttribute('aria-expanded', String(k === i));
      });
      if (i >= 0) announce(T.announceOpen + T.names[tiles[i]!.dataset.piece!]);
    }

    // Mirror the form into the mosaic + summary. Idempotent; reads only the selects.
    function render(announceIt = false) {
      const id = svc!.value;
      tiles.forEach((tile) => {
        const on = tile.dataset.piece === id;
        tile.dataset.selected = String(on);
        tile.querySelector<HTMLElement>('[data-badge]')!.hidden = !on;
        tile.querySelector('[data-include]')!.textContent = on ? T.remove : T.include;
      });
      if (sumBox) sumBox.hidden = false;
      if (sumFocus) sumFocus.textContent = id ? T.names[id] : T.none;
      if (sumPlan) sumPlan.textContent = plan && plan.value ? (plan.selectedOptions[0]?.dataset.name ?? plan.value) : T.planNone;
      if (clearBtn) { clearBtn.hidden = false; clearBtn.setAttribute('aria-pressed', String(!id)); }
      if (announceIt) announce(id ? T.announceIn + T.names[id] : T.announceOut);
    }
    let lastFocus = svc.value;
    svc.addEventListener('change', () => { render(svc.value !== lastFocus); lastFocus = svc.value; });
    plan?.addEventListener('change', () => render());
    clearBtn?.addEventListener('click', () => { if (svc.value) { svc.value = ''; svc.dispatchEvent(new Event('change', { bubbles: true })); } });
    // form.reset() (after a delivered request) changes values without a change event; pageshow/DOMContentLoaded cover first paint and back/forward restore.
    form?.addEventListener('reset', () => setTimeout(() => render(), 0));
    document.addEventListener('DOMContentLoaded', () => { render(); lastFocus = svc.value; }); // after AuditForm's script applied ?service= / ?plan=
    addEventListener('pageshow', () => { render(); lastFocus = svc.value; });
    if (document.readyState === 'complete') render();

    // entrance: once, brief, skipped under reduced motion; ended the instant focus enters so a focused control is never clipped
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('am--assemble');
      const end = () => root.classList.remove('am--assemble');
      root.addEventListener('focusin', end, { once: true });
      document.addEventListener('keydown', end, { once: true });
      setTimeout(end, 900);
    }
  }
</script>
