---
import { href, type Lang } from '../../i18n';
import { tr } from '../../i18n/ui';
import { services } from '../../content/services';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = tr(lang);
const sv = t.services;
const bar = (w: number, c = '') => `<i class="ph__bar ${c}" style="width:${w}%"></i>`;
const demoHtml: Record<string, string> = {
  web: `<div class="ph__nav">${bar(30, 'ph__ink')}<i class="ph__dot"></i></div><div class="ph__hero"><i class="ph__bar ph__lg" style="width:80%"></i>${bar(55)}<i class="ph__btn"></i></div><div class="ph__cards"><i></i><i></i></div>`,
  local: `<div class="ph__pin"></div>${bar(60, 'ph__ink')}<div class="ph__stars"><i></i><i></i><i></i><i></i><i></i></div>${bar(85)}${bar(70)}<div class="ph__row"><i class="ph__chip"></i><i class="ph__chip"></i></div>`,
  video: `<div class="ph__reel"><i class="ph__play"></i></div>${bar(50, 'ph__ink')}${bar(80)}<div class="ph__prog"><i></i></div>`,
  ads: `${bar(40, 'ph__ink')}<div class="ph__chart"><i style="height:30%"></i><i style="height:48%"></i><i style="height:40%"></i><i style="height:72%"></i><i style="height:92%"></i></div>${bar(65)}<div class="ph__row"><i class="ph__chip"></i><i class="ph__chip"></i></div>`,
};
const phone = (id: string) => `<div class="ph" aria-hidden="true"><div class="ph__notch"></div><div class="ph__screen">${demoHtml[id]}</div></div>`;
---
<section class="sv" id="services" data-home-services data-active={services[0].id} aria-labelledby="sv-h">
  <div class="wrap">
    <div class="sv__grid">
      <div class="sv__main">
        <p class="sv__eyebrow"><span aria-hidden="true">01</span> {sv.homeEyebrow}</p>
        <h2 id="sv-h" class="h-section">{sv.homeH2.a} <em>{sv.homeH2.em}</em> {sv.homeH2.b}<span class="sv__muted">{sv.homeMuted}</span></h2>
        <p class="lead sv__intro">{sv.homeIntro}</p>
        <div class="sv__acc" data-sv-acc>
          {services.map((s, i) => (
            <div class="sv__item">
              <h3 class="sv__h">
                <button type="button" class="sv__btn" id={`sv-btn-${s.id}`} aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`sv-panel-${s.id}`} data-sv-btn>
                  <span class="sv__num" aria-hidden="true">{s.number}</span>
                  <span class="sv__name">{s.name[lang]}</span>
                  <span class="sv__plus" aria-hidden="true"></span>
                </button>
              </h3>
              <div class="sv__panel" id={`sv-panel-${s.id}`} role="region" aria-labelledby={`sv-btn-${s.id}`} data-sv-panel>
                <p class="sv__out">{s.outcome[lang]}</p>
                <p class="sv__detail">{s.detail[lang]}</p>
                <p class="sv__inc">{sv.includes}</p>
                <ul class="sv__list">
                  {s.deliverables[lang].map((d) => <li>{d}</li>)}
                </ul>
                <a class="sv__link" href={href(lang, `services/${s.id}/`)} data-service-link={s.id}>{sv.moreAbout.replace('{name}', s.name[lang])} <span aria-hidden="true">→</span></a>
                <div class="sv__pp">
                  <div set:html={phone(s.id)} />
                  <p class="sv__cap">{sv.demoLabel}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="sv__side" aria-hidden="true">
        <div class="sv__sticky">
          {services.map((s) => <div class="sv__demo" data-demo={s.id} set:html={phone(s.id)} />)}
          <p class="sv__cap">{sv.demoLabel}</p>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-sv-acc]').forEach((acc) => {
    const btns = Array.from(acc.querySelectorAll<HTMLButtonElement>('[data-sv-btn]'));
    const panelOf = (b: HTMLButtonElement) => document.getElementById(b.getAttribute('aria-controls') || '');
    const open = (target: HTMLButtonElement | null) => {
      btns.forEach((b) => {
        const on = b === target;
        b.setAttribute('aria-expanded', on ? 'true' : 'false');
        const p = panelOf(b);
        if (p) p.hidden = !on;
      });
      if (target) acc.closest('.sv')?.setAttribute('data-active', target.id.replace('sv-btn-', ''));
    };
    acc.closest('.sv')?.classList.add('js');
    open(btns[0] ?? null);
    btns.forEach((b, i) => {
      b.addEventListener('click', () => {
        if (b.getAttribute('aria-expanded') === 'true') return;
        open(b);
      });
      b.addEventListener('keydown', (e) => {
        let n = -1;
        if (e.key === 'ArrowDown') n = (i + 1) % btns.length;
        else if (e.key === 'ArrowUp') n = (i - 1 + btns.length) % btns.length;
        else if (e.key === 'Home') n = 0;
        else if (e.key === 'End') n = btns.length - 1;
        if (n < 0) return;
        e.preventDefault();
        btns[n].focus();
      });
    });
  });
</script>
<style>
  .sv { padding-block: var(--section); }
  .sv__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s6); }
  .sv__eyebrow { margin: 0 0 var(--s3); font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-500); }
  .sv__eyebrow span { margin-right: 0.5em; }
  .sv__muted { display: block; color: var(--ink-500); }
  .sv__intro { margin: var(--s4) 0 var(--s6); max-width: 52ch; }
  .sv__acc { border-top: 1px solid var(--ink-200); }
  .sv__item { border-bottom: 1px solid var(--ink-200); }
  .sv__h { margin: 0; font: inherit; }
  .sv__btn { display: flex; align-items: center; gap: var(--s4); width: 100%; min-height: 44px; padding: var(--s4) 0; background: none; border: 0; color: var(--ink); font: inherit; text-align: left; cursor: pointer; }
  .sv__num { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em; color: var(--ink-500); }
  .sv__name { flex: 1; min-width: 0; font-size: 1.375rem; font-weight: 500; overflow-wrap: anywhere; }
  .sv__plus { position: relative; flex: none; width: 36px; height: 36px; border: 1px solid var(--ink-300); border-radius: 50%; }
  .sv__plus::before, .sv__plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 14px; height: 2px; margin: -1px 0 0 -7px; background: var(--ink); }
  .sv__plus::after { transform: rotate(90deg); }
  .sv__btn[aria-expanded='true'] .sv__plus { transform: rotate(45deg); background: var(--ink); border-color: var(--ink); }
  .sv__btn[aria-expanded='true'] .sv__plus::before, .sv__btn[aria-expanded='true'] .sv__plus::after { background: #fff; }
  .sv__btn:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .sv__panel { padding: 0 0 var(--s5); }
  .sv__panel[hidden] { display: none; }
  .sv__panel p { margin: 0 0 var(--s3); color: var(--ink-700); max-width: 56ch; }
  .sv__panel p.sv__inc { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-500); margin-top: var(--s4); }
  .sv__list { list-style: none; margin: 0 0 var(--s4); padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s2) var(--s5); }
  .sv__list li { position: relative; padding-left: 1rem; color: var(--ink-700); overflow-wrap: anywhere; }
  .sv__list li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 5px; height: 5px; background: var(--ink); }
  .sv__link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; color: var(--ink); text-decoration: underline; text-underline-offset: 0.3em; text-decoration-color: var(--ink-300); }
  .sv__link:hover { text-decoration-color: var(--ink); }
  @media (min-width: 640px) { .sv__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .sv__side { display: none; }
  .sv__cap { margin: var(--s2) 0 0; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-500); text-align: center; }
  .sv__pp { margin-top: var(--s4); }
  .sv__pp .sv__cap { max-width: none; }
  .ph { width: 100%; max-width: 15rem; margin-inline: auto; aspect-ratio: 9 / 17; border: 6px solid var(--ink); border-radius: 2rem; background: #fff; position: relative; overflow: hidden; box-sizing: border-box; }
  .ph__notch { position: absolute; top: 0.4rem; left: 50%; width: 28%; height: 0.5rem; margin-left: -14%; border-radius: 1rem; background: var(--ink); }
  .ph__screen { position: absolute; inset: 1.4rem 0.6rem 0.6rem; display: flex; flex-direction: column; gap: 0.5rem; overflow: hidden; }
  .ph__bar { display: block; height: 0.45rem; border-radius: 0.25rem; background: var(--ink-200); }
  .ph__bar.ph__ink { background: var(--ink); }
  .ph__bar.ph__lg { height: 0.9rem; background: var(--ink); }
  .ph__nav { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .ph__nav .ph__bar { flex: none; }
  .ph__dot { width: 0.7rem; height: 0.7rem; border-radius: 50%; background: var(--ink-300); }
  .ph__hero { display: flex; flex-direction: column; gap: 0.5rem; padding: 0.8rem 0.5rem; border-radius: 0.6rem; background: var(--ink-100, #eef2f5); }
  .ph__btn { width: 40%; height: 0.9rem; border-radius: 1rem; background: #e8742a; }
  .ph__cards { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .ph__cards i { display: block; aspect-ratio: 1; border-radius: 0.5rem; background: var(--ink-200); }
  .ph__pin { width: 1.2rem; height: 1.2rem; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: #e8742a; margin: 0.6rem auto 0.4rem; }
  .ph__stars { display: flex; gap: 0.25rem; }
  .ph__stars i { width: 0.7rem; height: 0.7rem; background: #e8a82a; clip-path: polygon(50% 0, 62% 36%, 100% 38%, 70% 60%, 80% 100%, 50% 76%, 20% 100%, 30% 60%, 0 38%, 38% 36%); }
  .ph__row { display: flex; gap: 0.4rem; }
  .ph__chip { flex: 1; height: 1.1rem; border-radius: 1rem; background: var(--ink-200); }
  .ph__reel { position: relative; flex: 1; min-height: 5rem; border-radius: 0.6rem; background: var(--ink); }
  .ph__play { position: absolute; left: 50%; top: 50%; width: 0; height: 0; margin: -0.7rem 0 0 -0.4rem; border-style: solid; border-width: 0.7rem 0 0.7rem 1.1rem; border-color: transparent transparent transparent #fff; }
  .ph__prog { height: 0.3rem; border-radius: 0.2rem; background: var(--ink-200); }
  .ph__prog i { display: block; width: 40%; height: 100%; border-radius: 0.2rem; background: #e8742a; }
  .ph__chart { display: flex; align-items: flex-end; gap: 0.4rem; flex: 1; min-height: 5rem; padding: 0.4rem; border-radius: 0.6rem; background: var(--ink-100, #eef2f5); }
  .ph__chart i { flex: 1; border-radius: 0.2rem 0.2rem 0 0; background: var(--ink); }
  @media (min-width: 1024px) {
    .sv__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .sv__main { grid-column: 1 / span 7; }
    .sv__pp { display: none; }
    .sv__side { display: none; grid-column: 8 / span 5; }
    .sv.js .sv__side { display: block; }
    .sv__sticky { position: sticky; top: 6rem; }
    .sv__demo { display: none; }
    .sv[data-active='web'] .sv__demo[data-demo='web'],
    .sv[data-active='local'] .sv__demo[data-demo='local'],
    .sv[data-active='video'] .sv__demo[data-demo='video'],
    .sv[data-active='ads'] .sv__demo[data-demo='ads'] { display: block; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .sv__plus { transition: transform 0.25s ease, background-color 0.25s ease; }
    .sv__demo { animation: sv-in 0.35s ease; }
    @keyframes sv-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  }
</style>
