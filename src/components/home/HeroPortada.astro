---
import { href, type Lang } from '../../i18n';
import { tr } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = tr(lang);
import Stones from '../Stones.astro';
import HeroCloud from './HeroCloud.astro';
---
<section class="hp" data-home-hero aria-labelledby="hp-h">
  <div class="wrap hp__grid">
    <div class="hp__text">
      <p class="hp__eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hp-h" class="h-hero">{t.hero.h1.a} <em>{t.hero.h1.em}</em></h1>
      <p class="hp__body">{t.hero.body}</p>
      <div class="hp__cta">
        <a class="btn btn--coral" href={href(lang, 'audit/')} data-track="audit_cta" data-location="hero">{t.hero.primary}</a>
        <a class="hp__link" href="#services">{t.hero.secondary}</a>
      </div>
    </div>
    <div class="hp__art" aria-hidden="true">
      <HeroCloud />
      <Stones from={0.1} to={0.6} />
    </div>
  </div>
</section>
<style>
  .hp { padding-block: var(--s6) var(--s8); background-image: radial-gradient(rgb(0 64 102 / 0.1) 1px, transparent 1px); background-size: 8px 8px; }
  .hp__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s6); align-items: center; }
  .hp__text { position: relative; z-index: 1; display: grid; gap: var(--s5); align-content: center; }
  .hp__eyebrow { font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink); }
  .hp__body { font-size: 1.1875rem; line-height: 1.5; color: var(--ink); max-width: 36rem; text-wrap: balance; }
  .hp__cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s3) var(--s5); }
  .hp__link { color: var(--ink); text-decoration: underline; text-underline-offset: 0.3em; text-decoration-color: var(--ink-300); font-weight: 500; }
  .hp__link:hover { text-decoration-color: var(--ink); }
  .hp__art { position: relative; overflow: hidden; display: block; max-width: 100%; aspect-ratio: 5 / 3; pointer-events: none; }
  @media (min-width: 1024px) {
    .hp__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s8); }
  }
</style>
