---
// Decorative full-bleed dot scatter (after Ale's HeroSenal): fine dot grid plus denser ink dots
// at different sizes/offsets, faded under the text. CSS only, no script.
---
<div class="cloud" data-hero-cloud aria-hidden="true">
  <div class="cloud__layer cloud__grid"></div>
  <div class="cloud__layer cloud__d1"></div>
  <div class="cloud__layer cloud__d2"></div>
  <div class="cloud__layer cloud__d3"></div>
</div>
<style>
  .cloud { position: absolute; inset: 0; overflow: hidden; pointer-events: none; border-radius: 0; background: none; }
  .cloud__layer {
    position: absolute; inset: 0;
    /* mobile: text spans full width, keep faint and denser toward the bottom (art) */
    -webkit-mask-image: linear-gradient(180deg, rgb(0 0 0 / 0.12) 0%, rgb(0 0 0 / 0.2) 55%, #000 100%);
    mask-image: linear-gradient(180deg, rgb(0 0 0 / 0.12) 0%, rgb(0 0 0 / 0.2) 55%, #000 100%);
  }
  .cloud__grid {
    background-image: radial-gradient(rgb(0 64 102 / 0.18) 1px, transparent 1.4px);
    background-size: 8px 8px;
  }
  .cloud__d1 {
    background-image: radial-gradient(rgb(0 64 102 / 0.5) 1.4px, transparent 1.9px);
    background-size: 24px 24px; background-position: 4px 6px;
  }
  .cloud__d2 {
    background-image: radial-gradient(rgb(0 64 102 / 0.4) 2px, transparent 2.6px);
    background-size: 47px 47px; background-position: 13px 21px;
  }
  .cloud__d3 {
    background-image: radial-gradient(rgb(0 64 102 / 0.55) 2.6px, transparent 3.2px);
    background-size: 89px 89px; background-position: 40px 9px;
  }
  @media (min-width: 1024px) {
    .cloud__layer {
      -webkit-mask-image: linear-gradient(90deg, rgb(0 0 0 / 0) 0%, rgb(0 0 0 / 0.06) 40%, rgb(0 0 0 / 0.6) 62%, #000 85%);
      mask-image: linear-gradient(90deg, rgb(0 0 0 / 0) 0%, rgb(0 0 0 / 0.06) 40%, rgb(0 0 0 / 0.6) 62%, #000 85%);
    }
  }
</style>
