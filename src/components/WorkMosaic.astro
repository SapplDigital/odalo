---
import Art from './Art.astro';
import ConceptImage from './ConceptImage.astro';
import { projects } from '../content/projects';
import { serviceById } from '../content/services';
import { href, type Lang } from '../i18n';
import { tr } from '../i18n/ui';
/** joined: the homepage's connected Services→Work field (header staircase on the Services seam, explainer moved into the header, shared-edge emphasis on wide screens). Every other placement keeps the original layout. */
interface Props { num?: string; lang: Lang; heading?: boolean; ids?: string[]; explainer?: boolean; id?: string; h1?: boolean; joined?: boolean }
const { num, lang, heading = true, ids, explainer = true, id = 'work', h1 = false, joined = false } = Astro.props;
const t = tr(lang);
const artTone = { ink: 'slate', sand: 'coral', coral: 'sand', slate: 'ink' } as const;
const list = ids ? ids.map((i) => projects.find((p) => p.id === i)!).filter(Boolean) : projects;
const cardImage = (p: (typeof projects)[number]) => p.images?.find((i) => i.role === 'card');
const narrowImage = (p: (typeof projects)[number]) => p.images?.find((i) => i.role === 'card-narrow');
// A tall creative suits the portrait art slot of a supporting card in the 3-column desktop layout only.
const variantsFor = (p: (typeof projects)[number], i: number) => (p.images ?? []).filter((im) => im.role === 'card-narrow' || (im.role === 'card-tall' && !two && i > 0));
const all = list;
const two = all.length === 2 || !explainer;
const last = all.length - 1;
const showExplain = explainer && !joined; // joined: the same sentence and link live in the header instead (once)
const tallOf = (p: (typeof projects)[number]) => p.images?.find((i) => i.role === 'card-tall');
---
<section id={id} class:list={['work', 'section', { 'work--joined': joined }]} aria-labelledby="work-h" data-work-field={joined ? '' : undefined}>
  <div class="wrap">
    {joined && (
      <header class="wj-head">
        <i class="wj-peg" aria-hidden="true" data-wj-peg></i>
        <div class="wj-title">
          <p class="eyebrow">{num ? `${num} — ` : ''}{t.nav.work}</p>
          <h2 id="work-h" class="h-section">{t.work.h2.a}{t.work.h2.a && ' '}<em>{t.work.h2.em}</em></h2>
        </div>
        <div class="wj-note on-dark">
          <p>{t.work.explainer}</p>
          <a class="link-arrow" href={href(lang, 'work/')}>{t.common.viewAll}</a>
        </div>
      </header>
    )}
    {heading && !joined && (
      <header class="work__head">
        <p class="eyebrow">{num ? `${num} — ` : ''}{t.nav.work}</p>
        {h1 ? <h1 id="work-h" class="h-section">{t.work.h2.a}{t.work.h2.a && ' '}<em>{t.work.h2.em}</em></h1> : <h2 id="work-h" class="h-section">{t.work.h2.a}{t.work.h2.a && ' '}<em>{t.work.h2.em}</em></h2>}
      </header>
    )}
    <div class:list={['grid', { 'grid--two': two, 'grid--explain': showExplain, 'grid--field': joined }]} data-wj-board={joined ? '' : undefined}>
      {all.map((p, i) => (
        <article data-p={p.id} class:list={['proj', `proj--${p.tone}`, `proj--${i === 0 ? 'feat' : 'sup'}`, { 'proj--last': i === last && !explainer, 'proj--end': joined && i === last, 'on-dark': p.tone === 'ink' || p.tone === 'slate', 'on-coral': p.tone === 'coral' }]}>
          <div class:list={['proj__art', { 'proj__art--shot': !!cardImage(p) }]} style={[narrowImage(p) ? `--ar-narrow:${narrowImage(p)!.width} / ${narrowImage(p)!.height}` : '', joined && tallOf(p) ? `--art-ar:${tallOf(p)!.width} / ${tallOf(p)!.height}` : ''].filter(Boolean).join(';') || undefined}>
            {cardImage(p)
              ? <ConceptImage image={cardImage(p)!} variants={variantsFor(p, i)} lang={lang} sizes="(min-width: 64em) 55vw, (min-width: 48em) 90vw, 100vw" />
              : <Art variant={p.art} tone={artTone[p.tone]} label={`${p.title[lang]}. ${t.a11y.sampleArt}`} />}
          </div>
          <div class="proj__body">
            <p class="proj__meta"><span class="proj__badge">{p.badge ? p.badge[lang] : t.work.sampleBadge}</span> <span>{p.kind[lang]}</span></p>
            <h3 class="h-tile proj__title"><a href={href(lang, `work/${p.id}/`)}>{(p.cardTitle ?? p.title)[lang]}{p.cardTitle && <span class="sr-only">: {p.title[lang]}</span>}</a></h3>
            {(i === 0 || joined) && <p class="proj__text">{p.context[lang]}</p>}
            <ul class="proj__svc" aria-label={t.work.connected}>
              {p.services.map((sid) => <li>{serviceById(sid)!.name[lang]}</li>)}
            </ul>
            {i === 0 && <p class="proj__more">{t.common.readCase} <span aria-hidden="true">→</span></p>}
          </div>
        </article>
      ))}
      {showExplain && (
        <aside class="explain on-dark">
          <p>{t.work.explainer}</p>
          <a class="link-arrow" href={href(lang, 'work/')}>{t.common.viewAll}</a>
        </aside>
      )}
    </div>
  </div>
</section>
<style>
  .work__head { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s4); margin-bottom: var(--s7); max-width: 60rem; }
  /* One connected composition: no gutters, flat internal edges. Only the outer silhouette is curved (large top left and bottom right,
     small top right and bottom left), set per layout below. The pieces keep distinct surfaces. */
  .grid { display: grid; gap: 0; grid-template-columns: minmax(0, 1fr); }
  .proj { position: relative; display: flex; flex-direction: column; overflow: hidden; min-width: 0; border-radius: 0; }
  .proj--ink { background: var(--ink); color: var(--paper); }
  .proj--sand { background: var(--sand); color: var(--ink); }
  .proj--coral { background: var(--coral); color: var(--ink-deep); }
  .proj--feat { border-top-left-radius: var(--r-big); }
  .proj--last, .explain { border-bottom-right-radius: var(--r-big); }
  .proj__art { position: relative; aspect-ratio: 16 / 10; overflow: hidden; }
  /* Phones get the purpose-made phone crop in its own shape instead of a squeezed desktop picture. */
  @media (max-width: 47.99em) { .proj__art--shot { aspect-ratio: var(--ar-narrow, 16 / 10); } }
  .proj__art--shot :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .proj__art :global(svg) { transition: transform 0.4s ease; }
  .proj:hover .proj__art :global(svg), .proj:focus-within .proj__art :global(svg) { transform: scale(1.025); }
  .proj__body { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s3); padding: var(--pad); align-content: start; }
  .proj__meta { display: flex; flex-wrap: wrap; gap: 6px 12px; font-size: 0.875rem; font-weight: 500; align-items: center; }
  .proj__badge { border: 1.5px solid currentColor; border-radius: 999px; padding: 1px 10px; font-weight: 600; font-size: 0.8125rem; }
  .proj__title a { text-decoration: none; }
  .proj__title a::after { content: ''; position: absolute; inset: 0; }
  .proj__title a:focus-visible { outline-offset: -6px; } /* inside the card: the focus ring is never cut off at the composition's outer edge */
  .proj__text { max-width: 46ch; }
  .proj__svc { display: flex; flex-wrap: wrap; gap: 6px; }
  .proj__svc li { font-size: 0.875rem; font-weight: 600; padding: 3px 12px; border-radius: 999px; background: rgb(255 255 255 / 0.16); }
  .proj--sand .proj__svc li { background: rgb(32 59 87 / 0.1); }
  .proj--coral .proj__svc li { background: rgb(255 255 255 / 0.32); }
  .proj__more { font-weight: 700; }
  .explain { background: var(--slate); color: var(--paper); padding: var(--pad); display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s4); align-content: space-between; border-radius: 0; border-bottom-right-radius: var(--r-big); }
  .explain p { font-size: 1.0625rem; max-width: 46ch; }
  .explain .link-arrow { color: var(--paper); }

  /* Tablet: the featured card spans both columns; a screenshot keeps its own 16:10 shape. Supporting cards sit side by side
     (stacked picture over text), the context panel spans the row under them. */
  @media (min-width: 48em) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .proj--feat { grid-column: 1 / -1; }
    .proj--feat .proj__art { aspect-ratio: 16 / 10; }
    .proj--feat { border-top-right-radius: var(--r-small); }
    .explain { grid-column: 1 / -1; }
    .grid--two .proj--sup { border-bottom-left-radius: 0; }
    .grid--two .proj--sup:last-of-type { border-bottom-right-radius: var(--r-big); }
  }
  /* Wide desktop (80em and up; narrower windows keep the tablet arrangement, where the pictures stay large enough): featured card left, supporting cards and the context panel stacked right. Height is led by the content: the featured
     picture keeps its 16:10 shape, the right column rows follow their own pictures, and any difference is shared by the right-hand
     cards' pictures (cropped, never stretched), so no empty coloured area is left under the hotel. */
  @media (min-width: 80em) {
    .work:not(.work--joined) .grid { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: auto auto auto; }
    .work:not(.work--joined) .proj--feat { grid-column: 1 / span 7; grid-row: 1 / span 3; border-top-right-radius: 0; border-bottom-left-radius: var(--r-small); }
    .work:not(.work--joined) .proj--feat .proj__art { flex: none; }
    .work:not(.work--joined) .proj--sup { grid-column: 8 / -1; flex-direction: row; align-items: stretch; }
    .work:not(.work--joined) .proj--sup + .proj--sup { grid-row: 2; }
    .work:not(.work--joined) .proj--sup:nth-of-type(2) { grid-row: 1; border-top-right-radius: var(--r-small); }
    .work:not(.work--joined) .proj--sup .proj__art { aspect-ratio: 4 / 5; width: 42%; flex: none; }
    .work:not(.work--joined) .proj--sup .proj__art--shot :global(img) { object-position: 50% 0; }
    .work:not(.work--joined) .proj--sup[data-p='sample-shop'] .proj__art--shot :global(img) { object-position: 50% 100%; }
    .work:not(.work--joined) .proj--sup .proj__body { align-content: center; }
    .work:not(.work--joined) .explain { grid-column: 8 / -1; grid-row: 3; }
    .work:not(.work--joined) .grid--two .proj--feat { grid-row: 1; }
    .work:not(.work--joined) .grid--two .proj--sup { grid-column: 7 / -1; grid-row: 1; flex-direction: column; border-top-right-radius: var(--r-small); border-bottom-right-radius: var(--r-big); }
    .work:not(.work--joined) .grid--two .proj--sup .proj__art { width: auto; aspect-ratio: 16 / 10; }
    .work:not(.work--joined) .grid--two .proj--feat { grid-column: 1 / span 6; }
  }

  /* ================= Homepage connected field (joined) =================
     Only the homepage passes `joined`; every other placement keeps the layout above untouched.
     The header is a staircase on the Services board's REST seam (video | advertising: 5fr/7fr on desktop, 5.5fr/6.5fr on tablet; --wj-seam below
     mirrors those values and tests/work-field.spec.ts measures the real Services board against it). While a Services tile is emphasised the
     real edge moves and this join deliberately does not follow it; while a Services detail is open the decorative peg is detached (the real
     panel is the bridge) and everything with content stays in flow. */
  .work--joined { --wj-seam: 45%; padding-top: 0; }
  .work--joined .wrap { container-type: inline-size; }
  .wj-head { display: grid; grid-template-columns: minmax(0, 1fr); }
  .wj-peg { display: block; width: var(--wj-seam); height: var(--s5); background: var(--coral); border-bottom-left-radius: var(--r-small); }
  .wj-title { display: grid; gap: var(--s3); align-content: end; padding-block: var(--s7) var(--s6); }
  .wj-note { display: grid; gap: var(--s3); align-content: end; justify-items: start; background: var(--slate); color: var(--paper); padding: var(--pad); border-top: 1px solid color-mix(in srgb, var(--paper) 30%, transparent); }
  .wj-note p { max-width: 46ch; text-wrap: pretty; font-size: 1.0625rem; }
  .wj-note .link-arrow { color: var(--paper); }
  :global(.svc[data-detail-state='open'] ~ .work--joined) .wj-peg { visibility: hidden; }
  .grid--field .proj--feat { border-top-left-radius: 0; }
  .grid--field .proj--end { border-bottom-right-radius: var(--r-big); }
  /* the large outer curve must never cut into the last card's text or tags */
  .grid--field .proj--end .proj__body { padding-bottom: calc(var(--pad) + var(--r-big) * 0.3); }
  .grid--field .proj__title a:focus-visible { outline: none; }
  .grid--field .proj:has(.proj__title a:focus-visible) { outline: 3px solid var(--focus); outline-offset: -6px; }
  .grid--field .proj__art--shot :global(img) { transform-origin: 50% 0; transition: transform 0.38s cubic-bezier(0.22, 0.8, 0.3, 1); }
  .grid--field .proj--feat.is-active .proj__art--shot :global(img) { transform: scale(1.03); }
  @media (hover: hover) and (pointer: fine) { .grid--field .proj--feat:hover .proj__art--shot :global(img) { transform: scale(1.03); } }
  @media (prefers-reduced-motion: reduce) { .grid--field .proj--feat.is-active .proj__art--shot :global(img), .grid--field .proj--feat:hover .proj__art--shot :global(img) { transform: none; } }
  @media (min-width: 48em) {
    .work--joined { --wj-seam: 45.833%; }
    .wj-head { grid-template-columns: var(--wj-seam) minmax(0, 1fr); }
    .wj-peg { grid-column: 1; grid-row: 1; width: auto; }
    .wj-title { grid-column: 1; grid-row: 2; padding-right: var(--s6); }
    .wj-note { grid-column: 2; grid-row: 1 / span 2; padding: var(--pad) var(--s6); }
    .grid--field { grid-template-columns: var(--wj-seam) minmax(0, 1fr); }
    .grid--field .proj--sup:last-child { border-bottom-right-radius: var(--r-big); }
    .grid--field .proj--sup[data-p='sample-clinic'] { border-bottom-left-radius: 0; }
  }
  @media (min-width: 64em) { .work--joined { --wj-seam: 41.667%; } }
  /* wide (80em+) natural flow: the production desktop arrangement (featured left, supporting right, portrait creatives). It is what remains whenever the shared-edge
     geometry below is not eligible (enlarged text, content that does not fit, short window, reduced motion). */
  @media (min-width: 80em) {
    @container (min-width: 60rem) {
    .grid--field { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: auto auto; }
    /* an even 6/6 split: the supporting text (now with its context sentence) needs the room, and the featured picture absorbs any height difference by cropping, not by an empty slab */
    .grid--field .proj--feat { grid-column: 1 / span 6; grid-row: 1 / span 2; border-top-right-radius: 0; border-bottom-left-radius: var(--r-small); }
    .grid--field .proj--feat .proj__art { flex: 1 1 auto; }
    .grid--field .proj--sup { grid-column: 7 / -1; flex-direction: row; align-items: stretch; }
    .grid--field .proj--sup[data-p='sample-clinic'] { grid-row: 1; border-top-right-radius: 0; }
    .grid--field .proj--sup[data-p='sample-shop'] { grid-row: 2; }
    .grid--field .proj--sup .proj__art { aspect-ratio: 4 / 5; width: 41%; flex: none; }
    .grid--field .proj--sup .proj__art--shot :global(img) { object-position: 50% 0; }
    .grid--field .proj--sup[data-p='sample-shop'] .proj__art--shot :global(img) { object-position: 50% 100%; }
    .grid--field .proj--sup .proj__body { align-content: center; }
    }
    /* a 80em+ window whose text is enlarged leaves the field narrower than 60rem: stack it, so the portrait pictures keep their shape */
    @container (max-width: 59.99rem) {
      .grid--field { grid-template-columns: minmax(0, 1fr); }
      .grid--field .proj--feat, .grid--field .proj--sup { grid-column: 1; grid-row: auto; border-top-right-radius: 0; border-bottom-left-radius: 0; }
      .grid--field .proj--sup { flex-direction: row; align-items: stretch; }
      .grid--field .proj--sup .proj__art { aspect-ratio: 4 / 5; width: 38%; flex: none; }
      .grid--field .proj--sup .proj__body { align-content: center; }
    }
  }
  /* wide: shared-edge emphasis inside a fixed-height board. The geometry exists only while --geo is 1: width/height/motion media, a container at least 72rem
     wide (rem: enlarged root text leaves it), and no data-flow (set by the controller when a body would not fit; natural flow is the fallback). */
  @media (min-width: 80em) and (min-height: 34em) and (prefers-reduced-motion: no-preference) {
    @container (min-width: 72rem) {
      .grid--field[data-ready]:not([data-flow]) {
        --geo: 1; --rc1: 6.2; --rc2: 5.8; --c1: calc(var(--rc1) * 1fr); --c2: calc(var(--rc2) * 1fr); --r1: 1fr; --r2: 1fr; --rest-x: 0.51667; --rest-y: 0.5;
        height: var(--wj-h, calc(51.667cqw * 0.625 + 26rem));
        grid-template-columns: minmax(0, var(--c1)) minmax(0, var(--c2));
        grid-template-rows: minmax(0, var(--r1)) minmax(0, var(--r2));
        transition: grid-template-columns 0.38s cubic-bezier(0.22, 0.8, 0.3, 1), grid-template-rows 0.38s cubic-bezier(0.22, 0.8, 0.3, 1);
      }
      .grid--field[data-active='sample-hotel'][data-ready]:not([data-flow]) { --c1: 6.3fr; --c2: 5.7fr; }
      .grid--field[data-active='sample-clinic'][data-ready]:not([data-flow]) { --r1: 1.08fr; --r2: 0.92fr; }
      .grid--field[data-active='sample-shop'][data-ready]:not([data-flow]) { --r1: 0.92fr; --r2: 1.08fr; }
      .grid--field[data-ready]:not([data-flow]) .proj--feat { grid-column: 1; grid-row: 1 / span 2; border-top-right-radius: 0; border-bottom-left-radius: var(--r-small); }
      .grid--field[data-ready]:not([data-flow]) .proj--feat .proj__art { flex: 1 1 auto; aspect-ratio: auto; min-height: 0; }
      .grid--field[data-ready]:not([data-flow]) .proj--sup { grid-column: 2; flex-direction: row; border-top-right-radius: 0; }
      .grid--field[data-ready]:not([data-flow]) .proj--sup[data-p='sample-clinic'] { grid-row: 1; border-bottom-left-radius: 0; }
      .grid--field[data-ready]:not([data-flow]) .proj--sup[data-p='sample-shop'] { grid-row: 2; }
      .grid--field[data-ready]:not([data-flow]) .proj--sup .proj__art { flex: 0 1 auto; width: auto; height: 100%; aspect-ratio: var(--art-ar, 4 / 5); min-width: 0; }
      .grid--field[data-ready]:not([data-flow]) .proj--sup .proj__body { align-content: start; }
      .grid--field[data-ready]:not([data-flow]) .proj--sup .proj__body { flex: 0 0 clamp(16rem, 24cqw, 21rem); margin-left: auto; padding: var(--s5); gap: var(--s2); align-content: start; }
      /* text stays put while edges trade: the top card hangs from the board top, the bottom card from the board bottom, both from the right edge */
      .grid--field[data-ready]:not([data-flow]) .proj--sup[data-p='sample-shop'] .proj__body { align-content: end; }
      .grid--field[data-ready]:not([data-flow]) .proj--end .proj__body { padding-bottom: calc(var(--s5) + var(--r-big) * 0.3); }
    }
    @container (min-width: 80rem) { .grid--field[data-active='sample-hotel'][data-ready]:not([data-flow]) { --c1: 6.5fr; --c2: 5.5fr; } }
  }
  /* one short dock event on arrival: transform only, content never hidden (set by the controller; reduced motion never pends) */
  @media (prefers-reduced-motion: no-preference) {
    .wj-peg { transition: transform 0.45s cubic-bezier(0.22, 0.8, 0.3, 1); }
    .grid--field .proj { transition: transform 0.45s cubic-bezier(0.22, 0.8, 0.3, 1); }
    .wj-peg { transform-origin: 0 50%; }
    .work--joined[data-ledge='pending'] .wj-peg { transform: scaleX(0.55); } /* grows into place from its left edge: stays inside the viewport at every width and text size */
    .work--joined[data-cards='pending'] .grid--field .proj { transform: translateY(1.25rem); }
    .grid--field .proj:nth-child(2) { transition-delay: 70ms; }
    .grid--field .proj:nth-child(3) { transition-delay: 140ms; }
  }
</style>
<script>
  /* Homepage connected field only (the section carries data-work-field). Vanilla; one controller, no shared engine, no dependency.
     1. Dock: one short settle of the header peg and the cards when the field arrives (a rAF-throttled scroll check, not scroll-linked, no interception).
     2. Emphasis (wide geometry only): mouse hover against the board's RESTING partition with intent + hysteresis, and keyboard focus. KEYBOARD FOCUS WINS:
        while a card has :focus-visible focus, pointer movement is ignored and any queued pointer intent is cleared. When focus leaves, the board returns to rest
        and the next pointer movement selects again. Touch and pen never select; each card has one native link.
     3. Mode changes: when the geometry stops being eligible (reduced motion, resize, enlarged text, content that would not fit) timers are cancelled and the board
        returns to rest without travel; re-entering never replays old intent. */
  const field = document.querySelector<HTMLElement>('[data-work-field]');
  const board = field?.querySelector<HTMLElement>('[data-wj-board]');
  const peg = field?.querySelector<HTMLElement>('[data-wj-peg]');
  if (field && board && peg) {
    const cards = [...board.querySelectorAll<HTMLElement>(':scope > .proj')];
    const KEYS = cards.map((c) => c.dataset.p!); // featured, supporting top, supporting bottom
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const INTENT_MS = 110; // deliberate hover before an emphasis starts
    const RESET_MS = 180;  // a brief exit does not snap back
    const HYST = 24;       // px: how far past the REST boundary of the current card the pointer must go before another card takes over

    let active = '';
    let pending = '';
    let hoverTimer = 0;
    let resetTimer = 0;
    let focusKey = '';
    const cssNum = (name: string, fallback: number) => parseFloat(getComputedStyle(board).getPropertyValue(name)) || fallback;
    const geoOn = () => getComputedStyle(board).getPropertyValue('--geo').trim() === '1';

    const set = (key: string) => {
      active = key;
      if (key && geoOn()) board.dataset.active = key; else delete board.dataset.active;
      cards.forEach((c) => c.classList.toggle('is-active', !!key && c.dataset.p === key));
    };
    const clearIntent = () => { clearTimeout(hoverTimer); clearTimeout(resetTimer); pending = ''; };

    /* ---- dock ---- */
    const inView = (el: HTMLElement, f: number) => el.getBoundingClientRect().top < innerHeight * f;
    const heroArt = document.querySelector<HTMLElement>('[data-hero-art]');
    let holding = false;
    const hold = (on: boolean) => { if (holding === on) return; holding = on; document.dispatchEvent(new CustomEvent('odalo:hero-hold', { detail: { source: 'work', hold: on } })); };
    const settle = () => { field.dataset.ledge = 'done'; field.dataset.cards = 'done'; hold(false); };
    const arm: Record<string, [HTMLElement, number]> = { ledge: [peg, 0.9], cards: [board, 0.8] };
    let frame = 0;
    const check = () => {
      frame = 0;
      let waiting = 0;
      for (const [key, [el, f]] of Object.entries(arm)) {
        if (field.dataset[key] === 'done') continue;
        if (inView(el, f)) {
          field.dataset[key] = 'done';
          // the dock is a real motion: only if the hero is actually on screen at that moment, ask it (through its own contract) to hold until the dock has finished
          if (heroArt && !reduce.matches) { const r = heroArt.getBoundingClientRect(); if (r.bottom > 0 && r.top < innerHeight) { hold(true); setTimeout(() => hold(false), 800); } }
        } else waiting++;
      }
      if (!waiting) { removeEventListener('scroll', schedule); removeEventListener('resize', schedule); }
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(check); };
    if (reduce.matches) settle();
    else {
      for (const [key, [el, f]] of Object.entries(arm)) field.dataset[key] = inView(el, f) ? 'done' : 'pending';
      addEventListener('scroll', schedule, { passive: true });
      addEventListener('resize', schedule);
    }
    addEventListener('hashchange', settle);
    addEventListener('pageshow', (e) => { if (e.persisted) { settle(); evaluate(); } });
    field.addEventListener('focusin', () => { field.dataset.ledge = 'done'; field.dataset.cards = 'done'; });

    /* ---- fit guard + mode changes ---- */
    /** Content height a card body needs, independent of how it is aligned inside the body. */
    const needed = (body: HTMLElement) => {
      const kids = [...body.children] as HTMLElement[];
      const cs = getComputedStyle(body);
      return kids.at(-1)!.getBoundingClientRect().bottom - kids[0]!.getBoundingClientRect().top + parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom);
    };
    let wasOn = false;
    const evaluate = () => {
      board.dataset.ready = '';                       // geometry is CSS-eligible only once this controller runs (no JS: natural flow)
      delete board.dataset.flow;                       // measure in geometry mode
      board.style.removeProperty('--wj-h');
      let on = geoOn();
      if (on) {
        const hotel = cards[0]!;
        const hotelBody = hotel.querySelector<HTMLElement>('.proj__body')!;
        const c1 = cssNum('--rc1', 6.2); const c2 = cssNum('--rc2', 5.8);
        // The board's height comes from its CONTENT, measured once at rest (not a guessed constant): the featured picture at 16:10 plus the featured text, or twice
        // the tallest supporting text divided by the smallest row share (0.92), whichever is larger. It is then fixed through every emphasis state.
        const hotelH = (board.clientWidth * c1 / (c1 + c2)) * 0.625 + needed(hotelBody);
        const supH = (2 * Math.max(...cards.slice(1).map((c) => needed(c.querySelector<HTMLElement>('.proj__body')!)))) / 0.92 + 1;
        const h = Math.ceil(Math.max(hotelH, supH));
        if (h > hotelH * 1.2) { board.dataset.flow = ''; on = false; }   // supporting copy would force a much taller board than the featured card needs: natural flow instead
        else board.style.setProperty('--wj-h', h + 'px');
      }
      if (wasOn && !on) { clearIntent(); set(''); }   // leaving geometry: no timers, no travel, no stale emphasis
      if (!wasOn && on) { clearIntent(); active = ''; if (focusKey) set(focusKey); } // re-entering: never replay old intent; focus (if still inside) wins
      wasOn = on;
    };
    let evFrame = 0;
    const evaluateSoon = () => { if (!evFrame) evFrame = requestAnimationFrame(() => { evFrame = 0; evaluate(); }); };
    addEventListener('resize', evaluateSoon);
    reduce.addEventListener('change', () => { if (reduce.matches) settle(); evaluateSoon(); });
    if ('ResizeObserver' in window) new ResizeObserver(evaluateSoon).observe(board);
    addEventListener('load', evaluate);
    document.fonts?.ready.then(evaluateSoon);        // text metrics change when the web fonts arrive: measure again, so the fixed board height always matches the final text
    evaluate();

    /* ---- emphasis ---- */
    const region = (px: number, py: number, rx: number, ry: number) => {
      const b = board.getBoundingClientRect(); const fx = px - b.left; const fy = py - b.top;
      const key = fx < b.width * rx ? KEYS[0]! : fy < b.height * ry ? KEYS[1]! : KEYS[2]!;
      return { key, fx, fy, w: b.width, h: b.height };
    };
    function distanceFromRest(key: string, fx: number, fy: number, w: number, h: number, rx: number, ry: number) {
      const box = key === KEYS[0] ? [0, w * rx, 0, h] : key === KEYS[1] ? [w * rx, w, 0, h * ry] : [w * rx, w, h * ry, h];
      return Math.max(0, box[0]! - fx, fx - box[1]!, box[2]! - fy, fy - box[3]!);
    }
    board.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || !geoOn() || reduce.matches) return; // touch and pen never select
      if (focusKey) return;                                                // keyboard focus wins over incidental pointer movement
      if (field.dataset.cards === 'pending') return;                       // geometry is live only once the pieces have docked
      const rx = cssNum('--rest-x', 0.51667); const ry = cssNum('--rest-y', 0.5);
      const hit = region(e.clientX, e.clientY, rx, ry);
      clearTimeout(resetTimer);
      if (hit.key === active) { clearTimeout(hoverTimer); pending = ''; return; }
      if (active && distanceFromRest(active, hit.fx, hit.fy, hit.w, hit.h, rx, ry) <= HYST) return; // dead band around the rest edge
      if (pending === hit.key) return;
      pending = hit.key;
      clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => { pending = ''; if (!focusKey && geoOn()) set(hit.key); }, INTENT_MS);
    });
    board.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      clearTimeout(hoverTimer); pending = '';
      if (focusKey) return;
      resetTimer = window.setTimeout(() => set(''), RESET_MS);
    });
    board.addEventListener('focusin', (e) => {
      const card = (e.target as Element).closest<HTMLElement>('.proj');
      if (!card || !(e.target as Element).matches(':focus-visible')) return; // a mouse press on a link is about to navigate; only keyboard focus emphasises
      clearIntent();                                                          // any queued pointer intent is dropped
      focusKey = card.dataset.p!;
      set(focusKey);
    });
    board.addEventListener('focusout', (e) => {
      const to = e.relatedTarget as Node | null;
      if (to && board.contains(to)) return;                                   // moving to another card: its focusin takes over
      focusKey = '';
      clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => set(''), RESET_MS);                // policy: rest, then the next pointer movement selects again
    });
  }
</script>
