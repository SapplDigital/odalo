---
import Art from './Art.astro';
import { projects } from '../content/projects';
import { serviceById } from '../content/services';
import { href, type Lang } from '../i18n';
import { tr } from '../i18n/ui';
interface Props { num?: string; lang: Lang; heading?: boolean; ids?: string[]; explainer?: boolean; id?: string; h1?: boolean }
const { num, lang, heading = true, ids, explainer = true, id = 'work', h1 = false } = Astro.props;
const t = tr(lang);
const artTone = { ink: 'slate', sand: 'coral', coral: 'sand', slate: 'ink' } as const;
const list = ids ? ids.map((i) => projects.find((p) => p.id === i)!).filter(Boolean) : projects;
const corners = ['c-tl', 'c-br', 'c-tr'];
const all = list;
const two = all.length === 2 || !explainer;
---
<section id={id} class="work section" aria-labelledby="work-h">
  <div class="wrap">
    {heading && (
      <header class="work__head">
        <p class="eyebrow">{num ? `${num} — ` : ''}{t.nav.work}</p>
        {h1 ? <h1 id="work-h" class="h-section">{t.work.h2.a} <em>{t.work.h2.em}</em></h1> : <h2 id="work-h" class="h-section">{t.work.h2.a} <em>{t.work.h2.em}</em></h2>}
      </header>
    )}
    <div class:list={['grid', { 'grid--two': two }]}>
      {all.map((p, i) => (
        <article class:list={['proj', `proj--${p.tone}`, `proj--${i === 0 ? 'feat' : 'sup'}`, corners[i], { 'on-dark': p.tone === 'ink' || p.tone === 'slate', 'on-coral': p.tone === 'coral' }]}>
          <div class="proj__art"><Art variant={p.art} tone={artTone[p.tone]} label={`${p.title[lang]}. ${t.a11y.sampleArt}`} /></div>
          <div class="proj__body">
            <p class="proj__meta"><span class="proj__badge">{t.work.sampleBadge}</span> <span>{p.kind[lang]}</span></p>
            <h3 class="h-tile proj__title"><a href={href(lang, `work/${p.id}/`)}>{p.title[lang]}</a></h3>
            {i === 0 && <p class="proj__text">{p.context[lang]}</p>}
            <ul class="proj__svc" aria-label={t.work.connected}>
              {p.services.map((sid) => <li>{serviceById(sid)!.name[lang]}</li>)}
            </ul>
            {i === 0 && <p class="proj__more">{t.common.readCase} <span aria-hidden="true">→</span></p>}
          </div>
        </article>
      ))}
      {explainer && (
        <aside class="explain on-dark c-bl">
          <p>{t.work.explainer}</p>
          <a class="link-arrow" href={href(lang, 'work/')}>{t.common.viewAll}</a>
        </aside>
      )}
    </div>
  </div>
</section>
<style>
  .work__head { display: grid; gap: var(--s4); margin-bottom: var(--s7); max-width: 60rem; }
  .grid { display: grid; gap: var(--gutter); grid-template-columns: 1fr; }
  .proj { position: relative; display: flex; flex-direction: column; overflow: hidden; border-radius: var(--r-small); min-width: 0; }
  .proj--ink { background: var(--ink); color: var(--paper); }
  .proj--sand { background: var(--sand); color: var(--ink); }
  .proj--coral { background: var(--coral); color: var(--ink-deep); }
  .c-tl { border-top-left-radius: var(--r-big); } .c-br { border-bottom-right-radius: var(--r-big); } .c-tr { border-top-right-radius: var(--r-big); } .c-bl { border-bottom-left-radius: var(--r-big); }
  .proj__art { aspect-ratio: 16 / 10; overflow: hidden; }
  .proj__art :global(svg) { transition: transform 0.4s ease; }
  .proj:hover .proj__art :global(svg), .proj:focus-within .proj__art :global(svg) { transform: scale(1.025); }
  .proj__body { display: grid; gap: var(--s3); padding: var(--pad); align-content: start; }
  .proj__meta { display: flex; flex-wrap: wrap; gap: 6px 12px; font-size: 0.875rem; font-weight: 500; align-items: center; }
  .proj__badge { border: 1.5px solid currentColor; border-radius: 999px; padding: 1px 10px; font-weight: 600; font-size: 0.8125rem; }
  .proj__title a { text-decoration: none; }
  .proj__title a::after { content: ''; position: absolute; inset: 0; }
  .proj__title a:focus-visible { outline-offset: -6px; }
  .proj__text { max-width: 46ch; }
  .proj__svc { display: flex; flex-wrap: wrap; gap: 6px; }
  .proj__svc li { font-size: 0.875rem; font-weight: 600; padding: 3px 12px; border-radius: 999px; background: rgb(255 255 255 / 0.16); }
  .proj--sand .proj__svc li { background: rgb(32 59 87 / 0.1); }
  .proj--coral .proj__svc li { background: rgb(255 255 255 / 0.32); }
  .proj__more { font-weight: 700; }
  .explain { background: var(--slate); color: var(--paper); padding: var(--pad); display: grid; gap: var(--s4); align-content: space-between; border-radius: var(--r-small); }
  .explain.c-bl { border-bottom-left-radius: var(--r-big); }
  .explain p { font-size: 1.0625rem; max-width: 46ch; }
  .explain .link-arrow { color: var(--paper); }

  @media (min-width: 48em) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .proj--feat { grid-column: 1 / -1; }
    .proj--feat .proj__art { aspect-ratio: 21 / 8; }
  }
  @media (min-width: 64em) {
    .grid { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: auto auto auto; }
    .proj--feat { grid-column: 1 / span 7; grid-row: 1 / span 3; }
    .proj--feat .proj__art { aspect-ratio: auto; flex: 1; min-height: 16rem; }
    .proj--sup { grid-column: 8 / -1; flex-direction: row; align-items: stretch; }
    .proj--sup .proj__art { aspect-ratio: auto; width: 40%; flex: none; }
    .proj--sup .proj__body { align-content: center; }
    .explain { grid-column: 8 / -1; grid-row: 3; }
    .grid--two .proj--sup { grid-row: 1 / span 3; flex-direction: column; }
    .grid--two .proj--sup .proj__art { width: auto; aspect-ratio: 16 / 10; }
  }
</style>
