---
import type { Lang } from '../../i18n';
import { tr } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = tr(lang);
---
<section class="ap" data-about-principles aria-labelledby="pr-h">
  <div class="wrap">
    <h2 id="pr-h" class="h-section ap__h">{t.about.principles}</h2>
    <ol class="ap__grid">
      {t.about.principlesItems.map((p, i) => (
        <li class="ap__cell" data-about-principle>
          <span class="ap__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="ap__t">{p.t}</h3>
          <p class="ap__d">{p.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .ap { padding-block: var(--section); background: var(--paper); }
  .ap__h { margin: 0 0 var(--s6); overflow-wrap: anywhere; hyphens: auto; }
  .ap__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); border-top: 1px solid color-mix(in srgb, var(--ink) 15%, transparent); border-left: 1px solid color-mix(in srgb, var(--ink) 15%, transparent); }
  .ap__cell { display: grid; gap: var(--s3); align-content: start; padding: var(--s5) var(--s4); min-width: 0; border-right: 1px solid color-mix(in srgb, var(--ink) 15%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--ink) 15%, transparent); }
  .ap__cell > * { margin: 0; }
  .ap__n { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em; color: var(--ink-500); }
  .ap__t { font-size: 1.375rem; line-height: 1.2; font-weight: 500; color: var(--ink); overflow-wrap: anywhere; hyphens: auto; }
  .ap__d { overflow-wrap: anywhere; }
  @media (min-width: 1024px) { .ap__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
