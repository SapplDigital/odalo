---
import { href, type Lang } from '../../i18n';
import { tr } from '../../i18n/ui';
import { services } from '../../content/services';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = tr(lang);
---
<section class="as" data-about-services aria-labelledby="as-h">
  <div class="wrap">
    <h2 id="as-h" class="h-section as__h">{t.about.servicesH}</h2>
    <ul class="as__grid">
      {services.map((s) => (
        <li class="as__cell" data-about-service>
          <span class="as__n">{s.number}</span>
          <a class="as__link" href={href(lang, `services/${s.id}/`)}>{s.name[lang]}</a>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .as { padding-block: var(--section); }
  .as__h { margin: 0 0 var(--s6); }
  .as__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); border-top: 1px solid color-mix(in srgb, var(--ink) 15%, transparent); border-left: 1px solid color-mix(in srgb, var(--ink) 15%, transparent); }
  .as__cell { display: flex; flex-direction: column; justify-content: space-between; gap: var(--s5); min-height: 9rem; padding: var(--s4); min-width: 0; border-right: 1px solid color-mix(in srgb, var(--ink) 15%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--ink) 15%, transparent); }
  .as__n { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em; color: var(--ink-500); }
  .as__link { font-size: 1.375rem; line-height: 1.2; font-weight: 500; color: var(--ink); text-underline-offset: 5px; overflow-wrap: anywhere; hyphens: auto; }
  @media (min-width: 768px) { .as__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .as__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
