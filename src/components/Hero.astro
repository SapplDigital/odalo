---
import Art from './Art.astro';
import { href, type Lang } from '../i18n';
import { tr } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = tr(lang);
---
<section class="hero" aria-labelledby="hero-h">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hero-h" class="h-hero">{t.hero.h1.a} <em>{t.hero.h1.em}</em></h1>
      <p class="hero__body lead">{t.hero.body}</p>
      <div class="hero__cta">
        <a class="btn btn--coral" href={href(lang, 'audit/')} data-track="audit_cta" data-location="hero">{t.hero.primary}</a>
        <a class="btn btn--ghost" href="#services">{t.hero.secondary}</a>
      </div>
    </div>

    <div class="hero__mosaic" aria-hidden="true">
      <div class="piece p-work c-tl"><Art variant="hero-web" tone="sand" /><span class="chip">{t.hero.pieces.web}</span></div>
      <div class="piece p-geo">
        <svg viewBox="0 0 120 120" preserveAspectRatio="xMidYMid slice" focusable="false">
          <rect width="120" height="120" fill="var(--slate)" />
          <path d="M0 0h64a64 64 0 0 1-64 64Z" fill="var(--ink)" />
          <circle cx="92" cy="30" r="20" fill="var(--sand)" />
          <circle cx="38" cy="92" r="20" fill="var(--coral)" />
          <path d="M120 120H70a50 50 0 0 1 50-50Z" fill="var(--paper)" />
        </svg>
      </div>
      <div class="piece p-video c-br"><Art variant="hero-video" tone="ink" /><span class="chip chip--dark">{t.hero.pieces.video}</span></div>
      <div class="piece p-lang"><span>ES</span><span>EN</span><span>DE</span></div>
      <div class="piece p-shape c-tr">
        <svg viewBox="0 0 120 120" preserveAspectRatio="xMidYMid slice" focusable="false">
          <rect width="120" height="120" fill="var(--coral)" />
          <path d="M0 120V40a80 80 0 0 1 80 80Z" fill="var(--ink)" />
          <circle cx="92" cy="34" r="16" fill="var(--paper)" />
        </svg>
      </div>
    </div>
  </div>
</section>
<style>
  .hero { padding-block: var(--s6) var(--section); }
  .hero__grid { display: grid; gap: var(--s7); align-items: stretch; }
  .hero__text { display: grid; gap: var(--s5); align-content: center; padding-block: var(--s4); }
  .hero__body { font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.375rem); color: var(--ink); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--s3) var(--s4); margin-top: var(--s2); }

  .hero__mosaic {
    display: grid; gap: var(--gutter); min-height: 22rem;
    grid-template-columns: 1fr 1fr; grid-template-rows: 9rem 10.5rem 6rem;
  }
  .piece { position: relative; overflow: hidden; border-radius: var(--r-small); min-width: 0; }
  .piece :global(svg), .piece svg { width: 100%; height: 100%; }
  .p-work { grid-column: 1; grid-row: 1; }
  .p-geo { grid-column: 2; grid-row: 1; border-top-right-radius: 28px; }
  .p-video { grid-column: 1 / -1; grid-row: 2; }
  .p-lang { grid-column: 1; grid-row: 3; background: var(--ink); color: var(--paper); display: flex; align-items: center; justify-content: space-around; font-weight: 800; letter-spacing: 0.06em; font-size: 1.125rem; border-bottom-left-radius: 28px; }
  .p-shape { grid-column: 2; grid-row: 3; }
  .chip { position: absolute; left: 10px; bottom: 10px; background: var(--paper); color: var(--ink); font-size: 0.8125rem; font-weight: 600; padding: 3px 12px; border-radius: 999px; }
  .chip--dark { background: var(--coral); color: var(--ink-deep); }

  @media (min-width: 768px) {
    .hero__mosaic { grid-template-rows: 11rem 13rem 7.5rem; min-height: 0; }
  }
  @media (min-width: 1024px) {
    .hero { padding-top: var(--s7); }
    .hero__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s8); }
    .hero__mosaic { grid-template-rows: minmax(0, 1.1fr) minmax(0, 1.3fr) minmax(0, 0.75fr); min-height: 34rem; }
    .p-work { border-top-left-radius: var(--r-big); }
  }

  /* Supporting visuals assemble once, then settle. Text and CTAs are never animated. */
  .js .piece { animation: assemble 0.9s cubic-bezier(0.22, 0.8, 0.3, 1) both; }
  .js .p-geo { animation-delay: 0.08s; } .js .p-video { animation-delay: 0.16s; }
  .js .p-lang { animation-delay: 0.24s; } .js .p-shape { animation-delay: 0.32s; }
  @keyframes assemble { from { opacity: 0; transform: translate(var(--ax, 0), var(--ay, 18px)); } to { opacity: 1; transform: none; } }
  .p-geo { --ax: 14px; --ay: 0px; } .p-lang { --ax: -14px; --ay: 0px; } .p-shape { --ax: 14px; --ay: 14px; }
</style>
