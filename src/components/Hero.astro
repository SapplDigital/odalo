---
import { href, type Lang } from '../i18n';
import { tr } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = tr(lang);
---
<section class="hero" aria-labelledby="hero-h">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hero-h" class="h-hero">{t.hero.h1.a} <em>{t.hero.h1.em}</em></h1>
      <p class="hero__body lead">{t.hero.body}</p>
      <div class="hero__cta">
        <a class="btn btn--coral" href={href(lang, 'audit/')} data-track="audit_cta" data-location="hero">{t.hero.primary}</a>
        <a class="btn btn--ghost" href="#services">{t.hero.secondary}</a>
      </div>
    </div>

  </div>
</section>
<style>
  .hero { padding-block: var(--s6) var(--s8); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1fr); }
  .hero__text { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s5); align-content: center; padding-block: var(--s4); }
  .hero__body { font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.375rem); color: var(--ink); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--s3) var(--s4); margin-top: var(--s2); }

  /* Calm text-only hero; the old word-art block is gone (Wordmark.astro and its assets stay for recovery). The M3 mosaic lands here next. */
  @media (min-width: 64em) {
    .hero { padding-top: var(--s7); }
    .hero__text { max-width: 52rem; }
  }
</style>
