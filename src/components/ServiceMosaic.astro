---
import ConceptImage from './ConceptImage.astro';
import { services, serviceVisual } from '../content/services';
import { planById } from '../content/plans';
import { href, type Lang } from '../i18n';
import { tr } from '../i18n/ui';

/** joined: the homepage connects this board to the Work field below (no closing gap, square bottom corners). */
interface Props { lang: Lang; joined?: boolean }
const { lang, joined = false } = Astro.props;
const t = tr(lang);

/** Tile styling per position (A,B,C,D). Corner choices alternate the signature curve. */
const looks = [
  { tone: 'ink', corner: 'c-tl' },
  { tone: 'sand', corner: 'c-br' },
  { tone: 'coral', corner: 'c-tr' },
  { tone: 'slate', corner: 'c-bl' },
] as const;
const rows = [services.slice(0, 2), services.slice(2, 4)];
---
<section id="services" class:list={['svc', 'section', { 'svc--joined': joined }]} aria-labelledby="svc-h" data-detail-state="closed">
  <div class="wrap">
    <header class="svc__head">
      <p class="eyebrow">01 — {t.services.mosaicLabel}</p>
      <h2 id="svc-h" class="h-section">{t.services.h2.a} <em>{t.services.h2.em}</em></h2>
      <p class="lead svc__intro">{t.services.intro}</p>
    </header>

    <div class="mosaic" data-mosaic data-active="">
      {rows.map((row, ri) => (
        <div class:list={['row', ri === 0 ? 'row--top' : 'row--bot']}>
          {row.map((s, ci) => {
            const i = ri * 2 + ci;
            const look = looks[i]!;
            const v = serviceVisual(s);
            return (
              <article
                class:list={['tile', `tile--${look.tone}`, { 'on-dark': look.tone === 'ink' || look.tone === 'slate', 'on-coral': look.tone === 'coral' }]}
                data-tile data-service={s.id}
              >
                <figure class="tile__fig">
                  <div class="tile__img" data-fit={v.fit} style={`--pos:${v.position}; --pos-narrow:${v.positionNarrow}; --pos-tablet:${v.positionTablet}; --ar:${v.ratioMobile}; --zoom:${v.zoomNarrow}`}>
                    <ConceptImage image={v.image} lang={lang} sizes="(min-width: 64em) 58vw, (min-width: 48em) 52vw, 100vw" />
                  </div>
                  <figcaption class="tile__cap">
                    <span class="tile__num" aria-hidden="true">{s.number}</span>
                    <span class="tile__concept"><b>{v.badge[lang]}</b> · {v.label[lang]}</span>
                  </figcaption>
                </figure>
                <h3 class="h-tile tile__title">{s.name[lang]}</h3>
                <p class="tile__text">{s.outcome[lang]}</p>
                <div class="tile__actions">
                  <button type="button" class="tile__explore" aria-expanded="false" aria-controls="svc-detail" data-explore={s.id}>
                    <span class="tile__ico" aria-hidden="true"></span>{t.common.explore}<span class="sr-only">: {s.name[lang]}</span>
                  </button>
                  <a class="tile__link" href={href(lang, `services/${s.id}/`)} data-track="service_visit" data-service={s.id}>{t.common.fullService}<span class="sr-only">: {s.name[lang]}</span></a>
                </div>
              </article>
            );
          })}
        </div>
      ))}
    </div>

    <div class="detail-slot" data-detail-slot>
      <div class="detail" id="svc-detail" data-detail hidden role="region" aria-label={t.services.detailsLabel}>
        {services.map((s, i) => {
          const look = looks[i]!;
          const plan = planById(s.relatedPlan)!;
          return (
            <div class:list={['detail__panel', `detail__panel--${look.tone}`, { 'on-dark': look.tone === 'ink' || look.tone === 'slate', 'on-coral': look.tone === 'coral' }]} data-detail-for={s.id} hidden>
              <div class="detail__main">
                <p class="eyebrow">{s.number} — {t.common.services}</p>
                <h3 class="h-tile" tabindex="-1" id={`svc-detail-${s.id}`}>{s.name[lang]}</h3>
                <p class="detail__text">{s.detail[lang]}</p>
                <p class="detail__rel"><span>{t.common.relatedPlan}:</span> <a href={`${href(lang, 'plans/')}#plan-${plan.id}`}>{plan.name}</a></p>
                <a class="detail__full" href={href(lang, `services/${s.id}/`)}>{t.common.fullService}</a>
              </div>
              <div class="detail__list">
                <h4 class="detail__h">{t.common.deliverables}</h4>
                <ul>{s.deliverables[lang].map((d) => <li>{d}</li>)}</ul>
                <p class="detail__note">{t.services.exampleScope}</p>
              </div>
              <button type="button" class="detail__close" data-close aria-label={`${t.common.closeDetails}: ${s.name[lang]}`}>
                <span aria-hidden="true">×</span>
              </button>
            </div>
          );
        })}
        <p class="sr-only" role="status" aria-live="polite" data-detail-status></p>
      </div>
    </div>
  </div>
</section>

<style>
  .svc__head { display: grid; gap: var(--s4); margin-bottom: var(--s7); max-width: 62rem; }
  .svc__intro { color: var(--slate-text); }

  /* ---- Mosaic geometry: a fixed-height, two-row composition ---- */
  .mosaic {
    --ta: 7fr; --tb: 5fr; --ba: 5fr; --bb: 7fr;
    --rest-top: 0.5833; --rest-bot: 0.4167;
    --rt: 1fr; --rb: 1fr; /* row heights: they also trade space, so the active tile grows in both directions */
    --row-h: 26rem;
    display: grid; gap: 0; /* tiles share edges: there is no gutter to show background through */
    position: relative; isolation: isolate;
  }
  .mosaic[data-active='web']   { --ta: 8.5fr; --tb: 3.5fr; --rt: 1.16fr; --rb: 0.84fr; }
  .mosaic[data-active='local'] { --ta: 3.5fr; --tb: 8.5fr; --rt: 1.16fr; --rb: 0.84fr; }
  .mosaic[data-active='video'] { --ba: 8.5fr; --bb: 3.5fr; --rt: 0.84fr; --rb: 1.16fr; }
  .mosaic[data-active='ads']   { --ba: 3.5fr; --bb: 8.5fr; --rt: 0.84fr; --rb: 1.16fr; }
  .row { display: grid; gap: 0; grid-template-columns: 1fr; min-height: 0; }

  /* Only the outer silhouette is curved (large corner top left and bottom right, small ones elsewhere), carried by the tiles themselves:
     the joined mosaic looks exactly as before, and --in (inner corner radius) is 0 once assembled. */
  .tile {
    --in: 0px;
    position: relative; display: flex; flex-direction: column; gap: var(--s3);
    padding: var(--pad); min-width: 0; overflow: hidden;
    isolation: isolate;
    border-radius: var(--in);
  }
  .tile[data-service='web'] { border-top-left-radius: var(--r-big); }
  .tile[data-service='local'] { border-top-right-radius: var(--r-small); }
  .tile[data-service='video'] { border-bottom-left-radius: var(--r-small); }
  .tile[data-service='ads'] { border-bottom-right-radius: var(--r-big); }
  /* Picture + concept label on top, then title, text and actions: with subgrid (below) the rows line up across neighbouring tiles at rest. */
  .tile__fig { display: flex; flex-direction: column; gap: var(--s3); flex: 1 1 auto; min-height: 0; }
  .tile__img { position: relative; flex: 1 1 auto; min-height: 9rem; overflow: hidden; border-radius: var(--r-small); background: color-mix(in srgb, currentColor 12%, transparent); }
  .tile__img :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--pos, 50% 50%); }
  .tile__img[data-fit='contain'] :global(img) { object-fit: contain; }
  .tile__img :global(img) { transform-origin: var(--pos-narrow, 50% 50%); transition: transform 0.38s cubic-bezier(0.22, 0.8, 0.3, 1), object-position 0.38s cubic-bezier(0.22, 0.8, 0.3, 1); }
  /* the narrow neighbour of an active tile re-frames its picture in step with the edge (uniform scale, never a stretch) */
  .mosaic[data-active='local'] [data-service='web'] .tile__img :global(img),
  .mosaic[data-active='web'] [data-service='local'] .tile__img :global(img),
  .mosaic[data-active='ads'] [data-service='video'] .tile__img :global(img),
  .mosaic[data-active='video'] [data-service='ads'] .tile__img :global(img) { object-position: var(--pos-narrow, 50% 50%); transform: scale(var(--zoom, 1)); }
  .tile--ink { background: var(--ink); color: var(--paper); }
  .tile--sand { background: var(--sand); color: var(--ink); }
  .tile--coral { background: var(--coral); color: var(--ink-deep); }
  .tile--slate { background: var(--slate); color: var(--paper); }

  .tile__cap { display: flex; align-items: baseline; gap: var(--s3); font-size: 0.875rem; line-height: 1.35; }
  .tile__num { font-weight: 800; font-size: 1.0625rem; letter-spacing: 0.08em; flex: none; }
  .tile--ink .tile__num { color: var(--coral-light); }
  .tile__concept { min-width: 0; overflow-wrap: anywhere; hyphens: auto; }
  .tile__concept b { font-weight: 700; }
  .tile__title { text-wrap: balance; }
  .tile__text { font-size: 1.0625rem; line-height: 1.5; max-width: 38ch; text-wrap: pretty; }
  .tile__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 4px var(--s4); margin-top: var(--s2); }

  .tile__explore {
    display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 8px 18px;
    border: 2px solid currentColor; border-radius: 999px; background: transparent; color: inherit;
    font: 600 1rem/1.2 var(--font-sans); cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .tile__ico { position: relative; width: 14px; height: 14px; flex: none; }
  .tile__ico::before, .tile__ico::after { content: ''; position: absolute; background: currentColor; border-radius: 1px; }
  .tile__ico::before { left: 0; right: 0; top: 6px; height: 2px; }
  .tile__ico::after { top: 0; bottom: 0; left: 6px; width: 2px; transition: transform 0.15s; }
  .tile__explore[aria-expanded='true'] .tile__ico::after { transform: scaleY(0); }
  .tile__explore:hover, .tile.is-active .tile__explore, .tile__explore[aria-expanded='true'] { background: var(--fill); color: var(--on-fill); }
  .tile--ink { --fill: var(--paper); --on-fill: var(--ink); }
  .tile--sand { --fill: var(--ink); --on-fill: var(--paper); }
  .tile--coral { --fill: var(--ink-deep); --on-fill: var(--coral); }
  .tile--slate { --fill: var(--paper); --on-fill: var(--ink); }
  .tile__link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; text-underline-offset: 5px; text-decoration-thickness: 2px; }
  .tile__link:hover { text-decoration-color: var(--coral); }
  .tile--coral .tile__link:hover { text-decoration-color: var(--ink-deep); }
  .tile[data-selected='true']::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 8px; background: currentColor; opacity: 0.85; }
  :global(.no-js) .tile__explore { display: none; }

  /* ---- Desktop: moving shared edges, fixed total height ---- */
  @media (min-width: 64em) and (max-width: 79.99em) {
    .mosaic { --row-h: 36rem; }
    .tile { --pad: 26px; }
  }
  @media (min-width: 80em) { .mosaic { --row-h: 34rem; } }
  @media (min-width: 64em) {
    .mosaic { height: calc(var(--row-h) * 2); grid-template-rows: minmax(0, var(--rt)) minmax(0, var(--rb)); transition: grid-template-rows 0.38s cubic-bezier(0.22, 0.8, 0.3, 1); }
    .row--top { grid-template-columns: minmax(0, var(--ta)) minmax(0, var(--tb)); }
    .row--bot { grid-template-columns: minmax(0, var(--ba)) minmax(0, var(--bb)); }
    .row { transition: grid-template-columns 0.38s cubic-bezier(0.22, 0.8, 0.3, 1); }
    /* text keeps a minimum measure so it does not reflow while edges travel */
    .tile > * { min-width: 0; }
    .tile__fig, .tile__title, .tile__text, .tile__actions { min-width: 12.5rem; }
  }
  /* ---- Tablet: two columns, calmer movement ---- */
  @media (min-width: 48em) and (max-width: 63.99em) {
    .tile__img :global(img) { object-position: var(--pos-tablet, var(--pos, 50% 50%)); }
    .mosaic { --ta: 6.5fr; --tb: 5.5fr; --ba: 5.5fr; --bb: 6.5fr; --rest-top: 0.5417; --rest-bot: 0.4583; --row-h: 36rem; }
    .mosaic[data-active='web']   { --ta: 8fr; --tb: 4fr; }
    .mosaic[data-active='local'] { --ta: 4fr; --tb: 8fr; }
    .mosaic[data-active='video'] { --ba: 8fr; --bb: 4fr; }
    .mosaic[data-active='ads']   { --ba: 4fr; --bb: 8fr; }
    .mosaic { height: calc(var(--row-h) * 2); grid-template-rows: minmax(0, var(--rt)) minmax(0, var(--rb)); transition: grid-template-rows 0.36s ease-out; }
    .row--top { grid-template-columns: minmax(0, var(--ta)) minmax(0, var(--tb)); }
    .row--bot { grid-template-columns: minmax(0, var(--ba)) minmax(0, var(--bb)); }
    .row { transition: grid-template-columns 0.36s ease-out; }
  }
  /* ---- Mobile: one column in reading order; details open inline below the tile ---- */
  @media (max-width: 47.99em) {
    .row { gap: 0; }
    .tile[data-service='web'] { border-top-right-radius: var(--r-small); }
    .tile[data-service='local'] { border-top-right-radius: var(--in); }
    .tile[data-service='video'] { border-bottom-left-radius: var(--in); }
    .tile[data-service='ads'] { border-bottom-left-radius: var(--r-small); }
    .tile__fig { flex: none; }
    .tile__img { flex: none; aspect-ratio: var(--ar, 16 / 10); min-height: 0; }
    .tile__title { margin-top: var(--s3); }
  }
  /* From the tablet layout up: every tile spans the row's tracks (picture, caption, title, text, actions) as a subgrid,
     so titles, descriptions and action groups sit on the same lines in neighbouring tiles; the picture row absorbs the height. */
  @supports (grid-template-rows: subgrid) {
    @media (min-width: 48em) {
      .row { grid-template-rows: minmax(0, 1fr) auto auto auto auto; }
      .tile { display: grid; grid-row: 1 / -1; grid-template-rows: subgrid; grid-template-columns: minmax(0, 1fr); row-gap: var(--s3); }
      .tile__fig { display: grid; grid-row: 1 / span 2; grid-template-rows: subgrid; grid-template-columns: minmax(0, 1fr); row-gap: var(--s3); }
      .tile__img { min-height: 0; }
      .tile__actions { margin-top: 0; align-self: start; }
    }
  }

  /* registered without inheritance: updating them every frame while a piece travels does not restyle the tile's whole subtree */
  @property --sh { syntax: '<number>'; inherits: false; initial-value: 0; }
  @property --in { syntax: '<length>'; inherits: false; initial-value: 0px; }

  /* ---- Assembly: the pieces join as they scroll into view (decorative travel; the tiles themselves are the content) ---- */
  .svc { overflow-x: clip; } /* travelling pieces may pass the page margin; they never add scroll width */
  .mosaic.is-assembling .tile { will-change: transform; box-shadow: 0 22px 40px -16px rgb(19 35 56 / calc(var(--sh, 0) * 0.45)); }
  .mosaic.is-assembling .tile__img { will-change: transform; box-shadow: 0 14px 26px -10px rgb(19 35 56 / calc(var(--sh, 0) * 0.5)); }
  .mosaic.is-settling .tile, .mosaic.is-settling .tile__img { transition: transform 0.26s cubic-bezier(0.22, 0.8, 0.3, 1), box-shadow 0.26s, border-radius 0.26s; }
  .mosaic :global(.seam) { position: absolute; z-index: 4; background: var(--paper); box-shadow: 0 0 0 1px rgb(19 35 56 / 0.28), 0 0 12px 2px rgb(255 255 255 / 0.65); opacity: 0; pointer-events: none; }

  /* ---- Shared detail region ---- */
  .detail-slot { margin-top: var(--gutter); }
  /* joined (homepage): the board meets the Work field directly; an open detail is the in-flow bridge between them */
  .svc--joined { padding-bottom: 0; }
  .svc--joined .detail-slot:has(.detail[hidden]) { margin-top: 0; }
  .svc--joined[data-detail-state='open'] .detail-slot { margin-bottom: var(--gutter); }
  .svc--joined .tile[data-service='ads'] { border-bottom-right-radius: var(--r-small); }
  .detail[hidden], .detail__panel[hidden] { display: none; }
  .detail__panel {
    position: relative; display: grid; gap: var(--s6) var(--s7); padding: var(--pad); padding-right: calc(var(--pad) + 40px);
    border-radius: var(--r-small); animation: det-in 0.22s ease-out;
  }
  .detail__panel--ink { background: var(--ink); color: var(--paper); border-top-left-radius: var(--r-big); }
  .detail__panel--sand { background: var(--sand); color: var(--ink); border-bottom-right-radius: var(--r-big); }
  .detail__panel--coral { background: var(--coral); color: var(--ink-deep); border-top-right-radius: var(--r-big); }
  .detail__panel--slate { background: var(--slate); color: var(--paper); border-bottom-left-radius: var(--r-big); }
  @media (min-width: 48em) { .detail__panel { grid-template-columns: 1.2fr 1fr; padding-block: var(--s7); } }
  .detail__main { display: grid; gap: var(--s3); align-content: start; }
  .detail__panel--ink .eyebrow, .detail__panel--slate .eyebrow { color: var(--coral-light); }
  .detail__panel--coral .eyebrow { color: var(--ink-deep); }
  .detail__panel--slate .eyebrow { color: var(--sand); }
  .detail__text { max-width: 52ch; }
  .detail__rel { font-weight: 500; }
  .detail__rel a, .detail__full { font-weight: 700; }
  .detail__full { display: inline-flex; align-items: center; min-height: 44px; width: fit-content; }
  .detail__h { font-size: 0.8125rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; margin-bottom: var(--s3); }
  .detail__list ul { display: grid; gap: var(--s3); }
  .detail__note { margin-top: var(--s4); font-size: 0.9375rem; max-width: 40ch; }
  .detail__list li { position: relative; padding-left: 28px; line-height: 1.45; }
  .detail__list li::before { content: ''; position: absolute; left: 0; top: 0.42em; width: 12px; height: 12px; background: currentColor; border-radius: 0 6px 0 6px; }
  .detail__close {
    position: absolute; top: 12px; right: 12px; width: 44px; height: 44px; border-radius: 999px;
    border: 2px solid currentColor; background: transparent; color: inherit; font: 400 1.75rem/1 var(--font-sans); cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .detail__panel--coral .detail__close { top: 20px; right: calc(var(--r-big) * 0.32); }
  .detail__close:hover { background: var(--fill, currentColor); }
  .detail__panel--ink .detail__close:hover, .detail__panel--slate .detail__close:hover { background: var(--paper); color: var(--ink); }
  .detail__panel--sand .detail__close:hover { background: var(--ink); color: var(--paper); }
  .detail__panel--coral .detail__close:hover { background: var(--ink-deep); color: var(--coral); }
  @keyframes det-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-mosaic]');
  const detail = document.querySelector<HTMLElement>('[data-detail]');
  const slot = document.querySelector<HTMLElement>('[data-detail-slot]');
  if (root && detail && slot) init(root, detail, slot);

  function init(root: HTMLElement, detail: HTMLElement, slot: HTMLElement) {
    const section = root.closest<HTMLElement>('section')!; // explicit state boundary for neighbours: data-detail-state = open | closed
    const tiles = [...root.querySelectorAll<HTMLElement>('[data-tile]')];
    const panels = [...detail.querySelectorAll<HTMLElement>('[data-detail-for]')];
    const status = detail.querySelector<HTMLElement>('[data-detail-status]')!;
    const ids = tiles.map((t) => t.dataset.service!);
    const INTENT_MS = 120; // deliberate hover before the edge moves
    const RESET_MS = 180;  // delayed reset so a brief exit does not snap back
    const TOLERANCE = 28;  // px around the resting edge where the current tile is kept (anti-flicker)

    let active = '';
    let hoverTimer = 0;
    let resetTimer = 0;
    let pending = '';
    let selected = '';
    const desktopLike = () => matchMedia('(min-width: 48em)').matches;

    function setActive(id: string) {
      active = id;
      root.dataset.active = id;
      tiles.forEach((t) => t.classList.toggle('is-active', t.dataset.service === id));
    }
    const focusedId = () => tiles.find((t) => t.contains(document.activeElement) && document.activeElement?.matches(':focus-visible, button, a'))?.dataset.service ?? '';

    /** Resolve the tile under the pointer from the RESTING geometry, never the moving edges. */
    function candidate(e: PointerEvent): string {
      const r = root.getBoundingClientRect();
      const cs = getComputedStyle(root);
      const x = e.clientX - r.left;
      const y = e.clientY - r.top;
      const current = ids.indexOf(active);
      // Row: the resting midline, with the current row kept while the pointer is near it (the real edge moves).
      let isBottom = y > r.height / 2;
      if (current >= 0 && Math.abs(y - r.height / 2) < TOLERANCE) isBottom = current >= 2;
      const split = parseFloat(cs.getPropertyValue(isBottom ? '--rest-bot' : '--rest-top')) * r.width;
      const base = isBottom ? 2 : 0;
      if (current >= base && current < base + 2 && Math.abs(x - split) < TOLERANCE) return ids[current]!;
      return ids[base + (x < split ? 0 : 1)]!;
    }

    root.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || !desktopLike()) return;
      clearTimeout(resetTimer);
      const next = candidate(e);
      if (!isAssembled(next)) return; // a tile that is still travelling does not take part in the shared-edge interaction yet
      if (next === active) { clearTimeout(hoverTimer); pending = ''; return; }
      if (next === pending) return;
      pending = next;
      clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => { setActive(next); pending = ''; }, INTENT_MS);
    });
    root.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      clearTimeout(hoverTimer); pending = '';
      resetTimer = window.setTimeout(() => setActive(focusedId() || selected), RESET_MS);
    });
    root.addEventListener('focusin', (e) => {
      const tile = (e.target as Element).closest<HTMLElement>('[data-tile]');
      if (tile) { settleAll(); clearTimeout(resetTimer); setActive(tile.dataset.service!); }
    });
    root.addEventListener('focusout', (e) => {
      const to = e.relatedTarget as Node | null;
      if (!to || !root.contains(to)) resetTimer = window.setTimeout(() => { if (!root.matches(':hover')) setActive(selected); }, RESET_MS);
    });

    /* ---- Exploration: one shared region, explicit buttons only ---- */
    function place() {
      // Mobile: open inline right after the selected tile so reading order is kept.
      const tile = tiles.find((t) => t.dataset.service === selected);
      if (selected && !desktopLike() && tile) tile.after(detail);
      else slot.append(detail);
    }
    function open(id: string, trigger: HTMLElement) {
      selected = id;
      tiles.forEach((t) => {
        const on = t.dataset.service === id;
        t.dataset.selected = String(on);
        t.querySelector('[data-explore]')!.setAttribute('aria-expanded', String(on));
      });
      panels.forEach((p) => (p.hidden = p.dataset.detailFor !== id));
      detail.hidden = false;
      section.dataset.detailState = 'open';
      place();
      if (desktopLike()) setActive(id); // explicit selection keeps the tile expanded (touch has no hover)
      status.textContent = trigger.textContent?.split(':')[0] + ' — ' + (panels.find((p) => p.dataset.detailFor === id)?.querySelector('h3')?.textContent ?? '');
    }
    function close(returnFocus = true) {
      const id = selected;
      selected = '';
      detail.hidden = true;
      section.dataset.detailState = 'closed';
      panels.forEach((p) => (p.hidden = true));
      slot.append(detail);
      setActive('');
      tiles.forEach((t) => { delete t.dataset.selected; t.querySelector('[data-explore]')!.setAttribute('aria-expanded', 'false'); });
      status.textContent = '';
      if (returnFocus && id) tiles.find((t) => t.dataset.service === id)?.querySelector<HTMLElement>('[data-explore]')?.focus();
    }

    root.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest<HTMLElement>('[data-explore]');
      if (!btn) return;
      const id = btn.dataset.explore!;
      settleAll(); // the action never waits for, or fights, the travel
      if (selected === id) close(false); else open(id, btn);
    });
    detail.addEventListener('click', (e) => { if ((e.target as Element).closest('[data-close]')) close(); });
    detail.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.stopPropagation(); close(); } });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && selected && root.contains(document.activeElement)) close(); });
    matchMedia('(min-width: 48em)').addEventListener('change', place);

    /* ================= Assembly =================
     * Each tile is its own piece. While the section scrolls into view, a tile that is still below the fold travels to its place
     * (translate, a few degrees of rotation, a little scale, soft shadow, rounded inner corners that square off as it docks), then its
     * picture settles in. Every frame is a pure function of the scroll position, so scrolling back and resizing are exact. Nothing is
     * faded or hidden: names, outcomes, concept labels, Explore buttons and links are on screen and usable from first render.
     * A tile that has docked stays docked. Focus, Explore, a link to the section, reduced motion or leaving the viewport range settle
     * every tile immediately (a short eased move, no jump) and from then on the shared-edge interaction is the only thing that moves. */
    const reducedMq = matchMedia('(prefers-reduced-motion: reduce)');
    const heightMq = matchMedia('(min-height: 480px)');
    const pics = new Map(tiles.map((t) => [t, t.querySelector<HTMLElement>('.tile__img')!]));
    const done = new Set<HTMLElement>();
    let assembling = false;
    let rafId = 0;
    let geo = { x: 0, y: 0, single: false, w: 0 };
    const seams: { el: HTMLElement; tile: HTMLElement; edge: 'left' | 'top' }[] = [];
    const clamp = (v: number, a = 0, b = 1) => (v < a ? a : v > b ? b : v);
    const smooth = (t: number) => { t = clamp(t); return t * t * (3 - 2 * t); };
    const easeIO = (t: number) => { t = clamp(t); return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; };
    const easeOut = (t: number) => 1 - Math.pow(1 - clamp(t), 3);
    // where each piece comes from: outward from the middle of the mosaic (two columns) or alternately from the sides (one column)
    const SPEC: Record<string, { dir: [number, number]; rot: number; lag: number; pdir: number; prot: number }> = {
      web: { dir: [-1, -1], rot: -2.2, lag: 0, pdir: 1, prot: 1.4 },
      local: { dir: [1, -1], rot: 1.8, lag: 0.12, pdir: -1, prot: -1.2 },
      video: { dir: [-1, 1], rot: 1.8, lag: 0, pdir: 1, prot: -1.2 },
      ads: { dir: [1, 1], rot: -2.2, lag: 0.12, pdir: -1, prot: 1.4 },
    };
    const isAssembled = (id: string) => !assembling || done.has(tiles.find((t) => t.dataset.service === id)!);

    function measure() {
      const w = root.offsetWidth;
      const single = !desktopLike();
      // offsets stay inside the page margin (travelling pieces never leave the viewport); the vertical travel carries most of the separation
      geo = { single, w, x: single ? Math.min(12, w * 0.03) : clamp(w * 0.016, 8, 24), y: single ? 20 : clamp(w * 0.02, 12, 28) };
      seams.forEach(({ el, tile, edge }) => {
        el.style.left = tile.offsetLeft + 'px'; el.style.top = tile.offsetTop + 'px';
        if (edge === 'left') { el.style.width = '4px'; el.style.height = tile.offsetHeight + 'px'; el.style.marginLeft = '-2px'; el.style.marginTop = ''; }
        else { el.style.height = '4px'; el.style.width = tile.offsetWidth + 'px'; el.style.marginTop = '-2px'; el.style.marginLeft = ''; }
      });
    }
    function makeSeams() {
      // sparks on the shared edges a piece closes when it docks: its left edge and/or top edge (decorative, not focusable, no content)
      const add = (tile: HTMLElement, edge: 'left' | 'top') => {
        const el = document.createElement('i'); el.className = 'seam'; el.setAttribute('aria-hidden', 'true'); root.append(el); seams.push({ el, tile, edge });
      };
      tiles.forEach((tile, i) => {
        const id = tile.dataset.service!;
        if (desktopLike()) { if (id === 'local' || id === 'ads') add(tile, 'left'); if (id === 'video' || id === 'ads') add(tile, 'top'); }
        else if (i > 0) add(tile, 'top');
      });
    }
    const viewH = () => innerHeight;
    const progressOf = (tile: HTMLElement, rootTop: number, vh: number) => {
      const top = rootTop + tile.offsetTop; // layout position: unaffected by the tile's own transform
      const raw = clamp((vh * 0.94 - top) / (vh * (geo.single ? 0.42 : 0.5)));
      const lag = geo.single ? 0 : SPEC[tile.dataset.service!]!.lag;
      return clamp((raw - lag) / (1 - lag));
    };
    function dock(tile: HTMLElement) {
      done.add(tile);
      tile.style.removeProperty('transform'); tile.style.removeProperty('--sh'); tile.style.removeProperty('--in'); tile.style.removeProperty('z-index');
      const pic = pics.get(tile)!;
      pic.style.removeProperty('transform'); pic.style.removeProperty('--sh');
    }
    function render() {
      rafId = 0;
      if (!assembling) return;
      const vh = viewH(), rootTop = root.getBoundingClientRect().top;
      let moving = false;
      tiles.forEach((tile) => {
        if (done.has(tile)) return;
        const p = progressOf(tile, rootTop, vh);
        if (p >= 1) { dock(tile); return; }
        if (p > 0) moving = true;
        const sp = SPEC[tile.dataset.service!]!;
        const f = easeIO(p), g = easeOut((p - 0.3) / 0.7);
        const dx = geo.single ? sp.dir[0] * geo.x : sp.dir[0] * geo.x, dy = geo.single ? geo.y : sp.dir[1] * geo.y;
        tile.style.transform = `translate3d(${(dx * (1 - f)).toFixed(1)}px,${(dy * (1 - f)).toFixed(1)}px,0) rotate(${(sp.rot * (geo.single ? 0.65 : 1) * (1 - f)).toFixed(2)}deg) scale(${(1 - 0.035 * (1 - f)).toFixed(4)})`;
        tile.style.setProperty('--sh', (1 - smooth((f - 0.7) / 0.3)).toFixed(3));
        tile.style.setProperty('--in', (28 * (1 - smooth((f - 0.82) / 0.18))).toFixed(1) + 'px');
        tile.style.zIndex = p > 0 && p < 1 ? '2' : '';
        const pic = pics.get(tile)!;
        pic.style.transform = `translate3d(${(sp.pdir * 14 * (1 - g)).toFixed(1)}px,${(-10 * (1 - g)).toFixed(1)}px,0) rotate(${(sp.prot * (1 - g)).toFixed(2)}deg)`;
        pic.style.setProperty('--sh', (1 - smooth((g - 0.6) / 0.4)).toFixed(3));
      });
      seams.forEach(({ el, tile }) => {
        const p = done.has(tile) ? 1 : progressOf(tile, rootTop, vh);
        const u = clamp((p - 0.8) / 0.2);
        el.style.opacity = u > 0 && u < 1 ? Math.pow(Math.sin(Math.PI * u), 1.5).toFixed(3) : '0';
      });
      coordinateHero(moving);
      if (done.size === tiles.length) finish();
    }
    const schedule = () => { if (assembling && !rafId) rafId = requestAnimationFrame(render); };
    function finish() {
      assembling = false;
      seams.forEach(({ el }) => el.remove()); seams.length = 0;
      root.classList.remove('is-assembling');
      tiles.forEach((t) => { t.style.removeProperty('z-index'); });
      coordinateHero(false);
    }
    /** Put every piece in its place now: a short eased move (or none with `instant`), focus and any open panel untouched. */
    function settleAll(instant = false) {
      if (!assembling) return;
      assembling = false;
      if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
      if (!instant) root.classList.add('is-settling');
      tiles.forEach((tile) => dock(tile));
      seams.forEach(({ el }) => el.remove()); seams.length = 0;
      coordinateHero(false);
      window.setTimeout(() => { root.classList.remove('is-assembling', 'is-settling'); }, instant ? 0 : 320);
    }

    /* The hero animation and this one should not both be the focal motion: while a piece is travelling and the hero is on screen,
       ask the hero to hold (event `odalo:hero-hold`, source 'services'); ask it to release when that stops being true. The hero owns
       playback: a visitor's own Pause or Play always wins, and repeating a request changes nothing. */
    const heroArt = document.querySelector<HTMLElement>('[data-hero-art]');
    let heroHold = false;
    const sendHold = (hold: boolean) => document.dispatchEvent(new CustomEvent('odalo:hero-hold', { detail: { source: 'services', hold } }));
    function coordinateHero(moving: boolean) {
      if (!heroArt) return;
      const r = heroArt.getBoundingClientRect();
      const want = moving && r.bottom > 0 && r.top < innerHeight * 0.9;
      if (want === heroHold) return;
      heroHold = want;
      sendHold(want);
    }
    // the hero announces itself once it exists: repeat a hold that was requested before it could listen
    document.addEventListener('odalo:hero-ready', () => { if (heroHold) sendHold(true); });

    function startAssembly() {
      if (reducedMq.matches || !heightMq.matches || assembling) return;
      measure();
      const vh = viewH(), rootTop = root.getBoundingClientRect().top;
      // arriving on or past the section (link, restored position, tall window): whatever is on screen is already in place
      tiles.forEach((tile) => { if (progressOf(tile, rootTop, vh) > 0 || rootTop + tile.offsetTop + tile.offsetHeight < 0) done.add(tile); });
      if (done.size === tiles.length) return;
      assembling = true;
      root.classList.add('is-assembling');
      makeSeams(); measure();
      render();
    }
    // Scroll restoration can land after this script ran: whatever is then already on screen when the page has finished loading is docked,
    // exactly as if the visitor had arrived there (it never starts mid-travel just because the position was restored).
    addEventListener('load', () => requestAnimationFrame(() => {
      if (!assembling || scrollY === 0) return;
      const vh = viewH(), rootTop = root.getBoundingClientRect().top;
      tiles.forEach((tile) => { if (!done.has(tile) && (progressOf(tile, rootTop, vh) > 0 || rootTop + tile.offsetTop + tile.offsetHeight < 0)) dock(tile); });
      if (done.size === tiles.length) finish(); else schedule();
    }), { once: true });
    const hashTargetsSection = () => !!location.hash && (location.hash === '#services' || !!document.getElementById(decodeURIComponent(location.hash.slice(1)))?.closest('#services'));
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', () => { if (!assembling) return; if (reducedMq.matches || !heightMq.matches) { settleAll(true); return; } measure(); schedule(); });
    if ('ResizeObserver' in window) new ResizeObserver(() => { if (assembling) { measure(); schedule(); } }).observe(root);
    reducedMq.addEventListener('change', () => { if (reducedMq.matches) settleAll(true); });
    addEventListener('hashchange', () => { if (hashTargetsSection()) settleAll(); });
    if (hashTargetsSection()) { /* an anchor link: show the finished composition */ } else startAssembly();
  }
</script>
