---
import { languages, languageNames, href, type Lang } from '../i18n';
import { tr } from '../i18n/ui';
interface Props { lang: Lang; rest: string; dark?: boolean }
const { lang, rest, dark = false } = Astro.props;
const t = tr(lang);
---
<nav class:list={['lang', { 'on-dark': dark }]} aria-label={t.a11y.language}>
  {languages.map((l, i) => (
    <>
      {i > 0 && <span class="lang__sep" aria-hidden="true">·</span>}
      {l === lang ? (
        <span class="lang__item is-current" aria-current="true" lang={l}><span aria-hidden="true">{l.toUpperCase()}</span><span class="sr-only">{languageNames[l].native}</span></span>
      ) : (
        <a class="lang__item" href={href(l, rest)} lang={l} hreflang={l} data-set-lang={l} aria-label={`${t.a11y.switchTo} ${languageNames[l].label[lang]}`}><span aria-hidden="true">{l.toUpperCase()}</span></a>
      )}
    </>
  ))}
</nav>
<style>
  .lang { display: inline-flex; align-items: center; gap: 2px; font-weight: 600; font-size: 0.9375rem; }
  .lang__sep { opacity: 0.5; }
  .lang__item { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; text-decoration: none; letter-spacing: 0.04em; border-radius: 8px; }
  a.lang__item { opacity: 0.72; }
  a.lang__item:hover { opacity: 1; text-decoration: underline; text-underline-offset: 6px; }
  .is-current { font-weight: 800; box-shadow: inset 0 -3px 0 var(--coral); }
</style>
