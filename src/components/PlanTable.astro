---
import { plans, features, planPriceText } from '../content/plans';
import type { Lang } from '../i18n';
import { tr } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = tr(lang);
---
{/* Two presentations of the same data (plans x features). CSS shows exactly one; display:none also removes the other from the keyboard and screen-reader trees. */}
<div class="cmp" role="region" aria-label={t.plans.comparisonCaption} tabindex="0">
  <table>
    <caption class="sr-only">{t.plans.comparisonCaption}. {t.common.examplePrices}.</caption>
    <thead>
      <tr>
        <th scope="col">{t.plans.feature}</th>
        {plans.map((p) => <th scope="col" class:list={{ 'is-feat': p.featured }}>{p.name}{p.featured && <span class="sr-only"> ({t.common.featured})</span>}</th>)}
      </tr>
    </thead>
    <tbody>
      {features.map((f) => (
        <tr>
          <th scope="row">{f.label[lang]}</th>
          {plans.map((p) => {
            const v = f.values[p.id];
            return (
              <td class:list={{ 'is-feat': p.featured }}>
                {v === true ? (<><span class="yes" aria-hidden="true"></span><span class="sr-only">{t.common.yes}</span></>)
                  : v === false ? (<><span class="no" aria-hidden="true"></span><span class="sr-only">{t.common.no}</span></>)
                  : <span class="val">{v[lang]}</span>}
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<div class="cmpd" data-plan-compare>
  {plans.map((p) => (
    <details class:list={['cmpd__item', { 'is-feat': p.featured }]} id={`compare-${p.id}`}>
      <summary>
        <span class="cmpd__name">{p.name}{p.featured && <span class="cmpd__badge">{t.common.featured}</span>}</span>
        <span class="cmpd__price">{p.monthly === null ? <span class="cmpd__amt">{planPriceText(p, lang, '')}</span> : <><span class="cmpd__amt">{planPriceText(p, lang, '')}</span><span class="cmpd__per">{t.common.perMonth}</span></>}</span>
      </summary>
      <dl class="cmpd__list">
        {features.map((f) => {
          const v = f.values[p.id];
          return (
            <div class="cmpd__row">
              <dt>{f.label[lang]}</dt>
              <dd>
                {v === true ? (<><span class="yes" aria-hidden="true"></span>{t.common.yes}</>)
                  : v === false ? (<><span class="no" aria-hidden="true"></span>{t.common.no}</>)
                  : <span class="val">{v[lang]}</span>}
              </dd>
            </div>
          );
        })}
      </dl>
    </details>
  ))}
</div>
<style>
  .cmp { position: relative; overflow-x: auto; background: var(--paper); border-radius: var(--radius-panel); box-shadow: var(--shadow-soft); }
  table { width: 100%; border-collapse: collapse; font-size: 1rem; }
  th, td { padding: 14px 16px; text-align: center; border-bottom: 1px solid var(--line); line-height: 1.35; }
  thead th { font-weight: 800; font-size: 1.125rem; background: var(--paper); position: sticky; top: 0; border-bottom: 2px solid var(--ink); }
  tbody th { text-align: left; font-weight: 500; min-width: 12rem; }
  .is-feat { background: rgb(32 59 87 / 0.07); }
  thead th.is-feat { background: var(--ink); color: var(--paper); }
  .yes { display: inline-block; width: 14px; height: 14px; background: var(--coral); border-radius: 0 7px 0 7px; }
  .no { display: inline-block; width: 14px; height: 2px; background: var(--slate); vertical-align: middle; }
  .val { font-weight: 600; }
  .cmp:focus-visible { outline-offset: 2px; }
  .no { vertical-align: middle; }

  /* Wide: the table. Narrow: one native disclosure per plan (no horizontal scrolling). */
  .cmpd { display: none; }
  @media (max-width: 47.99em) {
    .cmp { display: none; }
    .cmpd { display: block; border-radius: var(--radius-panel); overflow: hidden; background: var(--paper); box-shadow: var(--shadow-soft); }
  }
  .cmpd__item { border-bottom: 1px solid var(--line); }
  .cmpd__item:last-child { border-bottom: 0; }
  .cmpd__item.is-feat { background: rgb(32 59 87 / 0.07); }
  .cmpd summary { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px var(--s4); min-height: 64px; padding: 12px var(--s5); cursor: pointer; list-style: none; font-weight: 800; font-size: 1.25rem; }
  .cmpd summary::-webkit-details-marker { display: none; }
  .cmpd summary::after { content: ''; flex: none; order: 3; margin-left: auto; width: 12px; height: 12px; border-right: 3px solid var(--ink); border-bottom: 3px solid var(--ink); transform: rotate(45deg) translate(-2px, -2px); }
  .cmpd details[open] > summary::after, .cmpd__item[open] > summary::after { transform: rotate(-135deg) translate(-2px, -2px); }
  .cmpd summary:focus-visible { outline: 3px solid var(--focus); outline-offset: -3px; }
  .cmpd__name { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; min-width: 0; flex: 1 1 8rem; order: 1; }
  .cmpd__badge { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.02em; padding: 2px 10px; border-radius: 999px; background: var(--ink); color: var(--paper); }
  .cmpd__price { font-size: 1.25rem; order: 2; min-width: 0; max-width: 100%; }
  .cmpd__amt { white-space: nowrap; }
  .cmpd__per { font-size: 0.9375rem; font-weight: 500; color: var(--slate-text); margin-left: 4px; }
  .cmpd__list { margin: 0; padding: 0 var(--s5) var(--s4); }
  .cmpd__row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 2px var(--s4); padding: 12px 0; border-top: 1px solid var(--line); }
  .cmpd__row dt { font-weight: 500; min-width: 0; flex: 1 1 9rem; hyphens: auto; overflow-wrap: break-word; }
  .cmpd__row dd { margin: 0; text-align: left; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; flex: 0 1 auto; max-width: 100%; }
</style>
