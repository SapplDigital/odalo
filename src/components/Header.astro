---
// Ale's glass-pill navigation (odalo-web Navbar + PildoraMovil), with OUR routes and i18n.
// Desktop: floating glass pill (logo, nav, language, CTA). Mobile: top pill (logo + language) and a fixed bottom pill (Menu, Plans, CTA).
import LangSwitch from './LangSwitch.astro';
import { href, type Lang } from '../i18n';
import { tr } from '../i18n/ui';
interface Props { lang: Lang; home: boolean; rest: string }
const { lang, home, rest } = Astro.props;
const t = tr(lang);
const homeHref = href(lang);
const links = [
  { id: 'services', label: t.nav.services, to: home ? '#services' : `${homeHref}#services` },
  { id: 'plans', label: t.nav.plans, to: href(lang, 'plans/') },
  { id: 'process', label: t.nav.process, to: home ? '#process' : `${homeHref}#process` },
  { id: 'about', label: t.nav.about, to: href(lang, 'about/') },
];
const plans = links[1];
const current = rest.split('/')[0];
const isCurrent = (id: string) => !home && current === id;
const auditHref = href(lang, 'audit/');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="hdr" data-header>
  <div class="hdr__pill glass-nav">
    <a class="hdr__logo" href={homeHref} aria-label={t.a11y.home}><img class="hdr__img" src={`${base}/brand/odalo-owner-logo.png`} alt="" width="273" height="123" /></a>
    <nav aria-label={t.a11y.mainNav} class="hdr__nav">
      <ul class="hdr__links">
        {links.map((l) => (
          <li><a href={l.to} aria-current={isCurrent(l.id) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="hdr__tools">
      <span class="hdr__lang"><LangSwitch lang={lang} rest={rest} /></span>
      <a class="btn btn--coral hdr__cta" href={auditHref} data-track="audit_cta" data-location="header">{t.nav.audit}</a>
    </div>
  </div>
</header>
<nav class="dock" aria-label={t.a11y.mobileNav} data-dock>
  <div class="hdr__panel dock__sheet" id="site-nav" hidden>
    <ul>
      {links.map((l) => (
        <li><a href={l.to} aria-current={isCurrent(l.id) ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </div>
  <div class="dock__pill glass-nav">
    <button class="hdr__toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-open={t.a11y.openMenu} data-close={t.a11y.closeMenu} aria-label={t.a11y.openMenu}>
      <span class="hdr__bars" aria-hidden="true"></span>
      <span class="dock__label" aria-hidden="true">{t.a11y.openMenu.split(' ').pop()}</span>
    </button>
    <a class="dock__plans" href={plans.to} aria-current={isCurrent('plans') ? 'page' : undefined}>{plans.label}</a>
    <a class="btn btn--coral dock__cta" href={auditHref} data-track="audit_cta" data-location="dock">{t.nav.audit}</a>
  </div>
</nav>
<style>
  :root { --pill-top: 16px; --pill-h: 56px; --dock-h: 0px; }
  /* Ale's glass-nav surface: white gradient, blur 28px saturate 1.6, line border, float shadow */
  .glass-nav {
    background: linear-gradient(180deg, rgb(255 255 255 / 0.92), rgb(255 255 255 / 0.84));
    backdrop-filter: blur(28px) saturate(1.6);
    -webkit-backdrop-filter: blur(28px) saturate(1.6);
    border: 1px solid var(--line);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 1), inset 0 0 0 1px rgb(255 255 255 / 0.4), var(--shadow-float);
  }
  /* content never hides under the fixed pills */
  :global(html) { scroll-padding-top: calc(var(--pill-top) + var(--pill-h) + 16px); }
  :global(body) { padding-top: calc(var(--pill-top) + var(--pill-h) + 12px); padding-bottom: var(--dock-h); }

  .hdr { position: fixed; inset: var(--pill-top) 0 auto 0; z-index: 50; padding-inline: 16px; font-family: var(--font-sans); pointer-events: none; }
  .hdr__pill { pointer-events: auto; display: flex; align-items: center; gap: 16px; height: var(--pill-h); max-width: 1100px; margin-inline: auto; border-radius: 999px; padding: 0 8px 0 20px; }
  .hdr__logo { display: inline-flex; align-items: center; flex: none; min-height: 44px; text-decoration: none; }
  .hdr__img { display: block; height: 40px; width: auto; }
  .hdr__nav { display: none; margin-inline: auto; }
  .hdr__links { display: flex; align-items: center; gap: 4px; margin: 0; padding: 0; list-style: none; }
  .hdr__links a, .dock__plans { position: relative; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 14px; border-radius: 999px; font-size: 0.875rem; font-weight: 500; text-decoration: none; color: var(--ink-600); transition: background-color 0.2s var(--ease-glass), color 0.2s var(--ease-glass); }
  .hdr__links a:hover, .dock__plans:hover { background: color-mix(in srgb, var(--ink) 5%, transparent); color: var(--ink); }
  .hdr__links a[aria-current='page'], .dock__plans[aria-current='page'], .dock__sheet a[aria-current='page'] { color: var(--ink); }
  .dock__label { text-transform: capitalize; }
  .hdr__links a[aria-current='page']::before, .dock__plans[aria-current='page']::before, .dock__sheet a[aria-current='page']::before { content: ''; flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--coral); box-shadow: 0 0 0 1px var(--ink); }
  .hdr__tools { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  .hdr__lang { display: inline-flex; align-items: center; }
  .hdr__cta { display: none; min-height: 44px; padding-inline: 18px; white-space: nowrap; }

  /* mobile bottom pill */
  .dock { position: fixed; inset: auto 0 max(16px, env(safe-area-inset-bottom)) 0; z-index: 50; display: flex; flex-direction: column; align-items: center; gap: 8px; padding-inline: 12px; font-family: var(--font-sans); pointer-events: none; transition: transform 0.3s var(--ease-glass), opacity 0.3s var(--ease-glass); }
  .dock > * { pointer-events: auto; }
  .dock.is-typing { transform: translateY(150%); opacity: 0; pointer-events: none; }
  .dock.is-typing > * { pointer-events: none; }
  .dock__pill { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 4px; max-width: 100%; padding: 6px; border-radius: 999px; }
  .hdr__toggle { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px; border: 0; border-radius: 999px; background: transparent; color: var(--ink); font: inherit; font-size: 0.875rem; cursor: pointer; }
  .hdr__toggle:hover { background: color-mix(in srgb, var(--ink) 5%, transparent); }
  .hdr__bars { position: relative; display: block; width: 14px; height: 10px; }
  .hdr__bars::before, .hdr__bars::after { content: ''; position: absolute; left: 0; width: 100%; height: 1px; background: currentColor; transition: transform 0.3s; }
  .hdr__bars::before { top: 0; } .hdr__bars::after { bottom: 0; }
  .hdr__toggle[aria-expanded='true'] .hdr__bars::before { top: 50%; transform: rotate(45deg); }
  .hdr__toggle[aria-expanded='true'] .hdr__bars::after { bottom: 50%; transform: rotate(-45deg); }
  .dock__cta { min-height: 44px; padding-inline: 14px; margin-left: 2px; font-size: 0.875rem; }
  .dock__sheet { width: 100%; max-width: 24rem; padding: 8px; border: 1px solid var(--line); border-radius: var(--radius-card, 24px); background: var(--surface, #fff); box-shadow: var(--shadow-float); max-height: 60dvh; overflow-y: auto; }
  .dock__sheet[hidden] { display: none; }
  .dock__sheet ul { margin: 0; padding: 0; list-style: none; }
  .dock__sheet a { display: flex; align-items: center; gap: 12px; min-height: 48px; padding: 0 16px; border-radius: 16px; font-size: 1.125rem; font-weight: 500; letter-spacing: -0.02em; color: var(--ink); text-decoration: none; }
  .dock__sheet a:hover { background: color-mix(in srgb, var(--ink) 5%, transparent); }
  /* no JS: the sheet cannot be toggled, so the links stay open above the pill and the dead toggle is dropped */
  :global(.no-js) .dock__sheet[hidden] { display: block; }
  :global(.no-js) .hdr__toggle { display: none; }

  @media (max-width: 47.99em) {
    :root { --dock-h: 84px; }
    .hdr__pill { padding-right: 4px; }
  }
  @media (min-width: 48em) {
    :root { --dock-h: 0px; }
    .hdr__nav { display: block; }
    .hdr__cta { display: inline-flex; }
    .dock { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hdr__links a, .dock__plans, .dock, .hdr__bars::before, .hdr__bars::after { transition: none; }
  }
</style>
<script>
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  const btn = dock?.querySelector<HTMLButtonElement>('.hdr__toggle');
  const panel = dock?.querySelector<HTMLElement>('#site-nav');
  if (dock && btn && panel) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? btn.dataset.close! : btn.dataset.open!);
      panel.hidden = !open;
      if (open) panel.querySelector<HTMLElement>('a')?.focus();
    };
    set(false);
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { set(false); btn.focus(); }
    });
    panel.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) set(false); });
    document.addEventListener('pointerdown', (e) => {
      if (btn.getAttribute('aria-expanded') === 'true' && !dock.contains(e.target as Node)) set(false);
    });
    // hide the pill while a text field has focus (keyboard open) so it never covers the field or the submit button
    const isField = (el: EventTarget | null) => el instanceof HTMLElement && el.matches('input:not([type=checkbox]):not([type=radio]):not([type=hidden]), textarea, select');
    const typing = (v: boolean) => dock.classList.toggle('is-typing', v);
    document.addEventListener('focusin', (e) => { if (isField(e.target)) typing(true); });
    document.addEventListener('focusout', () => setTimeout(() => typing(isField(document.activeElement)), 50));
  }
</script>
